          </Properties>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--!strict
-- Sonidos (SFX.map del prototipo → Config.AssetIds.sounds). Si un id está vacío, no suena y ya.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local Audio = {}
local cache: { [string]: Sound } = {}
Audio.muted = false

local function get(name: string): Sound?
	local id = (Config.AssetIds.sounds :: any)[name]
	if not id or id == "" then
		return nil
	end
	local cached = cache[name]
	if cached then
		return cached
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = id
	s.Volume = 0.6
	s.Parent = SoundService
	cache[name] = s
	return s
end

function Audio.play(name: string, pitch: number?)
	if Audio.muted then
		return
	end
	local s = get(name)
	if s then
		s.PlaybackSpeed = pitch or 1
		SoundService:PlayLocalSound(s)
	end
end

--- Loop (p. ej. llenado). Devuelve el Sound para cambiarle volumen/tono en vivo.
function Audio.loop(name: string, on: boolean): Sound?
	local s = get(name)
	if not s then
		return nil
	end
	s.Looped = true
	if on and not Audio.muted then
		if not s.IsPlaying then
			s:Play()
		end
	else
		s:Stop()
	end
	return s
end

function Audio.init()
	Remotes.event("Notify").OnClientEvent:Connect(function(msg)
		if type(msg) == "table" and msg.t == "sound" then
			Audio.play(msg.name)
		end
	end)
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">AvatarHands</string>
              <string name="Source"><![CDATA[--!strict
-- Manos de Roblox: cuando apachurras un squishy, los brazos de TU avatar (R15) lo agarran con
-- IKControl. Las manos se pegan a los lados del squishy (vistos desde tu personaje) y se van
-- hundiendo con él. Reemplaza las manitos kawaii del prototipo (pedido de Yeison).
-- Si el squishy está lejos, el personaje camina hasta quedar a la distancia de los brazos.
-- Con avatar R6 (sin IK) se apachurra igual, solo que sin brazos.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local AvatarHands = {}

local REACH = 3.2 -- distancia a la que se para frente al squishy

type Rig = {
	left: IKControl,
	right: IKControl,
	tl: Attachment,
	tr: Attachment,
	holder: Part,
	weight: number,
}

local rig: Rig? = nil
local target: Model? = nil
local walking = false

local function character(): (Model?, Humanoid?, BasePart?)
	local char = Players.LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not hum or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return char, hum, root
end

local function build(char: Model, hum: Humanoid): Rig?
	if hum.RigType ~= Enum.HumanoidRigType.R15 then
		return nil
	end
	local function part(name: string): BasePart?
		local p = char:FindFirstChild(name)
		return if p and p:IsA("BasePart") then p else nil
	end
	local lu, lh, ru, rh = part("LeftUpperArm"), part("LeftHand"), part("RightUpperArm"), part("RightHand")
	if not (lu and lh and ru and rh) then
		return nil
	end
	local holder = Instance.new("Part")
	holder.Name = "SquishHandTargets"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.one * 0.2
	holder.Parent = Workspace
	local tl = Instance.new("Attachment")
	tl.Parent = holder
	local tr = Instance.new("Attachment")
	tr.Parent = holder
	local function ik(chainRoot: BasePart, hand: BasePart, t: Attachment): IKControl
		local c = Instance.new("IKControl")
		c.Type = Enum.IKControlType.Position
		c.ChainRoot = chainRoot
		c.EndEffector = hand
		c.Target = t
		c.Weight = 0
		c.SmoothTime = 0.08
		c.Parent = hum
		return c
	end
	return {
		left = ik(lu, lh, tl),
		right = ik(ru, rh, tr),
		tl = tl,
		tr = tr,
		holder = holder,
		weight = 0,
	}
end

local function destroyRig()
	local r = rig
	if r then
		r.left:Destroy()
		r.right:Destroy()
		r.holder:Destroy()
		rig = nil
	end
end

--- Empieza a agarrar `model`. Si está lejos, camina hasta él.
function AvatarHands.grab(model: Model)
	local char, hum, root = character()
	if not char or not hum or not root then
		return
	end
	target = model
	if not rig or not rig.left.Parent then
		destroyRig()
		rig = build(char, hum)
	end
	local pos = model:GetPivot().Position
	local flat = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
	if flat.Magnitude > REACH + 1.2 and not walking then
		walking = true
		hum:MoveTo(pos - flat.Unit * REACH)
		task.spawn(function()
			hum.MoveToFinished:Wait()
			walking = false
		end)
	end
end

function AvatarHands.release()
	target = nil
end

--- k = cuánto está hundido (0..~0.45). Se llama cada frame desde Squish.
function AvatarHands.update(dt: number, k: number)
	local char, hum, root = character()
	local r = rig
	if not r then
		return
	end
	if not char or not hum or not root then
		destroyRig()
		return
	end
	local m = target
	local want = 0
	if m and m.Parent then
		local cf, size = m:GetBoundingBox()
		local toSq = Vector3.new(cf.X - root.Position.X, 0, cf.Z - root.Position.Z)
		local dist = toSq.Magnitude
		if dist < REACH + 2.5 then
			want = 1
			-- mirar al squishy
			if dist > 0.3 and not walking then
				local look = root.Position + toSq.Unit
				root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, look), math.min(1, dt * 10))
			end
			-- lados del squishy vistos desde el personaje; se meten hacia adentro al apretar
			local fwd = if dist > 0.01 then toSq.Unit else root.CFrame.LookVector
			local side = fwd:Cross(Vector3.yAxis).Unit
			local half = math.max(size.X, size.Z) * 0.5 * (1 + k * 0.62)
			local squeeze = half * (0.95 - k * 0.5)
			local y = cf.Y + size.Y * (0.1 - k * 0.3)
			local center = Vector3.new(cf.X, y, cf.Z) - fwd * 0.15
			r.holder.CFrame = CFrame.new(center)
			r.tl.WorldPosition = center + side * squeeze
			r.tr.WorldPosition = center - side * squeeze
		end
	end
	r.weight += (want - r.weight) * math.min(1, dt * 8)
	r.left.Weight = r.weight
	r.right.Weight = r.weight
	if want == 0 and r.weight < 0.02 then
		destroyRig()
	end
end

return AvatarHands
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Companion</string>
              <string name="Source"><![CDATA[--!strict
-- Compañeros: el squishy equipado de CADA jugador y de cada NPC lo sigue con saltito y
-- respiración (squash idle). El servidor solo publica el atributo "Companion" (JSON); cada
-- cliente lo dibuja localmente (barato y suave, sin replicar CFrames).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Damp = require(ReplicatedStorage.Shared.Util.Damp)
local SquishyFactory = require(script.Parent.Parent.Engine.SquishyFactory)

local Companion = {}

type Entry = {
	owner: Instance, -- Player o Model (NPC)
	json: string,
	model: Model,
	pos: Vector3,
	yaw: number,
	t: number,
	height: number,
	lift: number, -- distancia del pivote a la base del modelo
	ownerName: string,
	npc: string?,
}

local entries: { [Instance]: Entry } = {}
local folder: Folder

local OFFSET = Config.Game.COMPANION.offset
local LERP = Config.Game.COMPANION.lerp

local function ownerRoot(owner: Instance): BasePart?
	local char: Instance? = if owner:IsA("Player") then owner.Character else owner
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local function build(owner: Instance, json: string)
	local old = entries[owner]
	if old then
		old.model:Destroy()
		entries[owner] = nil
	end
	if json == "" then
		return
	end
	local ok, d = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if not ok or type(d) ~= "table" then
		return
	end
	local model = SquishyFactory.build(d)
	model:SetAttribute("CompanionName", d.name)
	model:SetAttribute("OwnerName", if owner:IsA("Player") then owner.DisplayName else owner.Name)
	if not owner:IsA("Player") then
		model:SetAttribute("NpcOwner", owner.Name)
	end
	model.Parent = folder
	local root = ownerRoot(owner)
	local start = if root then root.Position else Vector3.zero
	entries[owner] = {
		owner = owner,
		json = json,
		model = model,
		pos = start,
		yaw = 0,
		t = math.random() * 10,
		height = SquishyFactory.height(model),
		lift = (function()
			local cf, size = model:GetBoundingBox()
			return model:GetPivot().Y - (cf.Y - size.Y / 2)
		end)(),
		ownerName = model:GetAttribute("OwnerName") :: string,
		npc = if owner:IsA("Player") then nil else owner.Name,
	}
end

local function watch(owner: Instance)
	local function refresh()
		local v = owner:GetAttribute("Companion")
		build(owner, if type(v) == "string" then v else "")
	end
	owner:GetAttributeChangedSignal("Companion"):Connect(refresh)
	refresh()
end

--- Squishy que alguien está apachurrando: se queda quieto (lo pone Squish.luau).
Companion.frozen = nil :: Model?

function Companion.all(): { [Instance]: Entry }
	return entries
end

function Companion.init()
	folder = Instance.new("Folder")
	folder.Name = "Companions"
	folder.Parent = Workspace

	for _, p in Players:GetPlayers() do
		watch(p)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(p)
		build(p, "")
	end)
	local npcs = Workspace:WaitForChild("NPCs", 30)
	if npcs then
		for _, m in npcs:GetChildren() do
			watch(m)
		end
		npcs.ChildAdded:Connect(watch)
		npcs.ChildRemoved:Connect(function(m)
			build(m, "")
		end)
	end

	RunService.RenderStepped:Connect(function(dt)
		for owner, e in entries do
			local root = ownerRoot(owner)
			if root and e.model.Parent then
				e.t += dt
				if Companion.frozen ~= e.model then
					local back = root.CFrame * CFrame.new(OFFSET * 0.55, 0, OFFSET)
					local target = Vector3.new(back.X, root.Position.Y - 3, back.Z)
					local moving = (target - e.pos).Magnitude > 0.4
					e.pos = Damp.vector(e.pos, target, LERP, dt)
					local _, ry, _ = root.CFrame:ToOrientation()
					-- girar por el camino corto (ToOrientation salta en ±π)
					local diff = (ry - e.yaw + math.pi) % (2 * math.pi) - math.pi
					e.yaw += diff * (1 - math.exp(-6 * dt))
					local hop = if moving then math.abs(math.sin(e.t * 9)) * 0.45 else 0
					local breathe = 1 + math.sin(e.t * 2.4) * 0.03
					e.model:PivotTo(
						CFrame.new(e.pos + Vector3.new(0, e.lift * breathe + hop, 0)) * CFrame.Angles(0, e.yaw, 0)
					)
				end
			end
		end
	end)
end

return Companion
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Dialog</string>
              <string name="Source"><![CDATA[--!strict
-- Confirmaciones (el confirm() del navegador en el prototipo).
local Kit = require(script.Parent.Parent.UI.Kit)
local Theme = require(script.Parent.Parent.UI.Theme)
local Router = require(script.Parent.Router)

local Dialog = {}

function Dialog.confirm(text: string, yes: () -> ())
	local shade: Frame = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		Size = UDim2.fromScale(1, 1),
		Active = true,
		ZIndex = 60,
		Parent = Kit.root(),
	})
	local box: Frame = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(420, 190),
		BackgroundColor3 = Theme.paper,
		Parent = shade,
	}, { Kit.corner(20), Kit.pad(18, 16), Kit.stroke(Theme.lav2, 3) })
	Kit.text(text, 16, { Size = UDim2.new(1, 0, 1, -56), TextYAlignment = Enum.TextYAlignment.Top, Parent = box })
	local ok = Kit.button(
		"Sí",
		Theme.mint,
		{ Position = UDim2.new(0, 0, 1, -44), Size = UDim2.new(0.5, -5, 0, 44), Parent = box }
	)
	local no = Kit.button(
		"Cancelar",
		Theme.white,
		{ Position = UDim2.new(0.5, 5, 1, -44), Size = UDim2.new(0.5, -5, 0, 44), Parent = box }
	)
	ok.Activated:Connect(function()
		shade:Destroy()
		yes()
	end)
	no.Activated:Connect(function()
		shade:Destroy()
	end)
end

function Dialog.init()
	Router.register("confirm", function(arg)
		Dialog.confirm(arg.text, arg.yes)
	end)
end

return Dialog
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- HUD: logo, monedas, nivel + barra de XP, menú lateral, tarjeta de misión, barra de ayuda,
-- temporizador de Poción de Suerte. Fiel a #hud de template.html.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Format = require(Shared.Util.Format)
local Quests = require(Shared.Logic.Quests)
local Squishy = require(Shared.Logic.Squishy)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Hud = {}

local function pill(parent: Instance, order: number, width: number): Frame
	return Kit.new("Frame", {
		BackgroundColor3 = Theme.paper,
		Size = UDim2.fromOffset(width, 40),
		LayoutOrder = order,
		Parent = parent,
	}, { Kit.corner(20), Kit.stroke(Theme.lav2, 2) })
end

function Hud.init()
	local root = Kit.root()
	local frame: Frame = Kit.new("Frame", {
		Name = "Hud",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = root,
	})
	Hud.frame = frame

	-- barra de arriba
	local top: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 12),
		Size = UDim2.new(1, -28, 0, 44),
		Parent = frame,
	}, { Kit.list(Enum.FillDirection.Horizontal, 10) })
	Kit.text("Squishy World", 30, {
		Font = Theme.display,
		TextColor3 = Theme.pinkD,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 40),
		LayoutOrder = 1,
		Parent = top,
	})
	local coinPill = pill(top, 2, 150)
	Kit.text("🪙", 22, { Position = UDim2.fromOffset(10, 6), Size = UDim2.fromOffset(28, 28), Parent = coinPill })
	local coins = Kit.text("0", 20, {
		Font = Theme.display,
		Position = UDim2.fromOffset(40, 6),
		Size = UDim2.new(1, -48, 0, 28),
		Parent = coinPill,
	})
	local lvlPill = pill(top, 3, 210)
	local lvl = Kit.text("Nv 1", 18, {
		Font = Theme.display,
		Position = UDim2.fromOffset(12, 3),
		Size = UDim2.fromOffset(60, 22),
		Parent = lvlPill,
	})
	local xpTxt = Kit.text("0/50 XP", 12, {
		Position = UDim2.fromOffset(76, 4),
		Size = UDim2.new(1, -86, 0, 18),
		TextColor3 = Theme.muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = lvlPill,
	})
	local xpBar: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.lav,
		Position = UDim2.fromOffset(12, 26),
		Size = UDim2.new(1, -24, 0, 8),
		Parent = lvlPill,
	}, { Kit.corner(4) })
	local xpFill: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.purple,
		Size = UDim2.fromScale(0, 1),
		Parent = xpBar,
	}, { Kit.corner(4) })
	local boostPill = pill(top, 4, 170)
	local boost = Kit.text("", 14, {
		Position = UDim2.fromOffset(10, 4),
		Size = UDim2.new(1, -20, 1, -8),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = boostPill,
	})
	boostPill.Visible = false
	local muteBtn = Kit.button("🔊", Theme.white, { Size = UDim2.fromOffset(40, 40), LayoutOrder = 5, Parent = top })
	muteBtn.Activated:Connect(function()
		Audio.muted = not Audio.muted
		muteBtn.Text = if Audio.muted then "🔇" else "🔊"
		Audio.loop("fillLoop", false)
	end)

	-- menú lateral (Inventario, Colección, Tienda, Cambios, Robux)
	local side: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(86, 440),
		Parent = frame,
	}, { Kit.list(Enum.FillDirection.Vertical, 10) })
	local menu: { { any } } = {
		{ "🎒", "Inventario", "inventory", Theme.pink, "I" },
		{ "📖", "Colección", "index", Theme.purple, "C" },
		{ "🛒", "Tienda", "shop", Theme.yellow, "T" },
		{ "🤝", "Cambios", "tradePlayers", Theme.blue, nil },
		{ "⭐", "Robux", "robux", Theme.robux, nil },
	}
	local sideButtons: { [string]: TextButton } = {}
	for i, m in menu do
		local b = Kit.button(m[1] .. "\n<font size='12'>" .. m[2] .. "</font>", m[4], {
			Size = UDim2.fromOffset(86, 70),
			TextSize = 26,
			LayoutOrder = i,
			Parent = side,
		})
		b.Activated:Connect(function()
			Audio.play("click")
			if Modal.current == m[3] then
				Modal.close()
			else
				Router.open(m[3])
			end
		end)
		sideButtons[m[3]] = b
	end
	Hud.sideButtons = sideButtons
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		for _, m in menu do
			if m[5] and input.KeyCode == (Enum.KeyCode :: any)[m[5]] then
				if Modal.current == m[3] then
					Modal.close()
				else
					Router.open(m[3])
				end
			end
		end
	end)

	-- tarjeta de misión (derecha)
	local quest: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.paper,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 70),
		Size = UDim2.fromOffset(260, 108),
		Parent = frame,
	}, { Kit.corner(18), Kit.stroke(Theme.lav2, 2), Kit.pad(14, 10) })
	Kit.text("📜 MISIÓN", 12, { TextColor3 = Theme.pinkD, Font = Theme.bodyBlack, Parent = quest })
	local qTitle = Kit.text("", 16, {
		Font = Theme.bodyBlack,
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 40),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = quest,
	})
	local qBar: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.lav,
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 0, 10),
		Parent = quest,
	}, { Kit.corner(5) })
	local qFill: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.mint,
		Size = UDim2.fromScale(0, 1),
		Parent = qBar,
	}, { Kit.corner(5) })
	local qMeta = Kit.text("", 12, {
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 0, 16),
		TextColor3 = Theme.muted,
		Parent = quest,
	})

	-- barra de ayuda (abajo)
	Kit.text(
		"<b>E</b> usar · <b>Mantén clic</b> sobre un squishy para apachurrarlo · <b>I</b> inventario · <b>T</b> tienda",
		13,
		{
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -10),
			Size = UDim2.fromOffset(640, 20),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = Theme.ink2,
			TextStrokeColor3 = Theme.white,
			TextStrokeTransparency = 0.3,
			Parent = frame,
		}
	)

	-- mientras hay una ventana abierta se esconde la misión (como el prototipo)
	Modal.onChange(function(key)
		quest.Visible = key == nil
	end)

	local lastCoins: number? = nil
	State.onChange(function(d)
		coins.Text = Format.int(d.coins)
		if lastCoins and d.coins ~= lastCoins then
			local sc = coinPill:FindFirstChildOfClass("UIScale") or Kit.new("UIScale", { Parent = coinPill })
			sc.Scale = 1.12
			Kit.tween(sc, 0.25, { Scale = 1 })
		end
		lastCoins = d.coins
		lvl.Text = "Nv " .. d.level
		local need = Squishy.xpNeed(d.level)
		xpTxt.Text = string.format("%d/%d XP", d.xp, need)
		xpFill.Size = UDim2.fromScale(math.clamp(d.xp / need, 0, 1), 1)
		local q = Quests.current(d.quest.i)
		local p = math.min(d.quest.p, q.goal)
		qTitle.Text = q.title
		qFill.Size = UDim2.fromScale(p / q.goal, 1)
		qMeta.Text = string.format("%d / %d · Premio: %s monedas", p, q.goal, Format.int(q.reward))
	end)

	-- temporizador de poción + moldes de oro
	task.spawn(function()
		while true do
			local d = State.data
			if d then
				local left = (d.luckLeft or 0) - (os.time() - (d.serverTime or os.time()))
				local parts = {}
				if left > 0 then
					table.insert(parts, string.format("🧪 %d:%02d", left // 60, left % 60))
				end
				if (d.legendFills or 0) > 0 then
					table.insert(parts, "🌟 x" .. d.legendFills)
				end
				if d.passes and d.passes.vip then
					table.insert(parts, "👑 VIP")
				end
				boostPill.Visible = #parts > 0
				boost.Text = table.concat(parts, "  ")
			end
			task.wait(1)
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Index</string>
              <string name="Source"><![CDATA[--!strict
-- Índice Squishy (renderIndex de game5.js): 413 entradas, siluetas "???" hasta descubrirlas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Config = require(Shared.Config)
local Profile = require(Shared.Logic.Profile)
local Squishy = require(Shared.Logic.Squishy)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Index = {}
local current = "cat"
local ui: { [string]: any } = {}

local function render()
	local d = State.data
	if not d or Modal.current ~= "index" or not ui.grid then
		return
	end
	ui.count.Text = string.format(
		"%d / %d  <font size='13' color='#6d7285'>descubiertos — las siluetas siguen siendo un misterio</font>",
		Profile.discoveredCount(d),
		Catalog.indexTotal()
	)
	Kit.clear(ui.tabs)
	for i, sp in Config.Species do
		local vs = Catalog.variantsFor(sp.id)
		local c = 0
		for _, v in vs do
			if d.discovered[sp.id .. "|" .. v] then
				c += 1
			end
		end
		local b = Kit.button(
			string.format(
				"%s%s <font transparency='0.4'>%d/%d</font>",
				if sp.famous then "✨ " else "",
				sp.name,
				c,
				#vs
			),
			if current == sp.id then Theme.purple else Theme.white,
			{
				Size = UDim2.new(1, -8, 0, 30),
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = i,
				Parent = ui.tabs,
			}
		)
		Kit.pad(8, 0).Parent = b
		b.Activated:Connect(function()
			current = sp.id
			Audio.play("click")
			render()
		end)
	end
	Kit.clear(ui.grid)
	local gen = {}
	ui.gen = gen
	local vs = Catalog.variantsFor(current)
	-- miniaturas progresivas para que la UI no se trabe (como el prototipo)
	task.spawn(function()
		for i, vid in vs do
			if ui.gen ~= gen then
				return
			end
			local v = Catalog.VAR[vid]
			local known = d.discovered[current .. "|" .. vid] == true
			local r = Catalog.R[v.rarity]
			local cell: Frame = Kit.new("Frame", {
				BackgroundColor3 = Theme.white,
				LayoutOrder = i,
				Parent = ui.grid,
			}, { Kit.corner(12), Kit.stroke(Color3.fromHex(r.color), 2) })
			local th: Frame = Kit.new("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(6, 4),
				Size = UDim2.new(1, -12, 0, 70),
				Parent = cell,
			})
			Thumb.make({ species = current, variant = vid }, th, not known)
			Kit.text(
				if known then Squishy.name({ species = current, variant = vid, mutation = "normal" }) else "???",
				11,
				{
					Font = Theme.bodyBlack,
					TextColor3 = if known then Theme.ink else Color3.fromHex("#a7abb9"),
					TextXAlignment = Enum.TextXAlignment.Center,
					Position = UDim2.new(0, 4, 1, -32),
					Size = UDim2.new(1, -8, 0, 28),
					Parent = cell,
				}
			)
			if i % 6 == 0 then
				task.wait()
			end
		end
	end)
end

local function open()
	local content = Modal.open("index", "Índice Squishy", {
		width = 900,
		height = 580,
		onClose = function()
			ui = {}
		end,
	})
	ui.count = Kit.text("", 20, { Font = Theme.display, Size = UDim2.new(1, 0, 0, 26), Parent = content })
	local tabs = Modal.scroll(content, { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(0, 230, 1, -34) })
	Kit.list(Enum.FillDirection.Vertical, 4).Parent = tabs
	ui.tabs = tabs
	local grid = Modal.scroll(content, { Position = UDim2.fromOffset(240, 34), Size = UDim2.new(1, -240, 1, -34) })
	Kit.grid(UDim2.fromOffset(100, 112), 8).Parent = grid
	Kit.pad(2, 4).Parent = grid
	ui.grid = grid
	Audio.play("open")
	render()
end

function Index.init()
	Router.register("index", open)
end

return Index
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Interact</string>
              <string name="Source"><![CDATA[--!strict
-- ProximityPrompts del mundo (WorldBuilder / NpcService) → abrir la pantalla que toca.
-- También pone los letreros "Nivel N" sobre las máquinas bloqueadas (refreshMachineLocks).
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Interact = {}

function Interact.init()
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local kind = prompt:GetAttribute("Kind") or (prompt.Parent and prompt.Parent:GetAttribute("Kind"))
		local id = prompt:GetAttribute("Id") or (prompt.Parent and prompt.Parent:GetAttribute("Id"))
		local why = Modal.blocked()
		if why then
			Toast.show(why)
			return
		end
		if Modal.current then
			Modal.close()
		end
		if kind == "machine" then
			Router.open("machine", id)
		elseif kind == "shop" then
			Router.open("shop")
		elseif kind == "index" then
			Router.open("index")
		elseif kind == "tradeBoard" then
			Router.open("tradePlayers")
		elseif kind == "npc" then
			if prompt:GetAttribute("Action") == "talk" then
				State.request("npcTalk", { npc = id })
			else
				Router.open("npcTrade", id)
			end
		end
	end)

	-- letreros de nivel en máquinas bloqueadas
	local signs: { [string]: BillboardGui } = {}
	local interact = Workspace:WaitForChild("Interact", 60)
	local function applyLocks()
		local d = State.data
		if not d then
			return
		end
		for _, m in Config.WorldLayout.machines do
			local s = signs[m.id]
			if s then
				s.Enabled = d.level < m.level
			end
		end
	end
	for _, m in Config.WorldLayout.machines do
		task.spawn(function()
			-- con StreamingEnabled el ancla puede llegar después
			local anchor = interact and interact:WaitForChild("machine_" .. m.id, 120)
			if not anchor or not anchor:IsA("BasePart") then
				return
			end
			signs[m.id] = Kit.new("BillboardGui", {
				Size = UDim2.fromOffset(150, 40),
				StudsOffsetWorldSpace = Vector3.new(0, 7.5, 3),
				MaxDistance = 90,
				Enabled = false,
				Parent = anchor,
			}, {
				Kit.text("🔒 Nivel " .. m.level, 20, {
					BackgroundTransparency = 0,
					BackgroundColor3 = Theme.ink,
					TextColor3 = Theme.white,
					Font = Theme.display,
					TextXAlignment = Enum.TextXAlignment.Center,
					Size = UDim2.fromScale(1, 1),
				}),
			})
			applyLocks()
		end)
	end
	State.onChange(applyLocks)
end

return Interact
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Inventory</string>
              <string name="Source"><![CDATA[--!strict
-- Inventario (renderInventory / renderInvDetail de game5.js): filtros por rareza y favoritos,
-- detalle, equipar, favorito, vender y "Vender repetidos".
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Profile = require(Shared.Logic.Profile)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Inventory = {}
local Inv = { filter = "all", sel = nil :: string? }
local ui: { [string]: any } = {}

--- Tarjeta con miniatura (se reutiliza en intercambios).
function Inventory.card(parent: Instance, s: any, d: any?, selected: boolean?): TextButton
	local r = Catalog.R[s.rarity]
	local b = Kit.button("", if selected then Theme.lav else Theme.white, {
		Size = UDim2.fromOffset(104, 128),
		Parent = parent,
	})
	local th: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(8, 6),
		Size = UDim2.fromOffset(88, 70),
		Parent = b,
	})
	Thumb.make(s, th)
	Kit.text(s.name, 11, {
		Font = Theme.bodyBlack,
		Position = UDim2.fromOffset(4, 76),
		Size = UDim2.new(1, -8, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = b,
	})
	Kit.text(r.name, 10, {
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromHex(r.color),
		TextColor3 = Theme.white,
		Font = Theme.bodyBlack,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 8, 1, -22),
		Size = UDim2.new(1, -16, 0, 16),
		Parent = b,
	})
	if s.fav then
		Kit.text("★", 16, {
			Position = UDim2.fromOffset(6, 2),
			Size = UDim2.fromOffset(20, 20),
			TextColor3 = Theme.yellowD,
			Parent = b,
		})
	end
	if d and d.equipped == s.id then
		Kit.text("Equipado", 10, {
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.mintD,
			TextColor3 = Theme.white,
			Font = Theme.bodyBlack,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -4, 0, 4),
			Size = UDim2.fromOffset(58, 16),
			Parent = b,
		})
	end
	return b
end

local render: () -> ()

local function detail(d: any)
	Kit.clear(ui.detail)
	local s = Inv.sel and Profile.find(d, Inv.sel)
	if not s then
		Kit.text("Elige un squishy para verlo aquí.", 14, {
			TextColor3 = Theme.muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 60),
			Parent = ui.detail,
		})
		return
	end
	local r = Catalog.R[s.rarity]
	local th: Frame = Kit.new(
		"Frame",
		{ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 150), LayoutOrder = 1, Parent = ui.detail }
	)
	Thumb.make(s, th)
	Kit.text(s.name, 20, { Font = Theme.display, LayoutOrder = 2, Parent = ui.detail })
	Kit.text(r.name, 12, {
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromHex(r.color),
		TextColor3 = Theme.white,
		Font = Theme.bodyBlack,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 20),
		LayoutOrder = 3,
		Parent = ui.detail,
	})
	local copies = 0
	for _, x in d.inventory do
		if Profile.idxKey(x) == Profile.idxKey(s) then
			copies += 1
		end
	end
	local mut = Catalog.MUT[s.mutation]
	local rows = {
		{ "Encontrado", os.date("%d/%m/%Y", s.dateFound) :: string },
		{ "Valor", Format.int(s.value) .. " monedas" },
		{ "Relleno", if Catalog.FIL[s.filling] then Catalog.FIL[s.filling].name else "—" },
		{ "Tamaño", string.format("%.2f×", s.size * ((mut and mut.size) or 1)) },
		{ "Copias", tostring(copies) },
	}
	for i, kv in rows do
		Kit.text(
			string.format('<font color="#6d7285">%s</font>   <b>%s</b>', kv[1], kv[2]),
			13,
			{ LayoutOrder = 10 + i, Parent = ui.detail }
		)
	end
	local row: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = 30,
		Parent = ui.detail,
	}, { Kit.list(Enum.FillDirection.Horizontal, 6) })
	local eq = Kit.button(
		if d.equipped == s.id then "Quitar" else "Equipar",
		Theme.mint,
		{ Size = UDim2.new(0.5, -3, 1, 0), Parent = row }
	)
	local fav = Kit.button(
		if s.fav then "★ Quitar fav" else "☆ Favorito",
		Theme.white,
		{ Size = UDim2.new(0.5, -3, 1, 0), TextSize = 14, Parent = row }
	)
	local sell =
		Kit.button("Vender por " .. Format.int(s.value), Theme.yellow, { LayoutOrder = 31, Parent = ui.detail })
	if s.fav or d.equipped == s.id then
		Kit.setEnabled(sell, false)
	end
	eq.Activated:Connect(function()
		Audio.play("select")
		State.request("inv", { op = "equip", id = s.id })
	end)
	fav.Activated:Connect(function()
		Audio.play("toggle")
		State.request("inv", { op = "fav", id = s.id })
	end)
	sell.Activated:Connect(function()
		if s.fav or d.equipped == s.id then
			return
		end
		State.request("inv", { op = "sell", id = s.id })
	end)
end

render = function()
	local d = State.data
	if not d or Modal.current ~= "inventory" or not ui.grid then
		return
	end
	ui.count.Text = string.format("%d/%d", #d.inventory, d.capacity or 20)
	for id, b in ui.tabs do
		b.BackgroundColor3 = if Inv.filter == id then Theme.pink else Theme.white
	end
	local list = table.clone(d.inventory)
	table.sort(list, function(a: any, b: any)
		if a.value ~= b.value then
			return a.value > b.value
		end
		return a.dateFound > b.dateFound
	end)
	local filtered = {}
	for _, s in list do
		if Inv.filter == "all" or (Inv.filter == "favorites" and s.fav) or s.rarity == Inv.filter then
			table.insert(filtered, s)
		end
	end
	Kit.clear(ui.grid)
	if #filtered == 0 then
		Kit.text(
			if #d.inventory > 0
				then "Nada con este filtro."
				else "Aún no tienes squishies. ¡Ve a las Máquinas y llena el primero!",
			14,
			{ TextColor3 = Theme.muted, Size = UDim2.fromOffset(400, 60), Parent = ui.grid }
		)
	end
	if not Inv.sel or not Profile.find(d, Inv.sel) then
		Inv.sel = if filtered[1] then filtered[1].id else nil
	end
	for i, s in filtered do
		local b = Inventory.card(ui.grid, s, d, Inv.sel == s.id)
		b.LayoutOrder = i
		b.Activated:Connect(function()
			Inv.sel = s.id
			Audio.play("click")
			render()
		end)
	end
	detail(d)
end

local function open()
	local content = Modal.open("inventory", "Inventario", {
		width = 900,
		height = 580,
		onClose = function()
			ui = {}
		end,
	})
	ui.count = Kit.text("", 16, {
		Font = Theme.display,
		TextColor3 = Theme.muted,
		Position = UDim2.new(0, 150, 0, -46),
		Size = UDim2.fromOffset(100, 30),
		Parent = content,
	})
	local dupes = Kit.button("Vender repetidos", Theme.yellow, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -50, 0, -48),
		Size = UDim2.fromOffset(170, 36),
		TextSize = 14,
		Parent = content,
	})
	dupes.Activated:Connect(function()
		local prev = State.request("inv", { op = "sellDupes", preview = true })
		if not prev.ok then
			return
		end
		Router.open("confirm", {
			text = string.format(
				"¿Vender %d repetido%s por %s monedas? Te quedas con la mejor copia de cada uno.",
				prev.count,
				if prev.count > 1 then "s" else "",
				Format.int(prev.total)
			),
			yes = function()
				State.request("inv", { op = "sellDupes" })
			end,
		})
	end)
	local tabs: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 32),
		Parent = content,
	}, { Kit.list(Enum.FillDirection.Horizontal, 6) })
	ui.tabs = {}
	local ids = { "all" }
	for _, r in Config.Rarities do
		table.insert(ids, r.id)
	end
	table.insert(ids, "favorites")
	for i, id in ids do
		local label = if id == "all" then "Todos" elseif id == "favorites" then "★ Favoritos" else Catalog.R[id].name
		local b = Kit.button(label, Theme.white, {
			Size = UDim2.fromOffset(0, 30),
			AutomaticSize = Enum.AutomaticSize.X,
			TextSize = 13,
			LayoutOrder = i,
			Parent = tabs,
		})
		Kit.pad(10, 0).Parent = b
		ui.tabs[id] = b
		b.Activated:Connect(function()
			Inv.filter = id
			Audio.play("click")
			render()
		end)
	end
	local gridHolder = Modal.scroll(content, {
		Position = UDim2.fromOffset(0, 40),
		Size = UDim2.new(1, -280, 1, -40),
	})
	Kit.grid(UDim2.fromOffset(104, 128), 8).Parent = gridHolder
	Kit.pad(2, 4).Parent = gridHolder
	ui.grid = gridHolder
	local det: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.lav,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 40),
		Size = UDim2.new(0, 266, 1, -40),
		Parent = content,
	}, { Kit.corner(16), Kit.pad(12, 10) })
	local detScroll = Modal.scroll(det)
	Kit.list(Enum.FillDirection.Vertical, 6).Parent = detScroll
	ui.detail = detScroll
	Audio.play("open")
	render()
end

function Inventory.init()
	Router.register("inventory", open)
	State.onChange(function()
		render()
	end)
end

return Inventory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Machine</string>
              <string name="Source"><![CDATA[--!strict
-- Panel "Crea un Squishy" + llenado (Fase 4). Porte de openMachine / renderMachinePanel /
-- holdStart / holdEnd de game5.js. El medidor se anima aquí con la MISMA fórmula, pero el resultado
-- (under/perfect/over/POP y la rareza) lo decide el servidor (FillService).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Profile = require(Shared.Logic.Profile)
local Squishy = require(Shared.Logic.Squishy)
local SquishyFactory = require(script.Parent.Parent.Engine.SquishyFactory)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local FILL = Config.Game.FILL
local M = Config.Monetization

local Machine = {}

type FillState = {
	state: string, -- idle | filling | processing | reveal
	machine: any?,
	species: string,
	filling: string,
	p: number,
	held: number,
	holding: boolean,
	started: boolean,
}

local Fill: FillState = {
	state = "idle",
	machine = nil,
	species = "cat",
	filling = "pink_foam",
	p = 0,
	held = 0,
	holding = false,
	started = false,
}

local ui: { [string]: any } = {}
local inside: Model? = nil

local function machineDef(id: string): any
	for _, m in Config.Machines do
		if m.id == id then
			return m
		end
	end
	return nil
end

local function domePos(id: string): Vector3
	for _, m in Config.WorldLayout.machines do
		if m.id == id then
			return m.dome
		end
	end
	return Vector3.zero
end

--- Suerte que ve el cliente (misma cuenta que FillService.luck en el servidor, solo para mostrar).
local function clientLuck(d: any, res: string?): number
	local L = Squishy.totalLuck(d.upgrades.luck, Fill.machine, Fill.filling, res :: any)
	if d.passes and d.passes.luckPlus then
		L += M.EFFECTS.luckPlus
	end
	if (d.luckLeft or 0) > 0 then
		L += M.EFFECTS.luckPotion
	end
	return L
end

local function clearInside()
	if inside then
		inside:Destroy()
		inside = nil
	end
end

local function setInside()
	clearInside()
	if not Fill.machine then
		return
	end
	local fil = Catalog.FIL[Fill.filling]
	local sp = Catalog.SP[Fill.species]
	local m = SquishyFactory.build({
		species = Fill.species,
		variant = if sp and sp.famous then "original" else "classic",
		mutation = "normal",
		size = 1,
	})
	-- tiñe con el color del relleno mientras se llena
	local body = m:FindFirstChild("Body", true)
	if body and body:IsA("BasePart") and fil then
		body.Color = Color3.fromHex(fil.color3 or (string.sub(fil.color, 1, 1) == "#" and fil.color) or "#F7A7CD")
	end
	m:ScaleTo(0.35)
	m:PivotTo(CFrame.new(domePos(Fill.machine.id)))
	m.Parent = Workspace
	inside = m
end

local function setGauge(p: number)
	if not ui.needle then
		return
	end
	local x = math.clamp(p, 0, FILL.pop) / FILL.pop
	ui.needle.Position = UDim2.new(x, 0, 0.5, 0)
	ui.prog.Size = UDim2.fromScale(x, 1)
end

local function resultText(txt: string, color: Color3)
	if ui.result then
		ui.result.Text = txt
		ui.result.TextColor3 = color
	end
end

local render: () -> ()

local function moldButton(parent: Instance, sp: any, d: any, locked: boolean)
	local avail = Profile.moldAvailable(d, sp.id)
	local b = Kit.button("", if Fill.species == sp.id then Theme.pink else Theme.white, {
		Size = UDim2.fromOffset(92, 92),
		Parent = parent,
	})
	local thumbHolder: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 2),
		Size = UDim2.fromOffset(68, 60),
		Parent = b,
	})
	Thumb.make({ species = sp.id, variant = if sp.famous then "original" else "classic" }, thumbHolder)
	Kit.text(sp.name, 11, {
		Position = UDim2.new(0, 4, 1, -30),
		Size = UDim2.new(1, -8, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Theme.bodyBlack,
		Parent = b,
	})
	if not avail then
		Kit.text(if sp.famous then "🛒 " .. Format.int(sp.price) else "Nv " .. sp.unlockLevel, 11, {
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.ink,
			TextColor3 = Theme.white,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 18),
			Position = UDim2.fromOffset(4, 4),
			Parent = b,
		})
		b.BackgroundTransparency = 0.35
	end
	b.Activated:Connect(function()
		if locked or Fill.state ~= "idle" then
			return
		end
		if not avail then
			Audio.play("error")
			Toast.show(
				if sp.famous
					then string.format("El molde %s se compra en la Tienda (%s monedas)", sp.name, Format.int(sp.price))
					else string.format("El molde %s se desbloquea en el nivel %d", sp.name, sp.unlockLevel)
			)
			return
		end
		Fill.species = sp.id
		Audio.play("click")
		render()
		setInside()
	end)
end

render = function()
	local d = State.data
	if not d or Modal.current ~= "machine" or not ui.body then
		return
	end
	local locked = Fill.state ~= "idle"
	-- moldes
	Kit.clear(ui.molds)
	Kit.clear(ui.virals)
	local virals = {}
	for _, sp in Config.Species do
		if sp.famous then
			table.insert(virals, sp)
		else
			moldButton(ui.molds, sp, d, locked)
		end
	end
	table.sort(virals, function(a, b)
		local aa, bb = Profile.moldAvailable(d, a.id), Profile.moldAvailable(d, b.id)
		if aa ~= bb then
			return aa
		end
		return a.price < b.price
	end)
	for _, sp in virals do
		moldButton(ui.virals, sp, d, locked)
	end
	-- rellenos
	Kit.clear(ui.fills)
	for _, f in Config.Fillings do
		local own = table.find(d.fillings, f.id) ~= nil
		local label = f.name
		if own and f.perUse then
			label ..= if d.passes and d.passes.vip then " (gratis 👑)" else string.format(" (%d)", f.perUse)
		elseif not own then
			label ..= " 🔒"
		end
		local b = Kit.button(label, if Fill.filling == f.id then Theme.pink else Theme.white, {
			Size = UDim2.fromOffset(128, 34),
			TextSize = 12,
			Parent = ui.fills,
		})
		local sw = Color3.fromHex(f.color3 or (string.sub(f.color, 1, 1) == "#" and f.color) or "#ffd36e")
		Kit.new("Frame", {
			BackgroundColor3 = sw,
			Size = UDim2.fromOffset(12, 12),
			Position = UDim2.new(0, 6, 0.5, -6),
			Parent = b,
		}, { Kit.corner(6) })
		b.Activated:Connect(function()
			if Fill.state ~= "idle" then
				return
			end
			if not own then
				Audio.play("error")
				Toast.show(string.format("%s se vende en la Tienda (%s monedas)", f.name, Format.int(f.price)))
				return
			end
			Fill.filling = f.id
			Audio.play("click")
			render()
			setInside()
		end)
	end
	-- probabilidades (normal y con Perfecto)
	Kit.clear(ui.odds)
	local w = Squishy.rarityWeights(clientLuck(d, nil), Fill.filling)
	local tot = 0
	for _, x in w do
		tot += x
	end
	for i, r in Config.Rarities do
		local pct = w[i] / tot * 100
		Kit.text(
			string.format(
				"%s %s%%",
				string.sub(r.name, 1, 4),
				if i > 3 then string.format("%.1f", pct) else string.format("%d", math.round(pct))
			),
			11,
			{
				BackgroundTransparency = 0,
				BackgroundColor3 = Color3.fromHex(r.color),
				TextColor3 = Theme.white,
				Font = Theme.bodyBlack,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromOffset(62, 20),
				Parent = ui.odds,
			}
		)
	end
	-- botón
	local full = #d.inventory >= (d.capacity or 20)
	ui.hold.Text = if Fill.state == "filling" and Fill.holding then "Llenando… ¡suelta!" else "Mantén para llenar"
	Kit.setEnabled(ui.hold, Fill.state == "idle" or Fill.state == "filling")
	if full and Fill.state == "idle" then
		resultText(
			string.format("Inventario lleno (%d). Vende algunos squishies primero.", d.capacity or 20),
			Theme.red
		)
		Kit.setEnabled(ui.hold, false)
	elseif Fill.state == "idle" and ui.result.Text ~= "" and not ui.keepResult then
		resultText("", Theme.muted)
	end
end

local function processing(res: { [string]: any })
	Fill.state = "processing"
	render()
	local labels: { [string]: { any } } = {
		under = { "Le faltó", Theme.muted },
		perfect = { "¡PERFECTO!", Theme.green },
		over = { "Se pasó", Theme.orange },
	}
	local l = labels[res.result]
	resultText(l[1], l[2])
	if res.result == "perfect" then
		Audio.play("sparkle")
	end
	Audio.play("whirr")
	task.delay(FILL.process, function()
		clearInside()
		Fill.state = "reveal"
		Router.open("reveal", { squishy = res.squishy, isNew = res.isNew, fromMachine = true })
	end)
end

local function popped()
	Fill.state = "processing"
	Audio.play("pop")
	clearInside()
	resultText("¡POP! Se reventó — demasiado lleno.", Theme.red)
	task.delay(1.4, function()
		Fill.state = "idle"
		Fill.p = 0
		Fill.held = 0
		Fill.started = false
		setGauge(0)
		ui.keepResult = false
		render()
		setInside()
	end)
end

local function holdEnd()
	if not Fill.holding then
		return
	end
	Fill.holding = false
	Audio.loop("fillLoop", false)
	if Fill.state ~= "filling" then
		return
	end
	-- espera a que el servidor haya registrado el inicio
	local t0 = os.clock()
	while not Fill.started and os.clock() - t0 < 3 and Fill.state == "filling" do
		task.wait()
	end
	if Fill.state ~= "filling" then
		return
	end
	local res = State.request("fillRelease", { held = Fill.held })
	if not res.ok then
		Fill.state = "idle"
		Fill.p = 0
		Fill.held = 0
		Fill.started = false
		setGauge(0)
		render()
		return
	end
	Fill.held = res.held or Fill.held
	Fill.p = res.p or Fill.p
	setGauge(Fill.p)
	if res.result == "short" then
		resultText("Sigue manteniendo…", Theme.muted)
		ui.keepResult = true
		render()
	elseif res.result == "pop" then
		ui.keepResult = true
		popped()
	else
		ui.keepResult = true
		processing(res)
	end
end

local function holdStart()
	if Modal.current ~= "machine" or not Fill.machine then
		return
	end
	local d = State.data
	if not d then
		return
	end
	if Fill.state == "idle" then
		if #d.inventory >= (d.capacity or 20) then
			Audio.play("error")
			return
		end
		Fill.state = "filling"
		Fill.p = 0
		Fill.held = 0
		Fill.started = false
		ui.keepResult = false
		resultText("", Theme.muted)
	elseif Fill.state ~= "filling" then
		return
	end
	Fill.holding = true
	Audio.loop("fillLoop", true)
	render()
	task.spawn(function()
		local res = State.request("fillStart", {
			machine = Fill.machine.id,
			species = Fill.species,
			filling = Fill.filling,
		})
		if not res.ok then
			Fill.holding = false
			Fill.state = "idle"
			Fill.p = 0
			Fill.held = 0
			setGauge(0)
			Audio.loop("fillLoop", false)
			Audio.play("error")
			if res.err == "pending" and res.squishy then
				Router.open("reveal", { squishy = res.squishy, isNew = false, fromMachine = true })
			elseif type(res.err) == "string" and #res.err > 12 then
				Toast.show(res.err)
			end
			render()
			return
		end
		Fill.started = true
	end)
end

local function open(machineId: string)
	local d = State.data
	local def = machineDef(machineId)
	if not d or not def then
		return
	end
	if d.level < def.level then
		Audio.play("error")
		Toast.show(string.format("%s se abre en el nivel %d", def.name, def.level))
		return
	end
	Fill.machine = def
	Fill.state = "idle"
	Fill.p = 0
	Fill.held = 0
	Fill.started = false
	Fill.species = if Profile.moldAvailable(d, d.lastMold) then d.lastMold else "cat"
	Fill.filling = if table.find(d.fillings, d.lastFill) then d.lastFill else "classic_foam"
	if d.tutorial <= 2 then
		Fill.species = "cat"
		Fill.filling = "pink_foam"
	end
	local content = Modal.open("machine", if def.id == "m1" then "Crea un Squishy" else def.name, {
		width = 470,
		height = 660,
		anchor = Vector2.new(1, 0.5),
		position = UDim2.new(1, -16, 0.5, 10),
		onClose = function()
			if Fill.holding then
				Fill.holding = false
				Audio.loop("fillLoop", false)
			end
			if Fill.state == "filling" then
				State.request("fillCancel")
			end
			if Fill.state ~= "reveal" then
				Fill.state = "idle"
			end
			clearInside()
			ui = {}
		end,
	})
	local scroll = Modal.scroll(content)
	Kit.list(Enum.FillDirection.Vertical, 8).Parent = scroll
	ui.body = scroll
	local info = string.format("%s · %s", def.name, def.sub)
	if def.luck and def.luck > 0 then
		info ..= string.format(" · +%d%% suerte", math.round(def.luck * 100))
	end
	if def.mutX then
		info ..= " · más mutaciones"
	end
	Kit.text(info, 13, { TextColor3 = Theme.muted, LayoutOrder = 1, Parent = scroll })

	local function section(title: string, order: number, color: Color3?): Frame
		Kit.text(
			title,
			15,
			{ Font = Theme.display, TextColor3 = color or Theme.ink, LayoutOrder = order, Parent = scroll }
		)
		local f: Frame = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, -8, 0, 0),
			LayoutOrder = order + 1,
			Parent = scroll,
		})
		local g = Kit.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(92, 92),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = f,
		})
		ui["grid" .. order] = g
		return f
	end
	ui.molds = section("Moldes", 10)
	ui.virals = section("✨ Moldes virales", 20, Color3.fromHex("#a86ad0"))
	ui.fills = section("Relleno", 30)
	ui["grid30"].CellSize = UDim2.fromOffset(128, 34)

	Kit.text("Probabilidades", 13, { TextColor3 = Theme.muted, LayoutOrder = 40, Parent = scroll })
	ui.odds = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 22),
		LayoutOrder = 41,
		Parent = scroll,
	}, { Kit.list(Enum.FillDirection.Horizontal, 4) })

	-- medidor con zonas (gauge del prototipo)
	local gauge: Frame = Kit.new("Frame", {
		BackgroundColor3 = Color3.fromHex("#e9e4f2"),
		Size = UDim2.new(1, -8, 0, 30),
		ClipsDescendants = true,
		LayoutOrder = 50,
		Parent = scroll,
	}, { Kit.corner(15) })
	local span = FILL.pop
	local function zone(a: number, b: number, col: string)
		Kit.new("Frame", {
			BackgroundColor3 = Color3.fromHex(col),
			BorderSizePixel = 0,
			Position = UDim2.fromScale(a / span, 0),
			Size = UDim2.fromScale((b - a) / span, 1),
			Parent = gauge,
		})
	end
	zone(FILL.perfect[1], FILL.perfect[2], "#9CE0CA")
	zone(FILL.perfect[2], span * 0.97, "#ffd9a8")
	zone(span * 0.97, span, "#ff9aa8")
	ui.prog = Kit.new("Frame", {
		BackgroundColor3 = Theme.pink,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = gauge,
	})
	ui.needle = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.ink,
		Size = UDim2.new(0, 4, 1, 4),
		Position = UDim2.fromScale(0, 0.5),
		Parent = gauge,
	})
	local lbl: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, 16),
		LayoutOrder = 51,
		Parent = scroll,
	})
	local gaugeLabels: { { any } } = {
		{ "Le falta", 0 },
		{ "Perfecto", FILL.perfect[1] / span },
		{ "Se pasa", FILL.perfect[2] / span },
		{ "¡POP!", 0.97 },
	}
	for _, info2 in gaugeLabels do
		Kit.text(info2[1] :: string, 11, {
			Position = UDim2.fromScale(info2[2] :: number, 0),
			Size = UDim2.fromOffset(70, 16),
			TextColor3 = Theme.muted,
			Font = Theme.bodyBlack,
			Parent = lbl,
		})
	end

	ui.hold = Kit.button("Mantén para llenar", Theme.pink, {
		Size = UDim2.new(1, -8, 0, 56),
		TextSize = 20,
		Font = Theme.display,
		LayoutOrder = 60,
		Parent = scroll,
	})
	ui.hold.MouseButton1Down:Connect(holdStart)
	ui.hold.MouseButton1Up:Connect(function()
		task.spawn(holdEnd)
	end)
	ui.hold.MouseLeave:Connect(function()
		if Fill.holding then
			task.spawn(holdEnd)
		end
	end)
	ui.result = Kit.text("", 18, {
		Font = Theme.display,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -8, 0, 44),
		LayoutOrder = 61,
		Parent = scroll,
	})
	Audio.play("open")
	render()
	setGauge(0)
	setInside()
	if d.tutorial < 3 then
		State.request("tutorial", { step = 3 })
		Toast.show(
			"El molde Gato y la Espuma Rosa están listos. ¡Mantén el botón y suelta en la zona verde Perfecto!",
			false,
			5000
		)
	end
end

--- La revelación terminó (guardado o vendido): la máquina vuelve a estar lista.
function Machine.revealDone()
	Fill.state = "idle"
	Fill.p = 0
	Fill.held = 0
	Fill.started = false
	ui.keepResult = false
	setGauge(0)
	if Modal.current == "machine" then
		render()
		setInside()
	end
end

function Machine.reopen()
	if Fill.machine then
		open(Fill.machine.id)
	end
end

function Machine.init()
	Modal.addGuard(function()
		if Modal.current == "machine" and (Fill.state == "filling" or Fill.state == "processing") then
			return "Termina de llenar primero"
		end
		return nil
	end)
	Router.register("machine", function(id)
		open(tostring(id))
	end)
	State.onChange(function()
		if Fill.state == "idle" then
			render()
		end
	end)
	RunService.RenderStepped:Connect(function(dt: number)
		if Fill.holding and Fill.state == "filling" then
			local d = State.data
			local speed = if d then d.upgrades.fillSpeed else 1
			local time = FILL.baseTime / (1 + 0.2 * (speed - 1))
			Fill.p += dt / time * (1 + Fill.p * 0.35)
			Fill.held += dt
			setGauge(Fill.p)
			if inside then
				inside:ScaleTo(0.35 + 0.65 * math.min(1.1, Fill.p))
			end
			if Fill.p >= FILL.pop then
				task.spawn(holdEnd)
			end
		end
	end)
end

return Machine
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Reveal</string>
              <string name="Source"><![CDATA[--!strict
-- Revelación (showReveal / endReveal de game5.js): "Te salió…", rareza con su color, nombre,
-- badges (nuevo, mutación, viral, valor) y Guardar / Vender. Pantalla negra para el Secreto.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Format = require(Shared.Util.Format)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Theme = require(script.Parent.Parent.UI.Theme)
local Audio = require(script.Parent.Audio)
local Machine = require(script.Parent.Machine)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Reveal = {}
local overlay: Frame? = nil
local spinConn: RBXScriptConnection? = nil

local function close()
	if spinConn then
		spinConn:Disconnect()
		spinConn = nil
	end
	if overlay then
		overlay:Destroy()
		overlay = nil
	end
end

local function show(arg: any)
	local d = arg.squishy
	if not d then
		return
	end
	close()
	local r = Catalog.R[d.rarity]
	local tier = Catalog.RTier[d.rarity]
	local secret = d.rarity == "secret"
	local rc = Color3.fromHex(r.color)
	local ov: Frame = Kit.new("Frame", {
		Name = "Reveal",
		BackgroundColor3 = if secret then Color3.fromHex("#07060c") else Color3.fromHex("#FFF6FB"),
		BackgroundTransparency = if secret then 0 else 0.08,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 40,
		Active = true,
		Parent = Kit.root(),
	})
	overlay = ov
	local col: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(520, 640),
		Parent = ov,
	}, { Kit.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center) })
	Kit.new("UIScale", { Parent = col, Scale = 1 })
	local txtColor = if secret then Theme.white else Theme.ink
	Kit.text("Te salió…", 22, {
		Font = Theme.display,
		TextColor3 = txtColor,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 1,
		Parent = col,
	})
	local view: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(340, 340),
		LayoutOrder = 2,
		Parent = col,
	})
	local vf = Thumb.make({ species = d.species, variant = d.variant, mutation = d.mutation }, view)
	local rarity = Kit.text("", 44, {
		Font = Theme.display,
		TextColor3 = rc,
		TextStrokeColor3 = Theme.white,
		TextStrokeTransparency = if secret then 1 else 0.2,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 52),
		LayoutOrder = 3,
		Parent = col,
	})
	local name = Kit.text("", 24, {
		Font = Theme.display,
		TextColor3 = txtColor,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 4,
		Parent = col,
	})
	local badges: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 5,
		Parent = col,
	}, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center) })
	local btns: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(420, 56),
		LayoutOrder = 6,
		Visible = false,
		Parent = col,
	}, { Kit.list(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center) })

	-- giro + aparición del squishy
	local cam = vf.CurrentCamera
	local model = vf:FindFirstChildWhichIsA("Model")
	local t = 0
	if model and cam then
		local base = model:GetPivot()
		model:ScaleTo(0.01)
		spinConn = RunService.RenderStepped:Connect(function(dt)
			t += dt
			local grow = math.min(1, t / 0.5)
			local e = 1 - (1 - grow) ^ 3
			model:ScaleTo(math.max(0.01, e * (1 + 0.08 * math.sin(t * 9) * (1 - grow))))
			model:PivotTo(base * CFrame.Angles(0, t * 0.9, 0))
		end)
	end

	if secret then
		Audio.play("secretSting")
	end
	task.delay(if secret then 0.9 else 0.65, function()
		if overlay ~= ov then
			return
		end
		rarity.Text = if secret then "¡SECRETO ENCONTRADO!" else "¡" .. r.name .. "!"
		name.Text = d.name
		local function badge(text: string, color: Color3?)
			Kit.text(text, 13, {
				BackgroundTransparency = 0,
				BackgroundColor3 = color or Theme.paper,
				TextColor3 = if color then Theme.white else Theme.ink,
				Font = Theme.bodyBlack,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 26),
				TextXAlignment = Enum.TextXAlignment.Center,
				Parent = badges,
			}).Parent =
				badges
		end
		if arg.isNew then
			badge("¡Squishy nuevo descubierto!", Theme.pinkD)
		end
		if d.mutation ~= "normal" and Catalog.MUT[d.mutation] then
			badge(Catalog.MUT[d.mutation].name, Theme.purple)
		end
		if Catalog.SP[d.species] and Catalog.SP[d.species].famous then
			badge("✨ Viral", Theme.yellowD)
		end
		badge(string.format("Vale %s monedas", Format.int(d.value)))
		for _, ch in badges:GetChildren() do
			if ch:IsA("TextLabel") then
				Kit.pad(10, 3).Parent = ch
				Kit.corner(10).Parent = ch
			end
		end

		local data = State.data
		local full = data and #data.inventory >= (data.capacity or 20)
		local keep =
			Kit.button("Guardar", Theme.mint, { Size = UDim2.fromOffset(190, 52), TextSize = 20, Parent = btns })
		local sell = Kit.button("Vender +" .. Format.int(d.value), Theme.yellow, {
			Size = UDim2.fromOffset(190, 52),
			TextSize = 20,
			Parent = btns,
		})
		if full then
			Kit.setEnabled(keep, false)
		end
		btns.Visible = true
		local busy = false
		local function decide(k: boolean)
			if busy then
				return
			end
			busy = true
			local res = State.request("reveal", { keep = k })
			busy = false
			if res.ok then
				close()
				Machine.revealDone()
				local st = State.data
				if k and st and st.tutorial == 4 then
					Router.open("tutorialEquip")
				end
			else
				Audio.play("error")
			end
		end
		keep.Activated:Connect(function()
			if full then
				return
			end
			decide(true)
		end)
		sell.Activated:Connect(function()
			decide(false)
		end)

		if tier == 0 then
			Audio.play("reward")
		elseif tier == 1 then
			Audio.play("reward")
			Audio.play("sparkle2")
		elseif tier == 2 then
			Audio.play("rare")
			Audio.play("sparkle")
		elseif tier == 3 then
			Audio.play("epic")
			Audio.play("sparkle")
		elseif tier >= 4 then
			Audio.play("fanfare")
		end
	end)
end

function Reveal.init()
	Router.register("reveal", show)
	-- si entraste con un squishy pendiente (te fuiste en plena revelación), se muestra de nuevo
	task.spawn(function()
		local d = State.waitReady()
		if d.pending then
			show({ squishy = d.pending, isNew = false })
		end
	end)
end

return Reveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Router</string>
              <string name="Source"><![CDATA[--!strict
-- Abre pantallas por nombre sin que los controladores se requieran entre sí (evita ciclos).
local Modal = require(script.Parent.Parent.UI.Modal)
local Toast = require(script.Parent.Parent.UI.Toast)

local Router = {}
-- estas se pueden abrir aunque haya algo en curso (no reemplazan la ventana actual)
local OVERLAYS = { reveal = true, confirm = true, tutorialEquip = true }
local routes: { [string]: (any?) -> () } = {}

function Router.register(name: string, fn: (any?) -> ())
	routes[name] = fn
end

function Router.open(name: string, arg: any?)
	local fn = routes[name]
	if not OVERLAYS[name] then
		local why = Modal.blocked()
		if why then
			Toast.show(why)
			return
		end
	end
	if fn then
		fn(arg)
	else
		warn("[Router] pantalla desconocida:", name)
	end
end

return Router
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--!strict
-- Tienda (renderShop de game5.js): ✨ Moldes Virales, Rellenos, Mejoras + ⭐ Robux (pases y productos).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local M = Config.Monetization
local Shop = {}
local tab = "fillings"
local ui: { [string]: any } = {}
local realPrice: { [string]: number } = {}

local TABS = {
	{ "molds", "✨ Moldes Virales" },
	{ "fillings", "Rellenos" },
	{ "upgrades", "Mejoras" },
	{ "robux", "⭐ Robux" },
}

local function item(
	parent: Instance,
	order: number,
	title: string,
	desc: string,
	buttonText: string,
	color: Color3,
	enabled: boolean,
	onBuy: () -> ()
): Frame
	local f: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.white,
		LayoutOrder = order,
		Parent = parent,
	}, { Kit.corner(16), Kit.stroke(Theme.lav2, 2), Kit.pad(12, 10) })
	Kit.text(
		title,
		16,
		{ Font = Theme.display, Position = UDim2.fromOffset(62, 0), Size = UDim2.new(1, -62, 0, 22), Parent = f }
	)
	Kit.text(desc, 12, {
		TextColor3 = Theme.muted,
		Position = UDim2.fromOffset(62, 24),
		Size = UDim2.new(1, -62, 1, -70),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = f,
	})
	local b = Kit.button(buttonText, color, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 36),
		TextSize = 15,
		Parent = f,
	})
	Kit.setEnabled(b, enabled)
	b.Activated:Connect(function()
		if enabled then
			onBuy()
		end
	end)
	return f
end

local function icon(f: Frame, text: string?, bg: Color3?)
	local holder: Frame = Kit.new("Frame", {
		BackgroundColor3 = bg or Theme.lav,
		BackgroundTransparency = if bg then 0 else 1,
		Size = UDim2.fromOffset(54, 54),
		Parent = f,
	}, { Kit.corner(14) })
	if text then
		Kit.text(
			text,
			30,
			{ Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = holder }
		)
	end
	return holder
end

local function buy(kind: string, id: string)
	local res = State.request("shop", { kind = kind, id = id })
	if not res.ok then
		Audio.play("error")
		if res.err == "monedas" then
			Toast.show("No te alcanzan las monedas")
		end
	end
end

local function buyRobux(entry: any, isPass: boolean)
	if entry.id == 0 then
		if RunService:IsStudio() then
			State.request("devBuy", { key = entry.key })
		else
			Toast.show("¡Muy pronto!")
		end
		return
	end
	local lp = Players.LocalPlayer
	if isPass then
		MarketplaceService:PromptGamePassPurchase(lp, entry.id)
	else
		MarketplaceService:PromptProductPurchase(lp, entry.id)
	end
end

local function priceOf(entry: any, isPass: boolean): number
	if entry.id == 0 then
		return entry.robux
	end
	local k = (if isPass then "p" else "d") .. entry.id
	if realPrice[k] then
		return realPrice[k]
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(
				entry.id,
				if isPass then Enum.InfoType.GamePass else Enum.InfoType.Product
			)
		end)
		if ok and info and info.PriceInRobux then
			realPrice[k] = info.PriceInRobux
		end
	end)
	return entry.robux
end

local function render()
	local d = State.data
	if not d or Modal.current ~= "shop" or not ui.grid then
		return
	end
	for id, b in ui.tabs do
		b.BackgroundColor3 = if tab == id then (if id == "robux" then Theme.robux else Theme.pink) else Theme.white
		b.TextColor3 = if tab == id then Theme.white else Theme.ink
	end
	Kit.clear(ui.grid)
	if tab == "molds" then
		for i, sp in Config.Species do
			if sp.famous then
				local own = table.find(d.molds, sp.id) ~= nil
				local firm = if sp.soft >= 1.2 then "súper suave" elseif sp.soft >= 1 then "suave" else "firme"
				local f = item(
					ui.grid,
					i,
					sp.name,
					string.format("%s\n<b>Slow rise %ss · %s</b>", sp.desc, tostring(sp.rise), firm),
					if own then "Tuyo" else "🪙 " .. Format.int(sp.price),
					if own then Theme.white else Theme.pink,
					not own and d.coins >= sp.price,
					function()
						buy("mold", sp.id)
					end
				)
				Thumb.make({ species = sp.id, variant = "original" }, icon(f))
			end
		end
	elseif tab == "fillings" then
		for i, fl in Config.Fillings do
			if fl.price > 0 then
				local own = table.find(d.fillings, fl.id) ~= nil
				local f = item(
					ui.grid,
					i,
					fl.name,
					fl.desc or "",
					if own then "Tuyo" else "🪙 " .. Format.int(fl.price),
					if own then Theme.white else Theme.pink,
					not own and d.coins >= fl.price,
					function()
						buy("filling", fl.id)
					end
				)
				local col = Color3.fromHex(fl.color3 or (string.sub(fl.color, 1, 1) == "#" and fl.color) or "#ffd36e")
				icon(f, nil, col)
			end
		end
	elseif tab == "upgrades" then
		local order = { "fillSpeed", "luck", "storage" }
		for i, k in order do
			local u = (Config.Upgrades :: any)[k]
			local lvl = if k == "fillSpeed" then d.upgrades.fillSpeed - 1 else d.upgrades[k]
			local maxed = lvl >= #u.costs
			local cost = u.costs[lvl + 1]
			local cur
			if k == "storage" then
				cur = string.format("Guarda %d", u.caps[lvl + 1])
					.. (if maxed then "" else string.format(" → %d", u.caps[lvl + 2]))
			elseif k == "luck" then
				cur = string.format("+%d%% suerte", lvl * 6)
					.. (if maxed then "" else string.format(" → +%d%%", (lvl + 1) * 6))
			else
				cur = string.format("Velocidad %d", lvl + 1)
					.. (if maxed then "" else string.format(" → %d", lvl + 2))
			end
			local dots = string.rep("●", lvl) .. string.rep("○", #u.costs - lvl)
			local f = item(
				ui.grid,
				i,
				u.name,
				string.format("%s\n<b>%s</b>\n%s", u.desc, cur, dots),
				if maxed then "Nivel máximo" else "🪙 " .. Format.int(cost),
				if maxed then Theme.white else Theme.mint,
				not maxed and d.coins >= cost,
				function()
					buy("upgrade", k)
				end
			)
			icon(f, ({ fillSpeed = "⚡", luck = "🍀", storage = "🎒" })[k])
		end
	else
		Kit.text(
			"Pases (para siempre)",
			16,
			{ Font = Theme.display, LayoutOrder = 0, Size = UDim2.fromOffset(300, 24), Parent = ui.grid }
		)
		for i, p in M.PASSES do
			local own = d.passes and d.passes[p.key]
			local f = item(
				ui.grid,
				i,
				p.name,
				p.desc,
				if own then "¡Ya lo tienes!" else string.format("R$ %d", priceOf(p, true)),
				if own then Theme.white else Theme.robux,
				not own and (p.id ~= 0 or RunService:IsStudio()),
				function()
					buyRobux(p, true)
				end
			)
			icon(f, p.icon)
		end
		for i, p in M.PRODUCTS do
			local f = item(
				ui.grid,
				100 + i,
				p.name,
				p.desc,
				string.format("R$ %d", priceOf(p, false)),
				Theme.robux,
				p.id ~= 0 or RunService:IsStudio(),
				function()
					buyRobux(p, false)
				end
			)
			icon(f, p.icon)
		end
	end
end

local function open(startTab: any?)
	if type(startTab) == "string" then
		tab = startTab
	end
	local content = Modal.open("shop", "Tienda", {
		width = 860,
		height = 560,
		onClose = function()
			ui = {}
		end,
	})
	local tabs: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 34),
		Parent = content,
	}, { Kit.list(Enum.FillDirection.Horizontal, 6) })
	ui.tabs = {}
	for i, t in TABS do
		local b = Kit.button(t[2], Theme.white, {
			Size = UDim2.fromOffset(0, 32),
			AutomaticSize = Enum.AutomaticSize.X,
			TextSize = 14,
			LayoutOrder = i,
			Parent = tabs,
		})
		Kit.pad(12, 0).Parent = b
		ui.tabs[t[1]] = b
		b.Activated:Connect(function()
			tab = t[1]
			Audio.play("click")
			render()
		end)
	end
	local grid = Modal.scroll(content, { Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 1, -44) })
	Kit.grid(UDim2.fromOffset(260, 150), 10).Parent = grid
	Kit.pad(2, 4).Parent = grid
	ui.grid = grid
	Audio.play("open")
	render()
	-- precios reales del Marketplace llegan async
	task.delay(1.5, render)
end

function Shop.init()
	Router.register("shop", open)
	Router.register("robux", function()
		open("robux")
	end)
	State.onChange(function()
		render()
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Squish</string>
              <string name="Source"><![CDATA[--!strict
-- Apachurrar en el mundo — versión mínima (Opción C de ROBLOX_ARCHITECTURE §6): mantener clic
-- (o el dedo) sobre cualquier squishy a < 34 studs lo aplasta (squash & stretch) y al soltar sube
-- lento con la recuperación de 2 fases de SYSTEMS_SPEC §7 (tauS = rise/3). El dueño se detiene.
-- Los brazos de tu avatar R15 lo agarran (AvatarHands.luau). La física de espuma completa con
-- EditableMesh es la Fase 7.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Damp = require(Shared.Util.Damp)
local Modal = require(script.Parent.Parent.UI.Modal)
local Audio = require(script.Parent.Audio)
local AvatarHands = require(script.Parent.AvatarHands)
local Companion = require(script.Parent.Companion)
local State = require(script.Parent.State)

local Squish = {}

local RANGE = 34

type Target = {
	model: Model,
	offsets: { [BasePart]: { cf: CFrame, size: Vector3 } },
	pivotToBottom: number,
	basePivot: CFrame, -- pivote al empezar (Body se mueve al aplastar; no releer GetPivot)
	f: number, -- fase rápida
	s: number, -- fase lenta
	target: number,
	held: boolean,
	rise: number,
	soft: number,
}

local active: Target? = nil

local function riseOf(model: Model): (number, number)
	local sp = Catalog.SP[string.gsub(model.Name, "^Squishy_", "")]
	local rise = if sp and sp.rise then sp.rise else 3.2
	local soft = if sp and sp.soft then sp.soft else 1
	return rise, soft
end

local function capture(model: Model): Target
	local pivot = model:GetPivot()
	local offsets = {}
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			offsets[p] = { cf = pivot:ToObjectSpace(p.CFrame), size = p.Size }
		end
	end
	local cf, size = model:GetBoundingBox()
	local rise, soft = riseOf(model)
	return {
		model = model,
		offsets = offsets,
		pivotToBottom = pivot.Y - (cf.Y - size.Y / 2),
		basePivot = pivot,
		f = 0,
		s = 0,
		target = 0,
		held = true,
		rise = rise,
		soft = soft,
	}
end

local function apply(t: Target)
	local k = t.f + t.s
	local sy = 1 - k
	local sxz = 1 + k * 0.62
	local pivot = t.basePivot
	local scale = Vector3.new(sxz, sy, sxz)
	for p, o in t.offsets do
		if p.Parent then
			-- escalar respecto a la base (se desparrama en el piso)
			local rel = o.cf.Position + Vector3.new(0, t.pivotToBottom, 0)
			local newPos = rel * scale - Vector3.new(0, t.pivotToBottom, 0)
			p.CFrame = pivot * (CFrame.new(newPos) * o.cf.Rotation)
			p.Size = o.size * scale
		end
	end
end

local function restore(t: Target)
	local pivot = t.basePivot
	for p, o in t.offsets do
		if p.Parent then
			p.CFrame = pivot * o.cf
			p.Size = o.size
		end
	end
end

local function pick(pos: Vector2): Model?
	local cam = Workspace.CurrentCamera
	local folder = Workspace:FindFirstChild("Companions")
	if not cam or not folder then
		return nil
	end
	local ray = cam:ViewportPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 200, params)
	if not hit then
		return nil
	end
	local m = hit.Instance:FindFirstAncestorWhichIsA("Model")
	while m and not m:GetAttribute("Squishy") do
		m = m:FindFirstAncestorWhichIsA("Model")
	end
	if not m then
		return nil
	end
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (m:GetPivot().Position - root.Position).Magnitude > RANGE then
		return nil
	end
	return m
end

local function press(pos: Vector2)
	if Modal.current then
		return
	end
	local m = pick(pos)
	if not m then
		return
	end
	if active and active.model ~= m then
		restore(active)
	end
	if not active or active.model ~= m then
		active = capture(m)
	end
	local t = active :: Target
	t.held = true
	Companion.frozen = m
	AvatarHands.grab(m)
	Audio.play(if t.soft >= 1.1 then "squish2" else "squish", 0.9 + math.random() * 0.2)
	task.spawn(State.request, "squish")
	local npc = m:GetAttribute("NpcOwner")
	if npc then
		task.spawn(State.request, "npcSquished", { npc = npc })
	end
end

local function releaseAll()
	AvatarHands.release()
	local t = active
	if t and t.held then
		t.held = false
		-- rebote al soltar si estaba muy hundido
		local depth = t.f + t.s
		if depth > 0.25 * 0.45 then
			t.f -= 0.1 * (depth / 0.45) * math.clamp(2.6 / t.rise, 0.25, 1.3)
		end
	end
end

function Squish.init()
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			press(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			releaseAll()
		end
	end)
	RunService.RenderStepped:Connect(function(dt: number)
		local t = active
		AvatarHands.update(dt, if t then t.f + t.s else 0)
		if not t then
			return
		end
		if not t.model.Parent then
			active = nil
			Companion.frozen = nil
			return
		end
		local max = math.min(0.45, 0.3 * t.soft + 0.1)
		if t.held then
			-- rigidez progresiva: se hunde rápido al principio y cada vez cuesta más
			t.target += dt * max * (2.8 * 0.6 * (1 - t.target / max) ^ 1.25 + 0.05)
			t.target = math.min(t.target, max)
			local depth = Damp.number(t.f + t.s, t.target, 14, dt)
			t.f = 0.35 * depth
			t.s = 0.65 * depth
		else
			t.target = 0
			local tauS = math.max(0.15, t.rise / 3)
			local tauF = 0.05 + t.rise * 0.02
			t.f -= t.f * math.min(1, dt / tauF)
			t.s -= t.s * math.min(1, dt / tauS)
			if math.abs(t.f + t.s) <= 0.002 then
				restore(t)
				active = nil
				Companion.frozen = nil
				return
			end
		end
		apply(t)
	end)
end

return Squish
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--!strict
-- Copia local del perfil que manda el servidor (DataSync) + helper para pedirle cosas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local State = {}

State.data = nil :: any
local listeners: { (any) -> () } = {}
local readyWaiters: { thread } = {}

function State.onChange(fn: (any) -> ())
	table.insert(listeners, fn)
	if State.data then
		task.spawn(fn, State.data)
	end
end

function State.waitReady(): any
	if State.data then
		return State.data
	end
	table.insert(readyWaiters, coroutine.running())
	return coroutine.yield()
end

--- Pide algo al servidor. Devuelve la tabla de respuesta ({ ok = false } si falla la red).
function State.request(action: string, payload: { [string]: any }?): { [string]: any }
	local ok, res = pcall(function()
		return Remotes.func("Request"):InvokeServer(action, payload or {})
	end)
	if ok and type(res) == "table" then
		return res
	end
	return { ok = false, err = "red" }
end

function State.init()
	Remotes.event("DataSync").OnClientEvent:Connect(function(view)
		State.data = view
		for _, th in readyWaiters do
			task.spawn(th, view)
		end
		table.clear(readyWaiters)
		for _, fn in listeners do
			task.spawn(fn, view)
		end
	end)
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Trade</string>
              <string name="Source"><![CDATA[--!strict
-- Intercambios: con NPC (medidor 0.8 / 1.15, "¿y otro?") y con jugadores reales
-- (solicitud → ofertas → Listo → Confirmar; el servidor hace el cambio de una sola vez).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Remotes)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
local Audio = require(script.Parent.Audio)
local Inventory = require(script.Parent.Inventory)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Trade = {}
Trade.roomContent = (nil :: any) :: Frame

local function slotRow(parent: Instance, items: { any }, max: number, order: number, onClick: ((any) -> ())?): Frame
	local row: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 132),
		LayoutOrder = order,
		Parent = parent,
	}, { Kit.list(Enum.FillDirection.Horizontal, 8) })
	for i = 1, max do
		local s = items[i]
		if s then
			local b = Inventory.card(row, s, nil, false)
			b.LayoutOrder = i
			if onClick then
				b.Activated:Connect(function()
					onClick(s)
				end)
			end
		else
			Kit.new("Frame", {
				BackgroundColor3 = Theme.white,
				BackgroundTransparency = 0.4,
				Size = UDim2.fromOffset(104, 128),
				LayoutOrder = i,
				Parent = row,
			}, {
				Kit.corner(14),
				Kit.stroke(Theme.lav2, 2),
				Kit.text("Vacío", 12, {
					TextColor3 = Theme.muted,
					Size = UDim2.fromScale(1, 1),
					TextXAlignment = Enum.TextXAlignment.Center,
				}),
			})
		end
	end
	return row
end

local function pickerGrid(
	parent: Instance,
	d: any,
	chosen: { string },
	max: number,
	onToggle: (string) -> (),
	size: UDim2,
	pos: UDim2
)
	local sc = Modal.scroll(parent, { Size = size, Position = pos })
	Kit.grid(UDim2.fromOffset(104, 128), 6).Parent = sc
	local avail = {}
	for _, s in d.inventory do
		if s.id ~= d.equipped then
			table.insert(avail, s)
		end
	end
	table.sort(avail, function(a, b)
		return a.value > b.value
	end)
	if #avail == 0 then
		Kit.text(
			"No tienes squishies para ofrecer (el equipado se queda contigo).",
			13,
			{ TextColor3 = Theme.muted, Size = UDim2.fromOffset(300, 50), Parent = sc }
		)
	end
	for i, s in avail do
		local b = Inventory.card(sc, s, d, table.find(chosen, s.id) ~= nil)
		b.LayoutOrder = i
		b.Activated:Connect(function()
			if not table.find(chosen, s.id) and #chosen >= max then
				Audio.play("error")
				return
			end
			Audio.play("click")
			onToggle(s.id)
		end)
	end
end

-- ─────────────── NPC ───────────────
local function openNpc(npcName: any)
	local res = State.request("npcTrade", { op = "open", npc = npcName })
	if not res.ok then
		if res.err then
			Toast.show(res.err)
		end
		return
	end
	local st = res
	local mine: { string } = {}
	local content = Modal.open("trade", "Intercambio con " .. tostring(npcName), {
		width = 900,
		height = 600,
		onClose = function()
			State.request("npcTrade", { op = "close" })
		end,
	})
	local msg = "Elige lo que quieres ofrecer."
	local function render()
		local d = State.data
		if Modal.current ~= "trade" or not d then
			return
		end
		Kit.clear(content)
		local left: Frame = Kit.new(
			"Frame",
			{ BackgroundTransparency = 1, Size = UDim2.new(0, 470, 1, 0), Parent = content },
			{ Kit.list(Enum.FillDirection.Vertical, 6) }
		)
		Kit.text(msg, 14, { Font = Theme.bodyBlack, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 36), Parent = left })
		Kit.text(
			"Tu oferta " .. (if st.myVal > 0 then Format.int(st.myVal) .. " 🪙" else ""),
			14,
			{ Font = Theme.display, LayoutOrder = 2, Parent = left }
		)
		local mineItems = {}
		for _, id in mine do
			for _, s in d.inventory do
				if s.id == id then
					table.insert(mineItems, s)
				end
			end
		end
		slotRow(left, mineItems, 3, 3, function(s)
			table.remove(mine, table.find(mine, s.id) or 0)
			st = State.request("npcTrade", { op = "set", ids = mine })
			render()
		end)
		Kit.text(
			tostring(npcName) .. " ofrece " .. (if st.theirVal > 0 then Format.int(st.theirVal) .. " 🪙" else ""),
			14,
			{ Font = Theme.display, LayoutOrder = 4, Parent = left }
		)
		slotRow(left, if st.theirs then { st.theirs } else {}, 1, 5)
		-- medidor
		local ratio = if st.theirVal > 0 then st.myVal / st.theirVal else 0
		local bar: Frame = Kit.new(
			"Frame",
			{ BackgroundColor3 = Theme.lav, Size = UDim2.new(1, -10, 0, 12), LayoutOrder = 6, Parent = left },
			{ Kit.corner(6) }
		)
		Kit.new("Frame", {
			BackgroundColor3 = if ratio >= 1.15
				then Color3.fromHex("#FFC83A")
				elseif ratio >= 0.8 then Theme.mint
				else Color3.fromHex("#ff9aa8"),
			Size = UDim2.fromScale(math.clamp(ratio / 1.5, 0, 1), 1),
			Parent = bar,
		}, { Kit.corner(6) })
		Kit.text(
			if st.theirVal <= 0
				then ""
				elseif ratio >= 1.15 then "Súper trato para ellos: van a decir que sí."
				elseif ratio >= 0.8 then "Cambio justo: seguramente aceptan."
				else "Quieren más. Agrega otro squishy.",
			13,
			{ TextColor3 = Theme.muted, LayoutOrder = 7, Parent = left }
		)
		local btns: Frame = Kit.new(
			"Frame",
			{ BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 44), LayoutOrder = 8, Parent = left },
			{ Kit.list(Enum.FillDirection.Horizontal, 8) }
		)
		local reroll = Kit.button(
			string.format("¿Y otro? (%d)", 3 - st.rerolls),
			Theme.white,
			{ Size = UDim2.new(0.5, -4, 1, 0), Parent = btns }
		)
		local accept = Kit.button("Proponer cambio", Theme.mint, { Size = UDim2.new(0.5, -4, 1, 0), Parent = btns })
		Kit.setEnabled(reroll, #mine > 0 and st.rerolls < 3)
		Kit.setEnabled(accept, #mine > 0 and st.theirs ~= nil)
		reroll.Activated:Connect(function()
			if #mine == 0 or st.rerolls >= 3 then
				return
			end
			local r = State.request("npcTrade", { op = "reroll" })
			if r.ok then
				st = r
				msg = r.msg or msg
				Audio.play("select")
				render()
			end
		end)
		accept.Activated:Connect(function()
			if #mine == 0 or not st.theirs then
				return
			end
			local r = State.request("npcTrade", { op = "accept" })
			if r.ok and r.done then
				Modal.close()
			elseif r.ok then
				st = r
				msg = r.msg or msg
				Audio.play("error")
				render()
			end
		end)
		pickerGrid(content, d, mine, 3, function(id)
			local at = table.find(mine, id)
			if at then
				table.remove(mine, at)
			else
				table.insert(mine, id)
			end
			st = State.request("npcTrade", { op = "set", ids = mine })
			if st.msg then
				msg = st.msg
			end
			render()
		end, UDim2.new(1, -490, 1, 0), UDim2.fromOffset(490, 0))
	end
	render()
end

-- ─────────────── Jugador ↔ jugador ───────────────
local room: any = nil
local myIds: { string } = {}

local function renderRoom()
	local d = State.data
	if not room or not d then
		return
	end
	if Modal.current ~= "tradeRoom" then
		return
	end
	local content = Trade.roomContent
	Kit.clear(content)
	local left: Frame = Kit.new(
		"Frame",
		{ BackgroundTransparency = 1, Size = UDim2.new(0, 470, 1, 0), Parent = content },
		{ Kit.list(Enum.FillDirection.Vertical, 6) }
	)
	local function total(items: { any }): number
		local v = 0
		for _, s in items do
			v += s.value
		end
		return v
	end
	Kit.text(
		string.format(
			"Tú ofreces · %s 🪙 %s",
			Format.int(total(room.me.items)),
			if room.me.confirmed then "✅" elseif room.me.ready then "👍" else ""
		),
		14,
		{ Font = Theme.display, LayoutOrder = 1, Parent = left }
	)
	slotRow(left, room.me.items, 4, 2)
	Kit.text(
		string.format(
			"%s ofrece · %s 🪙 %s",
			room.them.name,
			Format.int(total(room.them.items)),
			if room.them.confirmed then "✅" elseif room.them.ready then "👍" else ""
		),
		14,
		{ Font = Theme.display, LayoutOrder = 3, Parent = left }
	)
	slotRow(left, room.them.items, 4, 4)
	local btns: Frame = Kit.new(
		"Frame",
		{ BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 44), LayoutOrder = 5, Parent = left },
		{ Kit.list(Enum.FillDirection.Horizontal, 8) }
	)
	if room.phase == "confirm" then
		Kit.text(
			"Revisen bien: al confirmar los dos, el cambio es definitivo.",
			13,
			{ TextColor3 = Theme.pinkD, LayoutOrder = 6, Parent = left }
		)
		local c = Kit.button(
			if room.me.confirmed then "Esperando…" else "✅ Confirmar",
			Theme.mint,
			{ Size = UDim2.new(0.5, -4, 1, 0), Parent = btns }
		)
		Kit.setEnabled(c, not room.me.confirmed)
		c.Activated:Connect(function()
			State.request("trade", { op = "confirm" })
		end)
	else
		local r = Kit.button(
			if room.me.ready then "Quitar listo" else "👍 Listo",
			Theme.mint,
			{ Size = UDim2.new(0.5, -4, 1, 0), Parent = btns }
		)
		r.Activated:Connect(function()
			State.request("trade", { op = "ready", v = not room.me.ready })
		end)
	end
	local cancel = Kit.button("Cancelar", Theme.white, { Size = UDim2.new(0.5, -4, 1, 0), Parent = btns })
	cancel.Activated:Connect(function()
		State.request("trade", { op = "cancel" })
	end)
	pickerGrid(content, d, myIds, 6, function(id)
		local at = table.find(myIds, id)
		if at then
			table.remove(myIds, at)
		else
			table.insert(myIds, id)
		end
		State.request("trade", { op = "set", ids = myIds })
	end, UDim2.new(1, -490, 1, 0), UDim2.fromOffset(490, 0))
end

local function openPlayers()
	local content = Modal.open("tradePlayers", "Cambiar con jugadores", { width = 520, height = 480 })
	local sc = Modal.scroll(content)
	Kit.list(Enum.FillDirection.Vertical, 8).Parent = sc
	local others = 0
	for _, p in Players:GetPlayers() do
		if p ~= Players.LocalPlayer then
			others += 1
			local b = Kit.button(
				"🤝  " .. p.DisplayName .. "  <font color='#6d7285'>@" .. p.Name .. "</font>",
				Theme.white,
				{ Size = UDim2.new(1, -8, 0, 46), Parent = sc }
			)
			b.Activated:Connect(function()
				local r = State.request("trade", { op = "request", userId = p.UserId })
				if r.ok then
					Toast.show("Solicitud enviada a " .. p.DisplayName)
					Modal.close()
				elseif r.err then
					Toast.show(r.err)
				end
			end)
		end
	end
	if others == 0 then
		Kit.text(
			"No hay otros jugadores en este servidor. ¡Invita a tus amigos! (o cambia con los NPCs de la Plaza de Intercambio)",
			14,
			{ TextColor3 = Theme.muted, Size = UDim2.new(1, 0, 0, 60), Parent = sc }
		)
	end
end

local function incomingRequest(from: number, name: string)
	Audio.play("npc")
	local card: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.paper,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -60),
		Size = UDim2.fromOffset(320, 110),
		Parent = Kit.root(),
	}, { Kit.corner(18), Kit.stroke(Theme.blue, 3), Kit.pad(12, 10) })
	Kit.text(
		string.format("<b>%s</b> quiere intercambiar contigo 🤝", name),
		15,
		{ Size = UDim2.new(1, 0, 0, 44), Parent = card }
	)
	local yes = Kit.button(
		"Aceptar",
		Theme.mint,
		{ Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(0.5, -4, 0, 40), Parent = card }
	)
	local no = Kit.button(
		"No",
		Theme.white,
		{ Position = UDim2.new(0.5, 4, 1, -40), Size = UDim2.new(0.5, -4, 0, 40), Parent = card }
	)
	local function answer(v: boolean)
		if card.Parent then
			card:Destroy()
			local r = State.request("trade", { op = "respond", userId = from, accept = v })
			if not r.ok and r.err then
				Toast.show(r.err)
			end
		end
	end
	yes.Activated:Connect(function()
		answer(true)
	end)
	no.Activated:Connect(function()
		answer(false)
	end)
	task.delay(20, function()
		if card.Parent then
			answer(false)
		end
	end)
end

function Trade.init()
	Modal.addGuard(function()
		return if room then "Termina o cancela el intercambio primero" else nil
	end)
	Router.register("npcTrade", openNpc)
	Router.register("tradePlayers", openPlayers)
	Remotes.event("TradeEvent").OnClientEvent:Connect(function(ev)
		if ev.t == "request" then
			incomingRequest(ev.from, ev.name)
		elseif ev.t == "state" then
			local first = room == nil
			room = ev
			myIds = {}
			for _, s in ev.me.items do
				table.insert(myIds, s.id)
			end
			if first or Modal.current ~= "tradeRoom" then
				Trade.roomContent = Modal.open("tradeRoom", "Intercambio con " .. ev.them.name, {
					width = 900,
					height = 620,
					onClose = function()
						if room then
							room = nil
							State.request("trade", { op = "cancel" })
						end
					end,
				})
			end
			renderRoom()
		elseif ev.t == "closed" then
			room = nil
			if Modal.current == "tradeRoom" then
				Modal.close()
			end
			if ev.reason and ev.reason ~= "done" then
				Toast.show(ev.reason)
			end
		end
	end)
	State.onChange(function()
		renderRoom()
	end)
end

return Trade
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- Tutorial de 5 pasos (Tut de game5.js) con flecha rosada que guía a la zona.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Toast = require(script.Parent.Parent.UI.Toast)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Tutorial = {}
local guideTarget: Vector3? = nil

local function guideTo(key: string?)
	if not key then
		guideTarget = nil
		return
	end
	local z = (Config.WorldLayout.zones :: any)[key]
	guideTarget = if z then z.center else nil
end
Tutorial.guideTo = guideTo

function Tutorial.init()
	local a = Instance.new("Part")
	a.Name = "GuideArrow"
	a.Shape = Enum.PartType.Ball
	a.Size = Vector3.new(1.6, 1.6, 1.6)
	a.Color = Color3.fromHex("#FF7BB5")
	a.Material = Enum.Material.Neon
	a.Anchored = true
	a.CanCollide = false
	a.CanQuery = false
	a.Transparency = 1
	a.Parent = Workspace
	-- flechita con Beam desde el jugador hasta la zona
	local a0 = Instance.new("Attachment")
	a0.Parent = a
	local beamTarget = Instance.new("Part")
	beamTarget.Anchored = true
	beamTarget.CanCollide = false
	beamTarget.CanQuery = false
	beamTarget.Transparency = 1
	beamTarget.Size = Vector3.one
	beamTarget.Parent = Workspace
	local a1 = Instance.new("Attachment")
	a1.Parent = beamTarget
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(Color3.fromHex("#FF7BB5"))
	beam.Width0 = 1.2
	beam.Width1 = 1.2
	beam.FaceCamera = true
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Static
	beam.TextureSpeed = 1
	beam.Transparency = NumberSequence.new(0.25)
	beam.Enabled = false
	beam.Parent = a

	RunService.RenderStepped:Connect(function()
		local char = Players.LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if guideTarget and root then
			local dist = (Vector3.new(guideTarget.X, root.Position.Y, guideTarget.Z) - root.Position).Magnitude
			if dist < 14 then
				beam.Enabled = false
			else
				beam.Enabled = true
				a.Position = root.Position - Vector3.new(0, 2.6, 0)
				beamTarget.Position = guideTarget + Vector3.new(0, 0.4, 0)
			end
		else
			beam.Enabled = false
		end
	end)

	local shown = -1
	State.onChange(function(d)
		if d.tutorial == shown then
			return
		end
		local prev = shown
		shown = d.tutorial
		local s = d.tutorial
		if s == 0 and prev == -1 then
			Toast.show("¡Bienvenido a Squishy World!", true, 3500)
			task.delay(1.2, function()
				Toast.show(
					"Hagamos tu primer squishy. Sigue la flecha rosada hasta las Máquinas. 🖐️ Por el camino, mantén clic sobre los squishies para apachurrarlos.",
					false,
					5500
				)
			end)
			guideTo("machines")
			State.request("tutorial", { step = 1 })
		elseif s == 1 then
			guideTo("machines")
		elseif s == 3 then
			guideTo(nil)
		elseif s == 5 and prev ~= -1 then
			Toast.show("Tu squishy ya te sigue. ¡Mantén clic encima para apachurrarlo!", false, 4500)
			task.delay(2.8, function()
				Toast.show("Las misiones de la derecha dan monedas. ¡A jugar!")
			end)
			guideTo(nil)
		end
	end)
	Router.register("tutorialEquip", function()
		Toast.show("¡Squishy nuevo! Ahora equípalo.", true, 3200)
		task.delay(1.4, function()
			Toast.show("Abre tu Inventario (I) y presiona Equipar.")
		end)
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="62">
          <Properties>
            <string name="Name">Engine</string>
          </Properties>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">SquishyFactory</string>
              <string name="Source"><![CDATA[--!strict
-- Construye el modelo 3D de un squishy a partir de sus datos (Fase 3, SYSTEMS_SPEC §4 / ASSETS.md).
-- Usa ReplicatedStorage.Models.Squishies.<species> (importado de assets/squishies) y recolorea
-- solo "Body" según la variante. Si el modelo aún no está importado, arma uno provisional.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Config = require(Shared.Config)

local SquishyFactory = {}

-- color base cuando la variante solo trae textura (para el look provisional o sin textura subida)
local TEX_COLOR: { [string]: string } = {
	cotton = "#FFC6E5",
	melon = "#FF6F7D",
	seeds = "#FF6F91",
	strawberry = "#FF6F91",
	drizzle = "#8A5A44",
	galaxy = "#3B2A78",
	lava = "#FF5A1F",
	rainbow = "#FFD36E",
	stars = "#EEF5FF",
	glitch = "#8A5CFF",
	checker = "#E0E0E0",
	sesame = "#E6A95C",
}

export type Look = {
	color: Color3,
	tex: string?,
	material: Enum.Material,
	transparency: number,
	glow: boolean,
	extra: string?,
	topper: string?,
}

function SquishyFactory.look(speciesId: string, variantId: string): Look
	local sp = Catalog.SP[speciesId] or {}
	local v: any = Catalog.VAR[variantId] or {}
	if variantId == "original" and sp.orig then
		v = sp.orig
	end
	local tex = v.tex
	local hexc = v.c or (tex and TEX_COLOR[tex]) or "#F3E3CC"
	local mat = Enum.Material.SmoothPlastic
	if (v.m or 0) >= 0.5 then
		mat = Enum.Material.Foil
	elseif (v.e or 0) >= 0.5 then
		mat = Enum.Material.Neon
	elseif v.opacity then
		mat = Enum.Material.Glass
	end
	return {
		color = Color3.fromHex(hexc),
		tex = tex,
		material = mat,
		transparency = if v.opacity then math.clamp(1 - v.opacity, 0, 0.6) else 0,
		glow = (v.e or 0) > 0,
		extra = v.extra,
		topper = v.topper,
	}
end

local function templateFor(speciesId: string): Model?
	local models = ReplicatedStorage:FindFirstChild("Models")
	local folder = models and models:FindFirstChild("Squishies")
	local m = folder and folder:FindFirstChild(speciesId)
	if m and m:IsA("Model") then
		return m
	end
	return nil
end

-- Esfera que SÍ se puede estirar en un eje (Part.Ball siempre queda redonda)
local function ball(name: string, size: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function placeholder(speciesId: string): Model
	local model = Instance.new("Model")
	model.Name = speciesId
	local sp = Catalog.SP[speciesId] or {}
	local body = ball("Body", if sp.famous then Vector3.new(2.3, 1.6, 2.3) else Vector3.new(2.2, 1.8, 2.2))
	body.Parent = model
	-- carita kawaii
	for _, x in { -0.38, 0.38 } do
		local eye = ball("Part_eye", Vector3.new(0.22, 0.26, 0.22))
		eye.Color = Color3.fromHex("#282D3A")
		eye.CFrame = body.CFrame * CFrame.new(x, 0.12, -body.Size.Z / 2 + 0.12)
		eye.Parent = model
	end
	local blushL = Instance.new("Part")
	blushL.Name = "Part_mouth"
	blushL.Size = Vector3.new(0.3, 0.08, 0.1)
	blushL.Color = Color3.fromHex("#E57AAE")
	blushL.CFrame = body.CFrame * CFrame.new(0, -0.18, -body.Size.Z / 2 + 0.06)
	blushL.Parent = model
	-- orejitas para los animales
	if speciesId == "cat" or speciesId == "bear" or speciesId == "bunny" then
		for _, x in { -0.6, 0.6 } do
			local ear = ball(
				"Part_ear",
				if speciesId == "bunny" then Vector3.new(0.4, 1.1, 0.3) else Vector3.new(0.55, 0.55, 0.4)
			)
			ear.CFrame = body.CFrame * CFrame.new(x, body.Size.Y / 2, 0)
			ear.Parent = model
			ear:SetAttribute("TintWithBody", true)
		end
	end
	model.PrimaryPart = body
	return model
end

local function findBody(model: Model): BasePart?
	local b = model:FindFirstChild("Body", true)
	if b and b:IsA("BasePart") then
		return b
	end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

--- Pinta el Body con el look de la variante.
function SquishyFactory.paint(model: Model, speciesId: string, variantId: string)
	local body = findBody(model)
	if not body then
		return
	end
	local isImported = model:GetAttribute("Imported") == true
	-- los virales 'original' importados ya vienen pintados en el GLB
	if isImported and variantId == "original" then
		return
	end
	local look = SquishyFactory.look(speciesId, variantId)
	body.Color = look.color
	body.Material = look.material
	body.Transparency = look.transparency
	local texId = look.tex and (Config.AssetIds.textures :: any)[look.tex]
	if body:IsA("MeshPart") then
		local mp = body :: MeshPart
		mp.TextureID = if texId and texId ~= "" then texId else ""
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("TintWithBody") then
			d.Color = look.color
			d.Material = look.material
		end
	end
	if look.glow then
		local l = Instance.new("PointLight")
		l.Color = look.color
		l.Range = 6
		l.Brightness = 1.2
		l.Parent = body
	end
	local _, size = model:GetBoundingBox()
	if look.extra == "halo" then
		local halo = Instance.new("Part")
		halo.Name = "Part_halo"
		halo.Shape = Enum.PartType.Cylinder
		halo.Size = Vector3.new(0.12, size.X * 0.55, size.X * 0.55)
		halo.Color = Color3.fromHex("#FFD86B")
		halo.Material = Enum.Material.Neon
		halo.CFrame = model:GetPivot() * CFrame.new(0, size.Y * 0.62, 0) * CFrame.Angles(0, 0, math.rad(90))
		halo.Parent = model
	elseif look.extra == "aura" then
		local h = Instance.new("Highlight")
		h.FillColor = Color3.fromHex("#8A5CFF")
		h.FillTransparency = 0.8
		h.OutlineColor = Color3.fromHex("#B999E8")
		h.Parent = model
	elseif look.extra == "puffs" then
		for i = 1, 3 do
			local puff = Instance.new("Part")
			puff.Name = "Part_puff"
			puff.Shape = Enum.PartType.Ball
			puff.Size = Vector3.one * (0.5 + i * 0.1)
			puff.Color = Color3.new(1, 1, 1)
			local a = i * 2.1
			puff.CFrame = model:GetPivot()
				* CFrame.new(math.cos(a) * size.X * 0.45, -size.Y * 0.3, math.sin(a) * size.Z * 0.45)
			puff.Parent = model
		end
	end
	if look.topper == "leaf" then
		local leaf = Instance.new("Part")
		leaf.Name = "Part_leaf"
		leaf.Size = Vector3.new(0.9, 0.12, 0.5)
		leaf.Color = Color3.fromHex("#5CC46C")
		leaf.CFrame = model:GetPivot() * CFrame.new(0, size.Y * 0.5, 0)
		leaf.Parent = model
	elseif look.topper == "drip" then
		local drip = Instance.new("Part")
		drip.Name = "Part_drip"
		drip.Shape = Enum.PartType.Ball
		drip.Size = Vector3.new(size.X * 0.7, 0.35, size.Z * 0.7)
		drip.Color = Color3.fromHex("#F2B33D")
		drip.Material = Enum.Material.Glass
		drip.CFrame = model:GetPivot() * CFrame.new(0, size.Y * 0.45, 0)
		drip.Parent = model
	end
end

export type BuildData = {
	species: string,
	variant: string,
	mutation: string?,
	size: number?,
	rarity: string?,
}

--- Modelo listo (anclado, sin colisión). scale extra opcional (p. ej. estatua).
function SquishyFactory.build(d: BuildData, extraScale: number?): Model
	local tpl = templateFor(d.species)
	local model: Model
	if tpl then
		model = tpl:Clone()
		model:SetAttribute("Imported", true)
	else
		model = placeholder(d.species)
	end
	model.Name = "Squishy_" .. d.species
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
			p.CastShadow = true
			p.Massless = true
		end
	end
	if not model.PrimaryPart then
		model.PrimaryPart = findBody(model)
	end
	SquishyFactory.paint(model, d.species, d.variant)
	local mut = Catalog.MUT[d.mutation or "normal"]
	local scale = (d.size or 1) * ((mut and mut.size) or 1) * (extraScale or 1)
	if math.abs(scale - 1) > 0.001 then
		model:ScaleTo(scale)
	end
	if d.mutation == "shiny" then
		local body = findBody(model)
		if body then
			local s = Instance.new("Sparkles")
			s.SparkleColor = Color3.fromHex("#FFF3B8")
			s.Parent = body
		end
	end
	model:SetAttribute("Squishy", true)
	return model
end

--- Altura del modelo (para apoyarlo en el piso).
function SquishyFactory.height(model: Model): number
	local _, size = model:GetBoundingBox()
	return size.Y
end

return SquishyFactory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Thumb</string>
              <string name="Source"><![CDATA[--!strict
-- Miniaturas con ViewportFrame (encuadre por medidas del modelo), como Thumbs.get() del prototipo.
local SquishyFactory = require(script.Parent.SquishyFactory)

local Thumb = {}

--- Llena `parent` con un ViewportFrame del squishy. silhouette = "???" del Índice.
function Thumb.make(d: SquishyFactory.BuildData, parent: GuiObject, silhouette: boolean?): ViewportFrame
	local vf = Instance.new("ViewportFrame")
	vf.Name = "Thumb"
	vf.BackgroundTransparency = 1
	vf.Size = UDim2.fromScale(1, 1)
	vf.Ambient = Color3.fromRGB(200, 195, 210)
	vf.LightColor = Color3.new(1, 1, 1)
	vf.LightDirection = Vector3.new(-0.4, -1, -0.6)
	local model = SquishyFactory.build({ species = d.species, variant = d.variant, mutation = "normal", size = 1 })
	model:PivotTo(CFrame.new())
	if silhouette then
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") then
				p.Color = Color3.fromHex("#C9C4D8")
				p.Material = Enum.Material.SmoothPlastic
				if p:IsA("MeshPart") then
					(p :: MeshPart).TextureID = ""
				end
			elseif p:IsA("Light") or p:IsA("Sparkles") or p:IsA("Highlight") then
				p:Destroy()
			end
		end
	end
	model.Parent = vf
	local cf, size = model:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local r = math.max(size.X, size.Y, size.Z)
	local dist = r * 2.1
	local focus = cf.Position
	cam.CFrame = CFrame.lookAt(focus + Vector3.new(dist * 0.25, dist * 0.35, -dist), focus)
	cam.Parent = vf
	vf.CurrentCamera = cam
	vf.Parent = parent
	return vf
end

return Thumb
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="65">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Punto de entrada del cliente.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local State = require(Controllers.State)
local Audio = require(Controllers.Audio)
local Toast = require(UI.Toast)
local Hud = require(Controllers.Hud)
local Dialog = require(Controllers.Dialog)
local Machine = require(Controllers.Machine)
local Reveal = require(Controllers.Reveal)
local Inventory = require(Controllers.Inventory)
local Shop = require(Controllers.Shop)
local Index = require(Controllers.Index)
local Trade = require(Controllers.Trade)
local Interact = require(Controllers.Interact)
local Companion = require(Controllers.Companion)
local Squish = require(Controllers.Squish)
local Tutorial = require(Controllers.Tutorial)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

State.init()
Audio.init()
Toast.init()
Hud.init()
Dialog.init()
Machine.init()
Reveal.init()
Inventory.init()
Shop.init()
Index.init()
Trade.init()
Companion.init()
Squish.init()
Tutorial.init()
task.spawn(Interact.init)

print("[Squishy World] Cliente listo —", #Config.Species, "moldes cargados")
-- TODO Fase 7: manos que rodean el contorno + EditableMesh (DeformEngine), apuntar, fantasma
-- TODO Fase 8–10: Estudio Squish, Cera de vela, Tour de bienvenida
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="66">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Kit</string>
              <string name="Source"><![CDATA[--!strict
-- Mini librería de UI por código (el prototipo arma su UI con HTML; aquí con Instances).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Kit = {}

export type Props = { [string]: any }

--- Kit.new("Frame", { Size = …, [Kit.children] = {…} })
function Kit.new(className: string, props: Props?, children: { any }?): any
	local inst: any = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, ch in children do
			ch.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Kit.corner(r: number): any
	return Kit.new("UICorner", { CornerRadius = UDim.new(0, r) })
end

function Kit.stroke(col: Color3, t: number?): any
	return Kit.new("UIStroke", { Color = col, Thickness = t or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function Kit.pad(px: number, py: number?): any
	local y = py or px
	return Kit.new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, y),
		PaddingBottom = UDim.new(0, y),
	})
end

function Kit.list(dir: Enum.FillDirection?, gap: number?, align: Enum.HorizontalAlignment?): any
	return Kit.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
	})
end

function Kit.grid(cell: UDim2, gap: number?): any
	return Kit.new("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(gap or 8, gap or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Kit.text(text: string, size: number, props: Props?): TextLabel
	local p: Props = {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		Font = Theme.body,
		TextColor3 = Theme.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		RichText = true,
		Size = UDim2.new(1, 0, 0, size + 6),
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	return Kit.new("TextLabel", p)
end

--- Botón redondeado con "sombra" abajo como .btn del prototipo.
function Kit.button(text: string, color: Color3?, props: Props?): TextButton
	local col = color or Theme.white
	local dark = col == Theme.white
	local p: Props = {
		AutoButtonColor = true,
		BackgroundColor3 = col,
		Text = text,
		TextSize = 16,
		Font = Theme.bodyBlack,
		TextColor3 = if dark or col == Theme.yellow or col == Theme.mint then Theme.ink else Theme.white,
		Size = UDim2.new(1, 0, 0, 40),
		RichText = true,
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	local b: TextButton = Kit.new("TextButton", p, {
		Kit.corner(12),
		Kit.new("UIStroke", {
			Color = if dark then Theme.lav2 else Theme.dark(col),
			Thickness = 2,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
	})
	return b
end

function Kit.setEnabled(b: GuiButton, on: boolean)
	b.Active = on
	b.AutoButtonColor = on
	local tb = b :: any
	tb.BackgroundTransparency = if on then 0 else 0.45
	if b:IsA("TextButton") then
		(b :: TextButton).TextTransparency = if on then 0 else 0.4
	end
end

function Kit.clear(parent: Instance)
	for _, ch in parent:GetChildren() do
		if not ch:IsA("UIGridStyleLayout") and not ch:IsA("UIPadding") and not ch:IsA("UICorner") then
			ch:Destroy()
		end
	end
end

function Kit.tween(inst: Instance, t: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local tw =
		TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

local gui: ScreenGui? = nil
function Kit.root(): ScreenGui
	if gui then
		return gui
	end
	local g: ScreenGui = Kit.new("ScreenGui", {
		Name = "SquishyUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	gui = g
	return g
end

return Kit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">Modal</string>
              <string name="Source"><![CDATA[--!strict
-- Ventanas (overlays) del prototipo: una a la vez, con título y botón de cerrar.
local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local Modal = {}
Modal.current = nil :: string?

local frame: Frame? = nil
local fitConn: RBXScriptConnection? = nil
local onCloseFn: (() -> ())? = nil
local changed: { (string?) -> () } = {}

function Modal.onChange(fn: (string?) -> ())
	table.insert(changed, fn)
end

--- Si algo en curso no se puede interrumpir (un intercambio, un llenado), devuelve el motivo.
local guards: { () -> string? } = {}
function Modal.addGuard(fn: () -> string?)
	table.insert(guards, fn)
end
function Modal.blocked(): string?
	for _, g in guards do
		local why = g()
		if why then
			return why
		end
	end
	return nil
end

function Modal.close()
	if fitConn then
		fitConn:Disconnect()
		fitConn = nil
	end
	if frame then
		frame:Destroy()
		frame = nil
	end
	local cb = onCloseFn
	onCloseFn = nil
	Modal.current = nil
	if cb then
		cb()
	end
	for _, fn in changed do
		task.spawn(fn, nil)
	end
end

export type Opts = { width: number?, height: number?, anchor: Vector2?, position: UDim2?, onClose: (() -> ())? }

--- Abre una ventana y devuelve el contenedor de contenido (con scroll opcional por el llamador).
function Modal.open(key: string, title: string, opts: Opts?): (Frame, TextLabel)
	Modal.close()
	local o: Opts = opts or {}
	local w, h = o.width or 760, o.height or 520
	local f: Frame = Kit.new("Frame", {
		Name = "Modal_" .. key,
		AnchorPoint = o.anchor or Vector2.new(0.5, 0.5),
		Position = o.position or UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = Theme.paper,
		ZIndex = 20,
		Parent = Kit.root(),
	}, {
		Kit.corner(22),
		Kit.stroke(Theme.lav2, 3),
		Kit.new("UISizeConstraint", { MaxSize = Vector2.new(w, h) }),
	})
	-- en pantallas chicas (celular) que no se salga
	local scaler = Instance.new("UIScale")
	scaler.Parent = f
	local function fit()
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		scaler.Scale = math.min(1, (vp.X - 20) / w, (vp.Y - 60) / h)
	end
	fit()
	if workspace.CurrentCamera then
		fitConn = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end

	local titleLabel: TextLabel = Kit.text(title, 28, {
		Font = Theme.display,
		Position = UDim2.fromOffset(22, 14),
		Size = UDim2.new(1, -80, 0, 34),
		ZIndex = 21,
		Parent = f,
	})
	local x = Kit.button("✕", Theme.white, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 12),
		Size = UDim2.fromOffset(38, 38),
		TextSize = 18,
		ZIndex = 22,
		Parent = f,
	})
	x.Activated:Connect(Modal.close)
	local content: Frame = Kit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(18, 58),
		Size = UDim2.new(1, -36, 1, -72),
		ZIndex = 21,
		Parent = f,
	})
	frame = f
	onCloseFn = o.onClose
	Modal.current = key
	for _, fn in changed do
		task.spawn(fn, key)
	end
	return content, titleLabel
end

--- Contenedor con scroll vertical automático.
function Modal.scroll(parent: Instance, props: { [string]: any }?): ScrollingFrame
	local p: { [string]: any } = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.lav2,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 21,
		Parent = parent,
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	return Kit.new("ScrollingFrame", p)
end

return Modal
]]></string>
