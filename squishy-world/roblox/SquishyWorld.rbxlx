          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Audio</string>
              <string name="Source"><![CDATA[--!strict
-- Sonidos (SFX.map del prototipo → Config.AssetIds.sounds). Si un id está vacío, no suena y ya.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local State = require(script.Parent.State)

local Audio = {}
local cache: { [string]: Sound } = {}
Audio.muted = false
local mutedListeners: { (boolean) -> () } = {}

function Audio.onMuted(fn: (boolean) -> ())
	table.insert(mutedListeners, fn)
end

--- Silenciar/activar (se guarda en el perfil como S.muted del original).
function Audio.setMuted(m: boolean, fromServer: boolean?)
	Audio.muted = m
	for _, s in cache do
		if m then
			s:Stop()
		end
	end
	for _, fn in mutedListeners do
		task.spawn(fn, m)
	end
	if not fromServer then
		task.spawn(State.request, "setMuted", { v = m })
	end
end

local function get(name: string): Sound?
	local id = (Config.AssetIds.sounds :: any)[name]
	if not id or id == "" then
		return nil
	end
	local cached = cache[name]
	if cached then
		return cached
	end
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = id
	s.Volume = 0.6
	s.Parent = SoundService
	cache[name] = s
	return s
end

function Audio.play(name: string, pitch: number?, volume: number?)
	if Audio.muted then
		return
	end
	local s = get(name)
	if s then
		s.PlaybackSpeed = pitch or 1
		s.Volume = volume or 0.6
		SoundService:PlayLocalSound(s)
	end
end

--- Loop (p. ej. llenado). Devuelve el Sound para cambiarle volumen/tono en vivo.
function Audio.loop(name: string, on: boolean): Sound?
	local s = get(name)
	if not s then
		return nil
	end
	s.Looped = true
	if on and not Audio.muted then
		if not s.IsPlaying then
			s:Play()
		end
	else
		s:Stop()
	end
	return s
end

function Audio.init()
	Remotes.event("Notify").OnClientEvent:Connect(function(msg)
		if type(msg) == "table" and msg.t == "sound" then
			Audio.play(msg.name)
		end
	end)
end

return Audio
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">AvatarHands</string>
              <string name="Source"><![CDATA[--!strict
-- Manos de Roblox: cuando apachurras un squishy, los brazos de TU avatar (R15) lo agarran con
-- IKControl. Las manos se pegan a los lados del squishy (vistos desde tu personaje) y se van
-- hundiendo con él. Reemplaza las manitos kawaii del prototipo (pedido de Yeison).
-- Si el squishy está lejos, el personaje camina hasta quedar a la distancia de los brazos.
-- Con avatar R6 (sin IK) se apachurra igual, solo que sin brazos.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local AvatarHands = {}

local REACH = 3.2 -- distancia a la que se para frente al squishy

type Rig = {
	left: IKControl,
	right: IKControl,
	tl: Attachment,
	tr: Attachment,
	holder: Part,
	weight: number,
}

local rig: Rig? = nil
local target: Model? = nil
local walking = false

local function character(): (Model?, Humanoid?, BasePart?)
	local char = Players.LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not hum or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return char, hum, root
end

local function build(char: Model, hum: Humanoid): Rig?
	if hum.RigType ~= Enum.HumanoidRigType.R15 then
		return nil
	end
	local function part(name: string): BasePart?
		local p = char:FindFirstChild(name)
		return if p and p:IsA("BasePart") then p else nil
	end
	local lu, lh, ru, rh = part("LeftUpperArm"), part("LeftHand"), part("RightUpperArm"), part("RightHand")
	if not (lu and lh and ru and rh) then
		return nil
	end
	local holder = Instance.new("Part")
	holder.Name = "SquishHandTargets"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.one * 0.2
	holder.Parent = Workspace
	local tl = Instance.new("Attachment")
	tl.Parent = holder
	local tr = Instance.new("Attachment")
	tr.Parent = holder
	local function ik(chainRoot: BasePart, hand: BasePart, t: Attachment): IKControl
		local c = Instance.new("IKControl")
		c.Type = Enum.IKControlType.Position
		c.ChainRoot = chainRoot
		c.EndEffector = hand
		c.Target = t
		c.Weight = 0
		c.SmoothTime = 0.08
		c.Parent = hum
		return c
	end
	return {
		left = ik(lu, lh, tl),
		right = ik(ru, rh, tr),
		tl = tl,
		tr = tr,
		holder = holder,
		weight = 0,
	}
end

local function destroyRig()
	local r = rig
	if r then
		r.left:Destroy()
		r.right:Destroy()
		r.holder:Destroy()
		rig = nil
	end
end

--- Empieza a agarrar `model`. Si está lejos, camina hasta él.
function AvatarHands.grab(model: Model)
	local char, hum, root = character()
	if not char or not hum or not root then
		return
	end
	target = model
	if not rig or not rig.left.Parent then
		destroyRig()
		rig = build(char, hum)
	end
	local pos = model:GetPivot().Position
	local flat = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
	if flat.Magnitude > REACH + 1.2 and not walking then
		walking = true
		hum:MoveTo(pos - flat.Unit * REACH)
		task.spawn(function()
			hum.MoveToFinished:Wait()
			walking = false
		end)
	end
end

function AvatarHands.release()
	target = nil
end

--- k = cuánto está hundido (0..~0.45). Se llama cada frame desde Squish.
function AvatarHands.update(dt: number, k: number)
	local char, hum, root = character()
	local r = rig
	if not r then
		return
	end
	if not char or not hum or not root then
		destroyRig()
		return
	end
	local m = target
	local want = 0
	if m and m.Parent then
		local cf, size = m:GetBoundingBox()
		local toSq = Vector3.new(cf.X - root.Position.X, 0, cf.Z - root.Position.Z)
		local dist = toSq.Magnitude
		if dist < REACH + 2.5 then
			want = 1
			-- mirar al squishy
			if dist > 0.3 and not walking then
				local look = root.Position + toSq.Unit
				root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, look), math.min(1, dt * 10))
			end
			-- lados del squishy vistos desde el personaje; se meten hacia adentro al apretar
			local fwd = if dist > 0.01 then toSq.Unit else root.CFrame.LookVector
			local side = fwd:Cross(Vector3.yAxis).Unit
			local half = math.max(size.X, size.Z) * 0.5 * (1 + k * 0.62)
			local squeeze = half * (0.95 - k * 0.5)
			local y = cf.Y + size.Y * (0.1 - k * 0.3)
			local center = Vector3.new(cf.X, y, cf.Z) - fwd * 0.15
			r.holder.CFrame = CFrame.new(center)
			r.tl.WorldPosition = center + side * squeeze
			r.tr.WorldPosition = center - side * squeeze
		end
	end
	r.weight += (want - r.weight) * math.min(1, dt * 8)
	r.left.Weight = r.weight
	r.right.Weight = r.weight
	if want == 0 and r.weight < 0.02 then
		destroyRig()
	end
end

return AvatarHands
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Companion</string>
              <string name="Source"><![CDATA[--!strict
-- Compañeros: el squishy equipado de CADA jugador y de cada NPC lo sigue con saltito y
-- respiración (squash idle). El servidor solo publica el atributo "Companion" (JSON); cada
-- cliente lo dibuja localmente (barato y suave, sin replicar CFrames).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Damp = require(ReplicatedStorage.Shared.Util.Damp)
local SquishyFactory = require(script.Parent.Parent.Engine.SquishyFactory)

local Companion = {}

type Entry = {
	owner: Instance, -- Player o Model (NPC)
	json: string,
	model: Model,
	pos: Vector3,
	yaw: number,
	t: number,
	height: number,
	lift: number, -- distancia del pivote a la base del modelo
	ownerName: string,
	npc: string?,
}

local entries: { [Instance]: Entry } = {}
local folder: Folder

local OFFSET = Config.Game.COMPANION.offset
local LERP = Config.Game.COMPANION.lerp

local function ownerRoot(owner: Instance): BasePart?
	local char: Instance? = if owner:IsA("Player") then owner.Character else owner
	local r = char and char:FindFirstChild("HumanoidRootPart")
	return if r and r:IsA("BasePart") then r else nil
end

local function build(owner: Instance, json: string)
	local old = entries[owner]
	if old then
		old.model:Destroy()
		entries[owner] = nil
	end
	if json == "" then
		return
	end
	local ok, d = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	if not ok or type(d) ~= "table" then
		return
	end
	local model = SquishyFactory.build(d)
	model:SetAttribute("CompanionName", d.name)
	model:SetAttribute("OwnerName", if owner:IsA("Player") then owner.DisplayName else owner.Name)
	if not owner:IsA("Player") then
		model:SetAttribute("NpcOwner", owner.Name)
	end
	model.Parent = folder
	local root = ownerRoot(owner)
	local start = if root then root.Position else Vector3.zero
	entries[owner] = {
		owner = owner,
		json = json,
		model = model,
		pos = start,
		yaw = 0,
		t = math.random() * 10,
		height = SquishyFactory.height(model),
		lift = (function()
			local cf, size = model:GetBoundingBox()
			return model:GetPivot().Y - (cf.Y - size.Y / 2)
		end)(),
		ownerName = model:GetAttribute("OwnerName") :: string,
		npc = if owner:IsA("Player") then nil else owner.Name,
	}
end

local function watch(owner: Instance)
	local function refresh()
		local v = owner:GetAttribute("Companion")
		build(owner, if type(v) == "string" then v else "")
	end
	owner:GetAttributeChangedSignal("Companion"):Connect(refresh)
	refresh()
end

--- Squishy que alguien está apachurrando: se queda quieto (lo pone Squish.luau).
Companion.frozen = nil :: Model?

function Companion.all(): { [Instance]: Entry }
	return entries
end

function Companion.init()
	folder = Instance.new("Folder")
	folder.Name = "Companions"
	folder.Parent = Workspace

	for _, p in Players:GetPlayers() do
		watch(p)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(p)
		build(p, "")
	end)
	local npcs = Workspace:WaitForChild("NPCs", 30)
	if npcs then
		for _, m in npcs:GetChildren() do
			watch(m)
		end
		npcs.ChildAdded:Connect(watch)
		npcs.ChildRemoved:Connect(function(m)
			build(m, "")
		end)
	end

	RunService.RenderStepped:Connect(function(dt)
		for owner, e in entries do
			local root = ownerRoot(owner)
			if root and e.model.Parent then
				e.t += dt
				if Companion.frozen ~= e.model then
					local back = root.CFrame * CFrame.new(OFFSET * 0.55, 0, OFFSET)
					local target = Vector3.new(back.X, root.Position.Y - 3, back.Z)
					local moving = (target - e.pos).Magnitude > 0.4
					e.pos = Damp.vector(e.pos, target, LERP, dt)
					local _, ry, _ = root.CFrame:ToOrientation()
					-- girar por el camino corto (ToOrientation salta en ±π)
					local diff = (ry - e.yaw + math.pi) % (2 * math.pi) - math.pi
					e.yaw += diff * (1 - math.exp(-6 * dt))
					local hop = if moving then math.abs(math.sin(e.t * 9)) * 0.45 else 0
					local breathe = 1 + math.sin(e.t * 2.4) * 0.03
					e.model:PivotTo(
						CFrame.new(e.pos + Vector3.new(0, e.lift * breathe + hop, 0)) * CFrame.Angles(0, e.yaw, 0)
					)
				end
			end
		end
	end)
end

return Companion
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Controls</string>
              <string name="Source"><![CDATA[--!strict
-- Movimiento y cámara como el original (game1.js CONFIG.PLAYER / CONFIG.CAM):
-- caminar 13, Shift = correr 22, sin salto; cámara FOV 58, distancia 14 (zoom 7–24).
-- Velocidad base, salto y zoom min/max están en default.project.json (StarterPlayer).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local Controls = {}

local P = Config.Game.PLAYER
local C = Config.Game.CAM
local FOV = 58

local running = false

local function humanoid(): Humanoid?
	local char = Players.LocalPlayer.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function applySpeed()
	local h = humanoid()
	if h then
		h.WalkSpeed = if running then P.run else P.walk
	end
end

local function onCharacter(char: Model)
	local h = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not h then
		return
	end
	h.UseJumpPower = false
	h.JumpHeight = 0
	h:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	applySpeed()
	-- empezar a la distancia del original (14): forzar el zoom un instante
	local lp = Players.LocalPlayer
	lp.CameraMinZoomDistance = C.dist
	lp.CameraMaxZoomDistance = C.dist
	task.delay(0.2, function()
		lp.CameraMinZoomDistance = C.min
		lp.CameraMaxZoomDistance = C.max
	end)
end

function Controls.init()
	local cam = Workspace.CurrentCamera
	if cam then
		cam.FieldOfView = FOV
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		if Workspace.CurrentCamera then
			Workspace.CurrentCamera.FieldOfView = FOV
		end
	end)
	local lp = Players.LocalPlayer
	if lp.Character then
		task.spawn(onCharacter, lp.Character)
	end
	lp.CharacterAdded:Connect(onCharacter)
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			running = true
			applySpeed()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
			running = false
			applySpeed()
		end
	end)
end

return Controls
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Dialog</string>
              <string name="Source"><![CDATA[--!strict
-- Confirmaciones (el confirm() del navegador en el prototipo).
local Kit = require(script.Parent.Parent.UI.Kit)
local Theme = require(script.Parent.Parent.UI.Theme)
local Router = require(script.Parent.Router)

local Dialog = {}

function Dialog.confirm(text: string, yes: () -> ())
	local shade: Frame = Kit.new("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		Size = UDim2.fromScale(1, 1),
		Active = true,
		ZIndex = 60,
		Parent = Kit.root("dialog"),
	})
	local box: Frame = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(420, 190),
		BackgroundColor3 = Theme.paper,
		Parent = shade,
	}, { Kit.corner(20), Kit.pad(18, 16) })
	Kit.text(text, 16, { Size = UDim2.new(1, 0, 1, -56), TextYAlignment = Enum.TextYAlignment.Top, Parent = box })
	local ok = Kit.button(
		"Sí",
		Theme.mint,
		{ Position = UDim2.new(0, 0, 1, -44), Size = UDim2.new(0.5, -5, 0, 44), Parent = box }
	)
	local no = Kit.button(
		"Cancelar",
		Theme.white,
		{ Position = UDim2.new(0.5, 5, 1, -44), Size = UDim2.new(0.5, -5, 0, 44), Parent = box }
	)
	ok.Activated:Connect(function()
		shade:Destroy()
		yes()
	end)
	no.Activated:Connect(function()
		shade:Destroy()
	end)
end

function Dialog.init()
	Router.register("confirm", function(arg)
		Dialog.confirm(arg.text, arg.yes)
	end)
end

return Dialog
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- HUD (#hud de template.html): logo arriba a la izquierda, #stats (monedas, nivel+XP, sonido)
-- arriba a la derecha en píldoras oscuras, #sideMenu con los íconos del juego, #questCard,
-- #helpBar abajo a la izquierda. Teclas: I, C, B, T, Esc (game4.js keydown).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Quests = require(Shared.Logic.Quests)
local Squishy = require(Shared.Logic.Squishy)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)
local Tutorial = require(script.Parent.Tutorial)

local Hud = {}
Hud.sideButtons = {} :: { [string]: any }

local PILL_BG = Theme.ink
local PILL_T = 0.18

local function pill(parent: Instance, order: number): Frame
	return Kit.new("Frame", {
		BackgroundColor3 = PILL_BG,
		BackgroundTransparency = PILL_T,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		LayoutOrder = order,
		Parent = parent,
	}, { Kit.corner(16), Kit.pad(14, 8) })
end

--- Anillo rosado que late (.side.pulse) sobre un botón.
function Hud.pulse(key: string, on: boolean)
	local b = Hud.sideButtons[key]
	if not b then
		return
	end
	local old = b:FindFirstChild("_Pulse")
	if old then
		old:Destroy()
	end
	if not on then
		return
	end
	local ring = Kit.new("UIStroke", {
		Name = "_Pulse",
		Color = Theme.pink,
		Thickness = 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = b,
	})
	task.spawn(function()
		while ring.Parent do
			ring.Thickness = 0
			ring.Transparency = 0.1
			Kit.tween(ring, 1.1, { Thickness = 10, Transparency = 1 })
			task.wait(1.1)
		end
	end)
end

local function sideAction(key: string)
	if key == "trade" then
		Tutorial.guideTo("trading")
		Toast.show("Sigue la flecha hasta la Plaza de Intercambio")
	elseif key == "tour" then
		Router.open("tour")
	else
		Router.open(key)
	end
end

function Hud.init()
	-- el chat de Roblox va abajo a la derecha (esa esquina está libre en el original)
	pcall(function()
		local cfg = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
		if cfg then
			cfg.HorizontalAlignment = Enum.HorizontalAlignment.Right
			cfg.VerticalAlignment = Enum.VerticalAlignment.Bottom
		end
	end)

	local root = Kit.root()
	local frame: Frame = Kit.new("Frame", {
		Name = "Hud",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = root,
	})
	Hud.frame = frame

	-- #logo: Lilita 22 blanco con sombra rosada 0 3px 0 #E57AAE
	local logo = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(20, 18),
		Size = UDim2.fromOffset(200, 30),
		Parent = frame,
	})
	Kit.text("Squishy World", 22, {
		FontFace = Theme.display,
		TextColor3 = Theme.pinkD,
		Position = UDim2.fromOffset(0, 3),
		TextWrapped = false,
		Parent = logo,
	})
	Kit.text(
		"Squishy World",
		22,
		{ FontFace = Theme.display, TextColor3 = Theme.white, TextWrapped = false, Parent = logo }
	)

	-- #stats: monedas, nivel, sonido (arriba a la derecha)
	local stats: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		Size = UDim2.fromOffset(600, 46),
		Parent = frame,
	})
	local sl = Kit.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right)
	sl.VerticalAlignment = Enum.VerticalAlignment.Center
	sl.Parent = stats

	local boostPill = pill(stats, 0)
	local boost = Kit.text("", 15, {
		FontFace = Theme.bodyBlack,
		TextColor3 = Theme.white,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 22),
		TextWrapped = false,
		Parent = boostPill,
	})
	boostPill.Visible = false

	local coinPill = pill(stats, 1)
	local cl = Kit.list(Enum.FillDirection.Horizontal, 8)
	cl.VerticalAlignment = Enum.VerticalAlignment.Center
	cl.Parent = coinPill
	Kit.coin(22, { LayoutOrder = 1, Parent = coinPill })
	local coins = Kit.text("0", 17, {
		FontFace = Theme.bodyBlack,
		TextColor3 = Theme.white,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 22),
		TextWrapped = false,
		LayoutOrder = 2,
		Parent = coinPill,
	})

	local lvlPill = pill(stats, 2)
	local lvlCol: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(130, 30),
		Parent = lvlPill,
	})
	local lvl = Kit.text("Nivel 1", 14, {
		FontFace = Theme.bodyBlack,
		TextColor3 = Theme.white,
		Size = UDim2.fromOffset(70, 16),
		Parent = lvlCol,
	})
	local xpTxt = Kit.text("0/50 XP", 12, {
		FontFace = Theme.bodyBlack,
		TextColor3 = Theme.white,
		TextTransparency = 0.3,
		TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.new(1, 0, 0, 16),
		Parent = lvlCol,
	})
	local xpBar: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.white,
		BackgroundTransparency = 0.82,
		Position = UDim2.fromOffset(0, 21),
		Size = UDim2.new(1, 0, 0, 7),
		Parent = lvlCol,
	}, { Kit.corner(5) })
	local xpFill: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.white,
		Size = UDim2.fromScale(0, 1),
		Parent = xpBar,
	}, {
		Kit.corner(5),
		Kit.new("UIGradient", { Color = ColorSequence.new(Theme.mint, Theme.blue) }),
	})

	-- .iconBtn 40x40 🔊/🔇
	local muteBtn = Kit.button(
		"🔊",
		Theme.paper,
		{ Size = UDim2.fromOffset(40, 40), TextSize = 18, LayoutOrder = 3, Parent = stats }
	);
	(muteBtn:FindFirstChildOfClass("UICorner") :: UICorner).CornerRadius = UDim.new(0, 13)
	muteBtn.Activated:Connect(function()
		Audio.setMuted(not Audio.muted)
	end)
	Audio.onMuted(function(m)
		muteBtn.Text = if m then "🔇" else "🔊"
	end)

	-- #sideMenu: fondo paper igual para todos, ícono 30x30 + etiqueta 11px, atajo en la esquina
	local side: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(74, 480),
		Parent = frame,
	}, { Kit.list(Enum.FillDirection.Vertical, 10) });
	(side:FindFirstChildOfClass("UIListLayout") :: UIListLayout).VerticalAlignment = Enum.VerticalAlignment.Center
	local menu: { { any } } = {
		{ "inv", "Inventario", "inventory", "I", "🎒" },
		{ "col", "Colección", "index", "C", "📖" },
		{ "shop", "Tienda", "shop", "B", "🛒" },
		{ "tour", "Tour", "tour", "🎬", "🎬" },
		{ "trade", "Cambios", "trade", "T", "🤝" },
		{ "", "Robux", "robux", "", "⭐" }, -- extra: monetización (no está en el original)
	}
	for i, m in menu do
		local b = Kit.button("", Theme.paper, { Size = UDim2.fromOffset(74, 70), LayoutOrder = i, Parent = side });
		(b:FindFirstChildOfClass("UICorner") :: UICorner).CornerRadius = UDim.new(0, 20)
		Kit.shadow(b, Color3.fromRGB(207, 208, 214), 5, 20)
		b.BackgroundTransparency = 0.08
		local iconId = (Config.AssetIds.icons :: any)[m[1]]
		if iconId and iconId ~= "" then
			Kit.new("ImageLabel", {
				BackgroundTransparency = 1,
				Image = iconId,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 10),
				Size = UDim2.fromOffset(30, 30),
				Parent = b,
			})
		else
			Kit.text(m[5], 24, {
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.fromOffset(0, 8),
				Size = UDim2.new(1, 0, 0, 30),
				Parent = b,
			})
		end
		Kit.text(m[2], 11, {
			FontFace = Theme.bodyBlack,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.new(0, 0, 1, -24),
			Size = UDim2.new(1, 0, 0, 14),
			Parent = b,
		})
		if m[4] ~= "" then
			Kit.text(m[4], 10, {
				FontFace = Theme.bodyBlack,
				TextTransparency = 0.55,
				TextXAlignment = Enum.TextXAlignment.Right,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -6, 0, 4),
				Size = UDim2.fromOffset(20, 12),
				Parent = b,
			})
		end
		b.Activated:Connect(function()
			if Modal.current then
				return -- como el original: solo si no hay ventana abierta
			end
			Audio.play("click")
			sideAction(m[3])
		end)
		Hud.sideButtons[m[3]] = b
	end

	Router.register("hudPulse", function(arg)
		Hud.pulse(arg.key, arg.on)
	end)

	-- #questCard (right 16, top 92, ancho 250)
	local quest: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.paper,
		BackgroundTransparency = 0.07,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 76),
		Size = UDim2.fromOffset(250, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = frame,
	}, { Kit.corner(18), Kit.list(Enum.FillDirection.Vertical, 4) })
	Kit.new("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 13),
		Parent = quest,
	})
	Kit.shadow(quest, Color3.fromRGB(207, 208, 214), 5, 18)
	Kit.text("Misión", 15, { FontFace = Theme.display, TextColor3 = Theme.purpleD, LayoutOrder = 1, Parent = quest })
	local qTitle = Kit.text("", 15, {
		FontFace = Theme.bodyBlack,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2,
		Parent = quest,
	})
	local qBar: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.lav,
		Size = UDim2.new(1, 0, 0, 9),
		LayoutOrder = 3,
		Parent = quest,
	}, { Kit.corner(6) })
	local qFill: Frame = Kit.new(
		"Frame",
		{ BackgroundColor3 = Theme.mint, Size = UDim2.fromScale(0, 1), Parent = qBar },
		{ Kit.corner(6) }
	)
	local meta: Frame =
		Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 4, Parent = quest })
	local qProg = Kit.text("", 12, { TextColor3 = Theme.muted, Size = UDim2.fromScale(0.4, 1), Parent = meta })
	local qReward = Kit.text("", 12, {
		TextColor3 = Theme.muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(0.6, 1),
		Parent = meta,
	})
	local guideBtn = Kit.button(
		"Muéstrame",
		Theme.lav,
		{ Size = UDim2.fromOffset(110, 30), LayoutOrder = 5, Parent = quest },
		"small"
	)
	local currentTarget: string? = nil
	guideBtn.Activated:Connect(function()
		if currentTarget then
			Audio.play("click")
			Tutorial.guideTo(currentTarget)
		end
	end)

	-- #helpBar (abajo a la izquierda)
	local help: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.paper,
		BackgroundTransparency = 0.3,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -14),
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		Parent = frame,
	}, { Kit.corner(10), Kit.pad(10, 5) })
	Kit.text(
		"WASD moverse · Shift correr · Mouse / ← → cámara · E interactuar · Clic sostenido = apachurrar",
		12,
		{
			TextColor3 = Theme.ink,
			TextTransparency = 0.3,
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 0),
			TextWrapped = false,
			Parent = help,
		}
	)

	local lastCoins: number? = nil
	State.onChange(function(d)
		coins.Text = Format.int(d.coins)
		if lastCoins and d.coins ~= lastCoins then
			local sc = coinPill:FindFirstChildOfClass("UIScale") or Kit.new("UIScale", { Parent = coinPill })
			sc.Scale = 1.12
			Kit.tween(sc, 0.35, { Scale = 1 })
		end
		lastCoins = d.coins
		lvl.Text = "Nivel " .. d.level
		local need = Squishy.xpNeed(d.level)
		xpTxt.Text = string.format("%d/%d XP", d.xp, need)
		Kit.tween(xpFill, 0.4, { Size = UDim2.fromScale(math.clamp(d.xp / need, 0, 1), 1) })
		local q = Quests.current(d.quest.i)
		local p = math.min(d.quest.p, q.goal)
		qTitle.Text = q.title
		Kit.tween(qFill, 0.3, { Size = UDim2.fromScale(p / q.goal, 1) })
		qProg.Text = string.format("%d / %d", p, q.goal)
		qReward.Text = string.format("Premio: %s monedas", Format.int(q.reward))
		currentTarget = q.target
		guideBtn.Visible = q.target ~= nil
		if d.muted ~= nil and d.muted ~= Audio.muted then
			Audio.setMuted(d.muted, true)
		end
	end)

	-- teclas del original (solo si no hay ventana abierta); Esc cierra la ventana
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp or UserInputService:GetFocusedTextBox() then
			return
		end
		local k = input.KeyCode
		if k == Enum.KeyCode.Escape then
			if Modal.current and not Modal.blocked() then
				Modal.close()
			end
			return
		end
		if Modal.current then
			return
		end
		if k == Enum.KeyCode.I then
			Router.open("inventory")
		elseif k == Enum.KeyCode.C then
			Router.open("index")
		elseif k == Enum.KeyCode.B then
			Router.open("shop")
		elseif k == Enum.KeyCode.T then
			Tutorial.guideTo("trading")
			Toast.show("Ve a la Plaza de Intercambio")
		end
	end)

	-- Poción de suerte / Molde de Oro / VIP (extra de monetización)
	task.spawn(function()
		while true do
			local d = State.data
			if d then
				local left = (d.luckLeft or 0) - (os.time() - (d.serverTime or os.time()))
				local parts = {}
				if left > 0 then
					table.insert(parts, string.format("🍀 %d:%02d", left // 60, left % 60))
				end
				if (d.legendFills or 0) > 0 then
					table.insert(parts, "🌟 x" .. d.legendFills)
				end
				if d.passes and d.passes.vip then
					table.insert(parts, "👑 VIP")
				end
				boostPill.Visible = #parts > 0
				boost.Text = table.concat(parts, "  ")
			end
			task.wait(1)
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Index</string>
              <string name="Source"><![CDATA[--!strict
-- Índice Squishy (renderIndex de game5.js + #indexWrap): "N / 413 descubiertos — las siluetas
-- siguen siendo un misterio", pestañas por especie (con wrap), celdas con barra de color arriba.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Config = require(Shared.Config)
local Profile = require(Shared.Logic.Profile)
local Squishy = require(Shared.Logic.Squishy)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Index = {}
local current = "cat"
local ui: { [string]: any } = {}

local function render()
	local d = State.data
	if not d or Modal.current ~= "index" or not ui.grid then
		return
	end
	ui.count.Text = string.format("%d / %d", Profile.discoveredCount(d), Catalog.indexTotal())
	Kit.clear(ui.tabs)
	for i, sp in Config.Species do
		local vs = Catalog.variantsFor(sp.id)
		local c = 0
		for _, v in vs do
			if d.discovered[sp.id .. "|" .. v] then
				c += 1
			end
		end
		local b = Kit.tab(
			string.format(
				"%s%s <font transparency='0.4'>%d/%d</font>",
				if sp.famous then "✨ " else "",
				sp.name,
				c,
				#vs
			),
			current == sp.id,
			sp.famous,
			{ LayoutOrder = i, Parent = ui.tabs }
		)
		b.Activated:Connect(function()
			current = sp.id
			Audio.play("click")
			render()
		end)
	end
	Kit.clear(ui.grid)
	local gen = {}
	ui.gen = gen
	local vs = Catalog.variantsFor(current)
	-- miniaturas progresivas para que la UI no se trabe (como el prototipo)
	task.spawn(function()
		for i, vid in vs do
			if ui.gen ~= gen then
				return
			end
			local v = Catalog.VAR[vid]
			local known = d.discovered[current .. "|" .. vid] == true
			local r = Catalog.R[v.rarity]
			-- .idx: blanca, radius 15, borde superior de 5px del color de la rareza, sombra lav2
			local cell: Frame = Kit.new("Frame", {
				BackgroundColor3 = Theme.white,
				ClipsDescendants = false,
				LayoutOrder = i,
				Parent = ui.grid,
			}, { Kit.corner(15) })
			Kit.shadow(cell, Theme.lav2, 3, 15)
			Kit.new("Frame", {
				BackgroundColor3 = Color3.fromHex(r.color),
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(6, 0),
				Size = UDim2.new(1, -12, 0, 5),
				Parent = cell,
			}, { Kit.corner(3) })
			local th: Frame = Kit.new("Frame", {
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 8),
				Size = UDim2.fromOffset(84, 84),
				Parent = cell,
			})
			Thumb.make({ species = current, variant = vid }, th, not known)
			Kit.text(
				if known then Squishy.name({ species = current, variant = vid, mutation = "normal" }) else "???",
				11.5,
				{
					FontFace = Theme.bodyBlack,
					TextColor3 = if known then Theme.ink else Color3.fromHex("#a7abb9"),
					TextXAlignment = Enum.TextXAlignment.Center,
					TextYAlignment = Enum.TextYAlignment.Top,
					Position = UDim2.new(0, 4, 1, -34),
					Size = UDim2.new(1, -8, 0, 30),
					LineHeight = 0.95,
					Parent = cell,
				}
			)
			if i % 6 == 0 then
				task.wait()
			end
		end
	end)
end

local function open()
	local content = Modal.open("index", "Índice Squishy", {
		width = 900,
		height = 660,
		onClose = function()
			ui = {}
		end,
	})
	local head: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 36),
		Parent = content,
	}, { Kit.list(Enum.FillDirection.Horizontal, 14) });
	(head:FindFirstChildOfClass("UIListLayout") :: UIListLayout).VerticalAlignment = Enum.VerticalAlignment.Center
	ui.count = Kit.text("", 30, {
		FontFace = Theme.display,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 36),
		TextWrapped = false,
		Parent = head,
	})
	Kit.text("descubiertos — las siluetas siguen siendo un misterio", 16, {
		FontFace = Theme.bodyBlack,
		TextColor3 = Theme.muted,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 22),
		TextWrapped = false,
		LayoutOrder = 2,
		Parent = head,
	})
	local tabs: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 44),
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		Parent = content,
	})
	local tl = Kit.list(Enum.FillDirection.Horizontal, 6)
	tl.Wraps = true
	tl.Parent = tabs
	ui.tabs = tabs
	local grid = Modal.scroll(content, { Position = UDim2.fromOffset(0, 150), Size = UDim2.new(1, 0, 1, -150) })
	local function place()
		grid.Position = UDim2.fromOffset(0, 52 + tabs.AbsoluteSize.Y)
		grid.Size = UDim2.new(1, 0, 1, -(52 + tabs.AbsoluteSize.Y))
	end
	tabs:GetPropertyChangedSignal("AbsoluteSize"):Connect(place)
	local inner: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -10, 0, 0),
		Parent = grid,
	}, { Kit.new("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 8) }) })
	Kit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(104, 132),
		CellPadding = UDim2.fromOffset(9, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = inner,
	})
	ui.grid = inner
	Audio.play("open")
	render()
	task.defer(place)
end

function Index.init()
	Router.register("index", open)
end

return Index
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Interact</string>
              <string name="Source"><![CDATA[--!strict
-- Interacción (#prompt de template.html + interact() de game5.js): los ProximityPrompt del mundo
-- van en estilo Custom y se dibujan como el aviso del original, abajo al centro:
--   [E] Usar la Máquina Squishy · "Máquina 02 — requiere nivel 5" (bloqueado, fondo rojizo)
-- Al tocar el aviso (celular) también se activa.
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Interact = {}

local machineDefs: { [string]: any } = {}
for _, m in Config.Machines do
	machineDefs[m.id] = m
end

local function lockedText(prompt: ProximityPrompt): string?
	local d = State.data
	if not d then
		return nil
	end
	if prompt:GetAttribute("Kind") == nil and prompt.Parent then
		local kind = prompt.Parent:GetAttribute("Kind")
		local id = prompt.Parent:GetAttribute("Id")
		if kind == "machine" then
			local def = machineDefs[tostring(id)]
			if def and d.level < def.level then
				return string.format("%s — requiere nivel %d", def.name, def.level)
			end
		end
	end
	return nil
end

local function trigger(prompt: ProximityPrompt)
	local kind = prompt:GetAttribute("Kind") or (prompt.Parent and prompt.Parent:GetAttribute("Kind"))
	local id = prompt:GetAttribute("Id") or (prompt.Parent and prompt.Parent:GetAttribute("Id"))
	if Modal.current then
		return
	end
	local why = Modal.blocked()
	if why then
		Toast.show(why)
		return
	end
	if lockedText(prompt) then
		Audio.play("error")
		return
	end
	if kind == "machine" then
		Router.open("machine", id)
	elseif kind == "shop" then
		Router.open("shop")
	elseif kind == "index" then
		Router.open("index")
	elseif kind == "tradeBoard" then
		Router.open("tradePlayers")
	elseif kind == "npc" then
		Router.open("npcChat", id)
	end
end

function Interact.init()
	-- #prompt: bottom 120, fondo rgba(40,45,58,.88), radius 14, Nunito 900 16 blanco, tecla en ficha blanca
	local pill: TextButton = Kit.new("TextButton", {
		Name = "Prompt",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.ink,
		BackgroundTransparency = 0.12,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -120),
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		Visible = false,
		Parent = Kit.root(),
	}, { Kit.corner(14), Kit.pad(16, 10) })
	local row: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		Parent = pill,
	}, { Kit.list(Enum.FillDirection.Horizontal, 10) });
	(row:FindFirstChildOfClass("UIListLayout") :: UIListLayout).VerticalAlignment = Enum.VerticalAlignment.Center
	local key: TextLabel = Kit.new("TextLabel", {
		BackgroundColor3 = Theme.white,
		TextColor3 = Theme.ink,
		FontFace = Theme.display,
		TextSize = 16,
		Text = "E",
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 24),
		LayoutOrder = 1,
		Parent = row,
	}, { Kit.corner(8), Kit.pad(9, 0) })
	Kit.shadow(key, Color3.fromHex("#b7bccb"), 3, 8)
	local label = Kit.text("", 16, {
		FontFace = Theme.bodyBlack,
		TextColor3 = Theme.white,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 24),
		TextWrapped = false,
		LayoutOrder = 2,
		Parent = row,
	})

	local current: ProximityPrompt? = nil
	local function refresh()
		local p = current
		if not p or Modal.current then
			pill.Visible = false
			return
		end
		local locked = lockedText(p)
		label.Text = locked or p.ActionText
		key.Visible = locked == nil
		pill.BackgroundColor3 = if locked then Color3.fromRGB(120, 70, 80) else Theme.ink
		key.Text = if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "👆" else "E"
		pill.Visible = true
	end
	ProximityPromptService.PromptShown:Connect(function(prompt)
		current = prompt
		refresh()
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		if current == prompt then
			current = nil
			refresh()
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(trigger)
	pill.Activated:Connect(function()
		local p = current
		if p then
			trigger(p)
		end
	end)
	Modal.onChange(refresh)
	State.onChange(refresh)

	-- letreros "Requiere nivel N" en máquinas bloqueadas (LockSign del original)
	local signs: { [string]: BillboardGui } = {}
	local interact = Workspace:WaitForChild("Interact", 60)
	local function applyLocks()
		local d = State.data
		if not d then
			return
		end
		for _, m in Config.WorldLayout.machines do
			local s = signs[m.id]
			if s then
				s.Enabled = d.level < m.level
			end
		end
	end
	for _, m in Config.WorldLayout.machines do
		task.spawn(function()
			-- con StreamingEnabled el ancla puede llegar después
			local anchor = interact and interact:WaitForChild("machine_" .. m.id, 120)
			if not anchor or not anchor:IsA("BasePart") then
				return
			end
			signs[m.id] = Kit.new("BillboardGui", {
				Size = UDim2.fromOffset(190, 40),
				StudsOffsetWorldSpace = Vector3.new(0, 7.5, 3),
				MaxDistance = 90,
				Enabled = false,
				Parent = anchor,
			}, {
				Kit.new("TextLabel", {
					BackgroundColor3 = Theme.ink,
					TextColor3 = Theme.white,
					FontFace = Theme.display,
					TextSize = 20,
					Text = "🔒 Requiere nivel " .. m.level,
					Size = UDim2.fromScale(1, 1),
				}, { Kit.corner(10) }),
			})
			applyLocks()
		end)
	end
	State.onChange(applyLocks)
end

return Interact
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Inventory</string>
              <string name="Source"><![CDATA[--!strict
-- Inventario (renderInventory / renderInvDetail de game5.js + #invWrap de template.html):
-- 4 columnas + detalle de 290, filtros por rareza y ⭐ Favoritos, equipar, favorito, vender,
-- "Vender repetidos" y 🖐️ Apachurrar.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Profile = require(Shared.Logic.Profile)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Inventory = {}
local Inv = { filter = "all", sel = nil :: string? }
local ui: { [string]: any } = {}

local MONTHS = { "ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sept", "oct", "nov", "dic" }
--- toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' }) → "25 sept 2026"
local function fmtDate(t: number): string
	local d = os.date("*t", t) :: any
	return string.format("%d %s %d", d.day, MONTHS[d.month], d.year)
end

--- Chip de rareza (.rr): ancho automático, 11px, radius 7, texto blanco.
function Inventory.rarityChip(parent: Instance, rarity: string, props: { [string]: any }?): TextLabel
	local r = Catalog.R[rarity]
	local p: { [string]: any } = {
		BackgroundColor3 = Color3.fromHex(r.color),
		TextColor3 = Theme.white,
		FontFace = Theme.bodyBlack,
		TextSize = 11,
		Text = r.name,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 17),
		Parent = parent,
	}
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	return Kit.new("TextLabel", p, { Kit.corner(7), Kit.pad(8, 0) })
end

--- Carta .card (se reutiliza en intercambios): blanca, radius 18, sombra lav2, elegida = borde ink.
function Inventory.card(parent: Instance, s: any, d: any?, selected: boolean?, compact: boolean?): TextButton
	local b = Kit.new("TextButton", {
		Text = "",
		AutoButtonColor = true,
		BackgroundColor3 = Theme.white,
		Size = if compact then UDim2.fromOffset(78, 100) else UDim2.fromOffset(120, 170),
		Parent = parent,
	}, {
		Kit.corner(if compact then 14 else 18),
		Kit.new("UIStroke", {
			Color = if compact then Theme.mintD else Theme.ink,
			Thickness = 3,
			Transparency = if selected then 0 else 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}),
	})
	Kit.shadow(b, Theme.lav2, 4, 18)
	local th: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.new(1, -16, 1, if compact then -34 else -52),
		Parent = b,
	}, { Kit.new("UIAspectRatioConstraint", { AspectRatio = 1 }) })
	Thumb.make(s, th)
	Kit.text(s.name, if compact then 10.5 else 12.5, {
		FontFace = Theme.bodyBlack,
		Position = UDim2.new(0, 4, 1, if compact then -28 else -46),
		Size = UDim2.new(1, -8, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		LineHeight = 0.95,
		Parent = b,
	})
	if not compact then
		Inventory.rarityChip(b, s.rarity, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6) })
	end
	if s.fav then
		Kit.star(true, 15, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 4), Parent = b })
	end
	if d and d.equipped == s.id then
		Kit.new("TextLabel", {
			BackgroundColor3 = Theme.ink,
			TextColor3 = Theme.white,
			FontFace = Theme.bodyBlack,
			TextSize = 10,
			Text = "Equipado",
			AutomaticSize = Enum.AutomaticSize.X,
			Position = UDim2.fromOffset(8, 6),
			Size = UDim2.fromOffset(0, 16),
			Parent = b,
		}, { Kit.corner(7), Kit.pad(6, 0) })
	end
	return b
end

local render: () -> ()

local function kv(parent: Instance, order: number, k: string, v: string)
	local row: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = order,
		Parent = parent,
	})
	Kit.text(k, 14, { TextColor3 = Theme.ink2, Size = UDim2.fromScale(0.5, 1), Parent = row })
	Kit.text(v, 14, {
		FontFace = Theme.bodyBlack,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(0.6, 1),
		Parent = row,
	})
end

local function detail(d: any)
	Kit.clear(ui.detail)
	local s = Inv.sel and Profile.find(d, Inv.sel)
	if not s then
		Kit.text("Elige un squishy para verlo aquí.", 14, {
			TextColor3 = Theme.grey,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1, 0, 0, 60),
			Parent = ui.detail,
		})
		return
	end
	local th: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(190, 190),
		LayoutOrder = 1,
		Parent = ui.detail,
	})
	Thumb.make(s, th)
	Kit.text(s.name, 24, {
		FontFace = Theme.display,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = ui.detail,
	})
	Inventory.rarityChip(ui.detail, s.rarity, { LayoutOrder = 3, TextSize = 12, Size = UDim2.fromOffset(0, 20) })
	local copies = 0
	for _, x in d.inventory do
		if Profile.idxKey(x) == Profile.idxKey(s) then
			copies += 1
		end
	end
	local mut = Catalog.MUT[s.mutation]
	kv(ui.detail, 11, "Encontrado", fmtDate(s.dateFound))
	kv(ui.detail, 12, "Valor", Format.int(s.value) .. " monedas")
	kv(ui.detail, 13, "Relleno", if Catalog.FIL[s.filling] then Catalog.FIL[s.filling].name else "—")
	kv(ui.detail, 14, "Tamaño", string.format("%.2f×", s.size * ((mut and mut.size) or 1)))
	kv(ui.detail, 15, "Copias", tostring(copies))
	local sq = Kit.button("🖐️ Apachurrar", Theme.purple, { LayoutOrder = 29, Parent = ui.detail })
	sq.Activated:Connect(function()
		Modal.close()
		Router.open("studio", { squishy = s, owner = "Tuyo" })
	end)
	local row: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = 30,
		Parent = ui.detail,
	}, { Kit.list(Enum.FillDirection.Horizontal, 8) })
	local eq = Kit.button(
		if d.equipped == s.id then "Quitar" else "Equipar",
		Theme.mint,
		{ Size = UDim2.new(0.5, -4, 0, 40), Parent = row }
	)
	local fav = Kit.button(
		if s.fav then "⭐ Quitar fav" else "Favorito",
		Theme.white,
		{ Size = UDim2.new(0.5, -4, 0, 40), TextSize = 14, Parent = row }
	)
	local sell =
		Kit.button("Vender por " .. Format.int(s.value), Theme.yellow, { LayoutOrder = 31, Parent = ui.detail })
	if s.fav or d.equipped == s.id then
		Kit.setEnabled(sell, false)
	end
	eq.Activated:Connect(function()
		Audio.play("select")
		State.request("inv", { op = "equip", id = s.id })
	end)
	fav.Activated:Connect(function()
		Audio.play("toggle")
		State.request("inv", { op = "fav", id = s.id })
	end)
	sell.Activated:Connect(function()
		if s.fav or d.equipped == s.id then
			return
		end
		State.request("inv", { op = "sell", id = s.id })
	end)
end

render = function()
	local d = State.data
	if not d or Modal.current ~= "inventory" or not ui.grid then
		return
	end
	ui.count.Text = string.format("%d/%d", #d.inventory, d.capacity or 20)
	Kit.clear(ui.tabs)
	for i, id in ui.tabIds do
		local label = if id == "all" then "Todos" elseif id == "favorites" then "⭐ Favoritos" else Catalog.R[id].name
		local b = Kit.tab(label, Inv.filter == id, false, { LayoutOrder = i, Parent = ui.tabs })
		b.Activated:Connect(function()
			Inv.filter = id
			Audio.play("click")
			render()
		end)
	end
	local list = table.clone(d.inventory)
	table.sort(list, function(a: any, b: any)
		if a.value ~= b.value then
			return a.value > b.value
		end
		return a.dateFound > b.dateFound
	end)
	local filtered = {}
	for _, s in list do
		if Inv.filter == "all" or (Inv.filter == "favorites" and s.fav) or s.rarity == Inv.filter then
			table.insert(filtered, s)
		end
	end
	Kit.clear(ui.grid)
	if #filtered == 0 then
		Kit.text(
			if #d.inventory > 0
				then "Nada con este filtro."
				else "Aún no tienes squishies. ¡Ve a las Máquinas y llena el primero!",
			14,
			{
				FontFace = Theme.body,
				TextColor3 = Theme.grey,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.new(1, 0, 0, 80),
				Parent = ui.grid.Parent,
				Name = "_Empty",
			}
		)
	else
		local e = ui.grid.Parent:FindFirstChild("_Empty")
		if e then
			e:Destroy()
		end
	end
	if not Inv.sel or not Profile.find(d, Inv.sel) then
		Inv.sel = if filtered[1] then filtered[1].id else nil
	end
	for i, s in filtered do
		local b = Inventory.card(ui.grid, s, d, Inv.sel == s.id)
		b.LayoutOrder = i
		b.Activated:Connect(function()
			Inv.sel = s.id
			Audio.play("click")
			render()
		end)
	end
	detail(d)
end

local function open()
	local content, title = Modal.open("inventory", "Inventario", {
		width = 980,
		height = 660,
		onClose = function()
			ui = {}
		end,
	})
	-- "Inventario " + #invCount en 18px con opacidad .55
	title.AutomaticSize = Enum.AutomaticSize.X
	title.Size = UDim2.fromOffset(0, 34)
	ui.count = Kit.text("", 18, {
		FontFace = Theme.display,
		TextTransparency = 0.45,
		TextWrapped = false,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 34),
		Parent = title.Parent,
	})
	title:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		ui.count.Position = UDim2.fromOffset(22 + title.AbsoluteSize.X + 8, 20)
	end)
	ui.count.Position = UDim2.fromOffset(150, 20)
	local dupes = Kit.button("Vender repetidos", Theme.yellow, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -46, 0, -44),
		Size = UDim2.fromOffset(150, 30),
		Parent = content,
	}, "small")
	dupes.Activated:Connect(function()
		local prev = State.request("inv", { op = "sellDupes", preview = true })
		if not prev.ok then
			return
		end
		Router.open("confirm", {
			text = string.format(
				"¿Vender %d repetido%s por %s monedas? Te quedas con la mejor copia de cada uno.",
				prev.count,
				if prev.count > 1 then "s" else "",
				Format.int(prev.total)
			),
			yes = function()
				State.request("inv", { op = "sellDupes" })
			end,
		})
	end)
	ui.tabs = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 30),
		Parent = content,
	}, { Kit.list(Enum.FillDirection.Horizontal, 6) })
	ui.tabIds = { "all" }
	for _, r in Config.Rarities do
		table.insert(ui.tabIds, r.id)
	end
	table.insert(ui.tabIds, "favorites")
	local gridHolder = Modal.scroll(content, {
		Position = UDim2.fromOffset(0, 42),
		Size = UDim2.new(1, -304, 1, -42),
	})
	local inner: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -10, 0, 0),
		Parent = gridHolder,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.new(0.25, -8, 0, 176),
		CellPadding = UDim2.fromOffset(10, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = inner,
	})
	Kit.new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8), Parent = inner })
	ui.grid = inner
	local det: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.lav,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 42),
		Size = UDim2.new(0, 290, 1, -42),
		Parent = content,
	}, { Kit.corner(20), Kit.pad(16, 16) })
	local detScroll = Modal.scroll(det)
	Kit.list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = detScroll
	ui.detail = detScroll
	Audio.play("open")
	Router.open("hudPulse", { key = "inventory", on = false })
	render()
end

function Inventory.init()
	Router.register("inventory", open)
	State.onChange(function()
		render()
	end)
end

return Inventory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Machine</string>
              <string name="Source"><![CDATA[--!strict
-- Panel "Crea un Squishy" + llenado (Fase 4). Porte de openMachine / renderMachinePanel /
-- holdStart / holdEnd de game5.js. El medidor se anima aquí con la MISMA fórmula, pero el resultado
-- (under/perfect/over/POP y la rareza) lo decide el servidor (FillService).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Profile = require(Shared.Logic.Profile)
local Squishy = require(Shared.Logic.Squishy)
local SquishyFactory = require(script.Parent.Parent.Engine.SquishyFactory)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local FILL = Config.Game.FILL
local M = Config.Monetization

local Machine = {}

type FillState = {
	state: string, -- idle | filling | processing | reveal
	machine: any?,
	species: string,
	filling: string,
	p: number,
	held: number,
	holding: boolean,
	started: boolean,
}

local Fill: FillState = {
	state = "idle",
	machine = nil,
	species = "cat",
	filling = "pink_foam",
	p = 0,
	held = 0,
	holding = false,
	started = false,
}

local ui: { [string]: any } = {}
local inside: Model? = nil

local function machineDef(id: string): any
	for _, m in Config.Machines do
		if m.id == id then
			return m
		end
	end
	return nil
end

local function domePos(id: string): Vector3
	for _, m in Config.WorldLayout.machines do
		if m.id == id then
			return m.dome
		end
	end
	return Vector3.zero
end

--- Suerte que ve el cliente (misma cuenta que FillService.luck en el servidor, solo para mostrar).
local function clientLuck(d: any, res: string?): number
	local L = Squishy.totalLuck(d.upgrades.luck, Fill.machine, Fill.filling, res :: any)
	if d.passes and d.passes.luckPlus then
		L += M.EFFECTS.luckPlus
	end
	if (d.luckLeft or 0) > 0 then
		L += M.EFFECTS.luckPotion
	end
	return L
end

local function clearInside()
	if inside then
		inside:Destroy()
		inside = nil
	end
end

local function setInside()
	clearInside()
	if not Fill.machine then
		return
	end
	local fil = Catalog.FIL[Fill.filling]
	local sp = Catalog.SP[Fill.species]
	local m = SquishyFactory.build({
		species = Fill.species,
		variant = if sp and sp.famous then "original" else "classic",
		mutation = "normal",
		size = 1,
	})
	-- tiñe con el color del relleno mientras se llena
	local body = m:FindFirstChild("Body", true)
	if body and body:IsA("BasePart") and fil then
		body.Color = Color3.fromHex(fil.color3 or (string.sub(fil.color, 1, 1) == "#" and fil.color) or "#F7A7CD")
	end
	m:ScaleTo(0.35)
	m:PivotTo(CFrame.new(domePos(Fill.machine.id)))
	m.Parent = Workspace
	inside = m
end

local function setGauge(p: number)
	if not ui.needle then
		return
	end
	local x = math.clamp(p, 0, FILL.pop) / FILL.pop
	ui.needle.Position = UDim2.new(x, 0, 0.5, 0)
	ui.prog.Size = UDim2.fromScale(x, 1)
end

local function resultText(txt: string, color: Color3)
	if ui.result then
		ui.result.Text = txt
		ui.result.TextColor3 = color
		ui.result.FontFace = Theme.display
		ui.result.TextSize = 20
	end
end

local render: () -> ()

local function moldButton(parent: Instance, sp: any, d: any, locked: boolean)
	local avail = Profile.moldAvailable(d, sp.id)
	local on = Fill.species == sp.id
	-- .mold: fondo lav, radius 16, borde transparente 3px; .on = borde ink + fondo blanco
	local b = Kit.new("TextButton", {
		Text = "",
		AutoButtonColor = true,
		BackgroundColor3 = if on then Theme.white else Theme.lav,
		Parent = parent,
	}, { Kit.corner(16) })
	if sp.famous and not on then
		Kit.new("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Theme.white, Color3.fromHex("#fff4fb")),
			Parent = b,
		})
	end
	Kit.new("UIStroke", {
		Color = Theme.ink,
		Thickness = 3,
		Transparency = if on then 0 else 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = b,
	})
	local thumbHolder: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 5),
		Size = UDim2.fromOffset(52, 52),
		Parent = b,
	})
	-- bloqueado = silueta (brightness(0) opacity(.25))
	Thumb.make({ species = sp.id, variant = if sp.famous then "original" else "classic" }, thumbHolder, not avail)
	Kit.text(sp.name, 11, {
		Position = UDim2.new(0, 2, 1, -24),
		Size = UDim2.new(1, -4, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		LineHeight = 0.9,
		FontFace = Theme.bodyBlack,
		Parent = b,
	})
	if not avail then
		-- .lk: centrada a top 22, 11px, ink, radius 8
		Kit.new("TextLabel", {
			BackgroundColor3 = Theme.ink,
			TextColor3 = Theme.white,
			Text = if sp.famous then "🛒 " .. Format.int(sp.price) else "Nv " .. sp.unlockLevel,
			TextSize = 11,
			FontFace = Theme.bodyBlack,
			AutomaticSize = Enum.AutomaticSize.X,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, 22),
			Size = UDim2.fromOffset(0, 18),
			Parent = b,
		}, { Kit.corner(8), Kit.pad(6, 0) })
	end
	b.Activated:Connect(function()
		if locked or Fill.state ~= "idle" then
			return
		end
		if not avail then
			Audio.play("error")
			Toast.show(
				if sp.famous
					then string.format("El molde %s se compra en la Tienda (%s monedas)", sp.name, Format.int(sp.price))
					else string.format("El molde %s se desbloquea en el nivel %d", sp.name, sp.unlockLevel)
			)
			return
		end
		Fill.species = sp.id
		Audio.play("click")
		render()
		setInside()
	end)
end

render = function()
	local d = State.data
	if not d or Modal.current ~= "machine" or not ui.body then
		return
	end
	local locked = Fill.state ~= "idle"
	-- moldes
	Kit.clear(ui.molds)
	Kit.clear(ui.virals)
	local virals = {}
	for _, sp in Config.Species do
		if sp.famous then
			table.insert(virals, sp)
		else
			moldButton(ui.molds, sp, d, locked)
		end
	end
	table.sort(virals, function(a, b)
		local aa, bb = Profile.moldAvailable(d, a.id), Profile.moldAvailable(d, b.id)
		if aa ~= bb then
			return aa
		end
		return a.price < b.price
	end)
	for _, sp in virals do
		moldButton(ui.virals, sp, d, locked)
	end
	-- rellenos (.fill: chips lav de ancho automático con círculo de color de 20px)
	Kit.clear(ui.fills)
	for i, f in Config.Fillings do
		local own = table.find(d.fillings, f.id) ~= nil
		local on = Fill.filling == f.id
		local label = f.name
		if own and f.perUse then
			label ..= if d.passes and d.passes.vip
				then " <font size='11'>(gratis 👑)</font>"
				else string.format(" <font size='11'>(%d)</font>", f.perUse)
		elseif not own then
			label ..= " 🔒"
		end
		local chip = Kit.new("TextButton", {
			Text = "",
			AutoButtonColor = true,
			BackgroundColor3 = if on then Theme.white else Theme.lav,
			BackgroundTransparency = if own then 0 else 0.5,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 32),
			LayoutOrder = i,
			Parent = ui.fills,
		}, {
			Kit.corner(13),
			Kit.new("UIStroke", {
				Color = Theme.ink,
				Thickness = 3,
				Transparency = if on then 0 else 1,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			}),
			Kit.new("UIPadding", { PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 10) }),
		})
		local row = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromScale(0, 1),
			Parent = chip,
		}, { Kit.list(Enum.FillDirection.Horizontal, 6) });
		(row:FindFirstChildOfClass("UIListLayout") :: UIListLayout).VerticalAlignment = Enum.VerticalAlignment.Center
		local sw = Color3.fromHex(f.color3 or (string.sub(f.color, 1, 1) == "#" and f.color) or "#ffd36e")
		Kit.new("Frame", { BackgroundColor3 = sw, Size = UDim2.fromOffset(20, 20), LayoutOrder = 1, Parent = row }, {
			Kit.round(),
			Kit.stroke(Color3.fromRGB(215, 212, 222), 1),
		})
		Kit.text(label, 13, {
			FontFace = Theme.bodyBlack,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 20),
			TextWrapped = false,
			TextTransparency = if own then 0 else 0.3,
			LayoutOrder = 2,
			Parent = row,
		})
		chip.Activated:Connect(function()
			if Fill.state ~= "idle" then
				return
			end
			if not own then
				Audio.play("error")
				Toast.show(string.format("%s se vende en la Tienda (%s monedas)", f.name, Format.int(f.price)))
				return
			end
			Fill.filling = f.id
			Audio.play("click")
			render()
			setInside()
		end)
	end
	-- probabilidades (normal y con Perfecto)
	Kit.clear(ui.odds)
	local w = Squishy.rarityWeights(clientLuck(d, nil), Fill.filling)
	local tot = 0
	for _, x in w do
		tot += x
	end
	for i, r in Config.Rarities do
		local pct = w[i] / tot * 100
		-- name.split(' ')[0].slice(0,4) + toFixed(tier > 2 ? 1 : 0)
		Kit.new("TextLabel", {
			BackgroundColor3 = Color3.fromHex(r.color),
			TextColor3 = Theme.white,
			FontFace = Theme.bodyBlack,
			TextSize = 10.5,
			Text = string.format(
				"%s %s%%",
				Kit.shortName(r.name, 4),
				if i > 3 then string.format("%.1f", pct) else string.format("%d", math.round(pct))
			),
			Size = UDim2.new(1 / 6, -4, 1, 0),
			LayoutOrder = i,
			Parent = ui.odds,
		}, { Kit.corner(8) })
	end
	-- botón
	local full = #d.inventory >= (d.capacity or 20)
	ui.hold.Text = if Fill.state == "filling" then "Llenando… ¡suelta!" else "Mantén para llenar"
	Kit.setEnabled(ui.hold, Fill.state == "idle" or Fill.state == "filling")
	if full and Fill.state == "idle" then
		resultText(
			string.format("Inventario lleno (%d). Vende algunos squishies primero.", d.capacity or 20),
			Theme.popRed
		)
		ui.result.FontFace = Theme.bodyBlack
		ui.result.TextSize = 15
		Kit.setEnabled(ui.hold, false)
	elseif Fill.state == "idle" and ui.result.Text ~= "" and not ui.keepResult then
		resultText("", Theme.grey)
	end
end

local function processing(res: { [string]: any })
	Fill.state = "processing"
	render()
	local labels: { [string]: { any } } = {
		under = { "Le faltó", Theme.grey },
		perfect = { "¡PERFECTO!", Theme.green },
		over = { "Se pasó", Theme.orange },
	}
	local l = labels[res.result]
	resultText(l[1], l[2])
	if res.result == "perfect" then
		Audio.play("sparkle")
	end
	Audio.play("whirr")
	task.delay(FILL.process, function()
		clearInside()
		Fill.state = "reveal"
		Router.open("reveal", { squishy = res.squishy, isNew = res.isNew, fromMachine = true })
	end)
end

local function popped()
	Fill.state = "processing"
	Audio.play("pop")
	clearInside()
	resultText("¡POP! Se reventó — demasiado lleno.", Theme.popRed)
	task.delay(1.4, function()
		Fill.state = "idle"
		Fill.p = 0
		Fill.held = 0
		Fill.started = false
		setGauge(0)
		ui.keepResult = false
		render()
		setInside()
	end)
end

local function holdEnd()
	if not Fill.holding then
		return
	end
	Fill.holding = false
	Audio.loop("fillLoop", false)
	if Fill.state ~= "filling" then
		return
	end
	-- espera a que el servidor haya registrado el inicio
	local t0 = os.clock()
	while not Fill.started and os.clock() - t0 < 3 and Fill.state == "filling" do
		task.wait()
	end
	if Fill.state ~= "filling" then
		return
	end
	local res = State.request("fillRelease", { held = Fill.held })
	if not res.ok then
		Fill.state = "idle"
		Fill.p = 0
		Fill.held = 0
		Fill.started = false
		setGauge(0)
		render()
		return
	end
	Fill.held = res.held or Fill.held
	Fill.p = res.p or Fill.p
	setGauge(Fill.p)
	if res.result == "short" then
		resultText("Sigue manteniendo…", Theme.grey)
		ui.keepResult = true
		render()
	elseif res.result == "pop" then
		ui.keepResult = true
		popped()
	else
		ui.keepResult = true
		processing(res)
	end
end

local function holdStart()
	if Modal.current ~= "machine" or not Fill.machine then
		return
	end
	local d = State.data
	if not d then
		return
	end
	if Fill.state == "idle" then
		if #d.inventory >= (d.capacity or 20) then
			Audio.play("error")
			return
		end
		Fill.state = "filling"
		Fill.p = 0
		Fill.held = 0
		Fill.started = false
		ui.keepResult = false
		resultText("", Theme.muted)
	elseif Fill.state ~= "filling" then
		return
	end
	Fill.holding = true
	Audio.loop("fillLoop", true)
	render()
	task.spawn(function()
		local res = State.request("fillStart", {
			machine = Fill.machine.id,
			species = Fill.species,
			filling = Fill.filling,
		})
		if not res.ok then
			Fill.holding = false
			Fill.state = "idle"
			Fill.p = 0
			Fill.held = 0
			setGauge(0)
			Audio.loop("fillLoop", false)
			Audio.play("error")
			if res.err == "pending" and res.squishy then
				Router.open("reveal", { squishy = res.squishy, isNew = false, fromMachine = true })
			elseif type(res.err) == "string" and #res.err > 12 then
				Toast.show(res.err)
			end
			render()
			return
		end
		Fill.started = true
	end)
end

local function open(machineId: string)
	local d = State.data
	local def = machineDef(machineId)
	if not d or not def then
		return
	end
	if d.level < def.level then
		Audio.play("error")
		Toast.show(string.format("%s se abre en el nivel %d", def.name, def.level))
		return
	end
	Fill.machine = def
	Fill.state = "idle"
	Fill.p = 0
	Fill.held = 0
	Fill.started = false
	Fill.species = if Profile.moldAvailable(d, d.lastMold) then d.lastMold else "cat"
	Fill.filling = if table.find(d.fillings, d.lastFill) then d.lastFill else "classic_foam"
	if d.tutorial <= 2 then
		Fill.species = "cat"
		Fill.filling = "pink_foam"
	end
	local vpX = if Workspace.CurrentCamera then Workspace.CurrentCamera.ViewportSize.X else 1600
	local vpY = if Workspace.CurrentCamera then Workspace.CurrentCamera.ViewportSize.Y else 900
	local width = if vpX < 1400 then 390 else 430 -- #machinePanel: 430 (390 en pantallas < 1400)
	local content = Modal.open("machine", if def.id == "m1" then "Crea un Squishy" else def.name, {
		width = width,
		height = math.floor(vpY * 0.92),
		anchor = Vector2.new(1, 0.5),
		position = UDim2.new(1, -18, 0.5, 0),
		noOverlay = true, -- el panel de la máquina va sin overlay
		onClose = function()
			if Fill.holding then
				Fill.holding = false
				Audio.loop("fillLoop", false)
			end
			if Fill.state == "filling" then
				State.request("fillCancel")
			end
			if Fill.state ~= "reveal" then
				Fill.state = "idle"
			end
			clearInside()
			ui = {}
		end,
	})
	local scroll = Modal.scroll(content)
	Kit.list(Enum.FillDirection.Vertical, 6).Parent = scroll
	Kit.new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = scroll })
	ui.body = scroll
	local info = string.format("%s · %s", def.name, def.sub)
	if def.luck and def.luck > 0 then
		info ..= string.format(" · +%d%% suerte", math.round(def.luck * 100))
	end
	if def.mutX then
		info ..= " · más mutaciones"
	end
	Kit.text(info, 13, { TextColor3 = Theme.muted, LayoutOrder = 1, Parent = scroll })

	-- .molds: 5 columnas, gap 8
	local function grid(order: number): Frame
		local f: Frame = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			LayoutOrder = order,
			Parent = scroll,
		})
		local g = Kit.new("UIGridLayout", {
			CellSize = UDim2.new(0.2, -7, 0, if vpX < 1400 then 80 else 88),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = f,
		})
		ui["grid" .. order] = g
		return f
	end
	Kit.h3("1. Elige el molde", { LayoutOrder = 10, Parent = scroll })
	ui.molds = grid(11)
	Kit.text(
		"✨ Moldes virales",
		14,
		{ FontFace = Theme.bodyBlack, TextColor3 = Theme.viral, LayoutOrder = 20, Parent = scroll }
	)
	-- .viralRow: scroll propio de alto 190
	local viralScroll = Modal.scroll(scroll, {
		Size = UDim2.new(1, 0, 0, 190),
		LayoutOrder = 21,
	})
	viralScroll.AutomaticSize = Enum.AutomaticSize.None
	ui.virals = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -8, 0, 0),
		Parent = viralScroll,
	})
	Kit.new("UIGridLayout", {
		CellSize = UDim2.new(0.2, -7, 0, if vpX < 1400 then 80 else 88),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = ui.virals,
	})
	Kit.h3("2. Elige el relleno", { LayoutOrder = 30, Parent = scroll })
	ui.fills = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 31,
		Parent = scroll,
	})
	local fl = Kit.list(Enum.FillDirection.Horizontal, 6)
	fl.Wraps = true
	fl.Parent = ui.fills
	Kit.h3("3. Mantén para llenar — suelta en la zona Perfecto", { LayoutOrder = 40, Parent = scroll })
	ui.odds = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 41,
		Parent = scroll,
	}, { Kit.list(Enum.FillDirection.Horizontal, 4) })

	-- .gauge: alto 30, radius 15, #e9e4f2 con zonas
	local gaugeWrap: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 34),
		LayoutOrder = 50,
		Parent = scroll,
	})
	local gauge: Frame = Kit.new("Frame", {
		BackgroundColor3 = Color3.fromHex("#e9e4f2"),
		Position = UDim2.fromOffset(0, 2),
		Size = UDim2.new(1, 0, 0, 30),
		ClipsDescendants = true,
		Parent = gaugeWrap,
	}, { Kit.corner(15) })
	local span = FILL.pop
	local function zone(a: number, b: number, col: string)
		Kit.new("Frame", {
			BackgroundColor3 = Color3.fromHex(col),
			BorderSizePixel = 0,
			Position = UDim2.fromScale(a / span, 0),
			Size = UDim2.fromScale((b - a) / span, 1),
			Parent = gauge,
		})
	end
	zone(FILL.perfect[1], FILL.perfect[2], "#9CE0CA")
	zone(FILL.perfect[2], span * 0.97, "#ffd9a8")
	zone(span * 0.97, span, "#ff9aa8")
	ui.prog = Kit.new("Frame", {
		BackgroundColor3 = Theme.ink,
		BackgroundTransparency = 0.92,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = gauge,
	})
	-- .needle: 5px, sobresale 2px, anillo blanco de 2px (fuera del recorte)
	ui.needle = Kit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.ink,
		Size = UDim2.new(0, 5, 0, 34),
		Position = UDim2.fromScale(0, 0.5),
		ZIndex = 3,
		Parent = gaugeWrap,
	}, { Kit.corner(3), Kit.new("UIStroke", { Color = Theme.white, Thickness = 2 }) })
	-- .glabels: space-between
	local lbl: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 16),
		LayoutOrder = 51,
		Parent = scroll,
	})
	local gl = Kit.list(Enum.FillDirection.Horizontal, 0)
	gl.HorizontalFlex = Enum.UIFlexAlignment.SpaceBetween
	gl.Parent = lbl
	local gaugeLabels: { { any } } = {
		{ "Le falta", Theme.grey },
		{ "Perfecto", Theme.perfectLbl },
		{ "Se pasa", Theme.grey },
		{ "¡Pop!", Theme.popRed },
	}
	for i, info2 in gaugeLabels do
		Kit.text(info2[1] :: string, 11, {
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 16),
			TextWrapped = false,
			TextColor3 = info2[2] :: Color3,
			FontFace = Theme.bodyBlack,
			LayoutOrder = i,
			Parent = lbl,
		})
	end

	-- #holdBtn: btn pink, Lilita 26, radius 20
	ui.hold = Kit.button("Mantén para llenar", Theme.pink, {
		Size = UDim2.new(1, 0, 0, 66),
		TextSize = 26,
		FontFace = Theme.display,
		LayoutOrder = 60,
		Parent = scroll,
	});
	(ui.hold:FindFirstChildOfClass("UICorner") :: UICorner).CornerRadius = UDim.new(0, 20)
	ui.hold.MouseButton1Down:Connect(holdStart)
	ui.hold.MouseButton1Up:Connect(function()
		task.spawn(holdEnd)
	end)
	ui.hold.MouseLeave:Connect(function()
		if Fill.holding then
			task.spawn(holdEnd)
		end
	end)
	ui.result = Kit.text("", 20, {
		FontFace = Theme.display,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 61,
		Parent = scroll,
	})
	Audio.play("open")
	render()
	setGauge(0)
	setInside()
	if d.tutorial < 3 then
		State.request("tutorial", { step = 3 })
		Toast.show(
			"El molde Gato y la Espuma Rosa están listos. ¡Mantén el botón y suelta en la zona verde Perfecto!",
			false,
			5000
		)
	end
end

--- La revelación terminó (guardado o vendido): la máquina vuelve a estar lista.
function Machine.revealDone()
	Fill.state = "idle"
	Fill.p = 0
	Fill.held = 0
	Fill.started = false
	ui.keepResult = false
	setGauge(0)
	if Modal.current == "machine" then
		render()
		setInside()
	end
end

function Machine.reopen()
	if Fill.machine then
		open(Fill.machine.id)
	end
end

function Machine.init()
	Modal.addGuard(function()
		if Modal.current == "machine" and (Fill.state == "filling" or Fill.state == "processing") then
			return "Termina de llenar primero"
		end
		return nil
	end)
	Router.register("machine", function(id)
		open(tostring(id))
	end)
	State.onChange(function()
		if Fill.state == "idle" then
			render()
		end
	end)
	-- Espacio = mantener para llenar (como el original)
	UserInputService.InputBegan:Connect(function(input, gp)
		if not gp and input.KeyCode == Enum.KeyCode.Space and Modal.current == "machine" then
			holdStart()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Space and Fill.holding then
			task.spawn(holdEnd)
		end
	end)
	RunService.RenderStepped:Connect(function(dt: number)
		if Fill.holding and Fill.state == "filling" then
			local d = State.data
			local speed = if d then d.upgrades.fillSpeed else 1
			local time = FILL.baseTime / (1 + 0.2 * (speed - 1))
			Fill.p += dt / time * (1 + Fill.p * 0.35)
			Fill.held += dt
			setGauge(Fill.p)
			if inside then
				inside:ScaleTo(0.35 + 0.65 * math.min(1.1, Fill.p))
			end
			if Fill.p >= FILL.pop then
				task.spawn(holdEnd)
			end
		end
	end)
end

return Machine
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Reveal</string>
              <string name="Source"><![CDATA[--!strict
-- Revelación (#reveal + showReveal / updateReveal / spawnRevealFx de game5.js):
-- fondo oscuro radial por rareza, "Te salió…", el squishy aparece 0→1.15→1 a los 0.55 s y se
-- mece (sin(t·0.9)·0.5), rareza en Lilita 64 con pop, glitch + pantallazo negro en el Secreto,
-- badges, partículas por rareza y Guardar / Vender.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Format = require(Shared.Util.Format)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Audio = require(script.Parent.Audio)
local Machine = require(script.Parent.Machine)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Reveal = {}
Reveal.open = false
local overlay: Frame? = nil
local conns: { RBXScriptConnection } = {}

-- radial-gradient(circle at 50% 45%, centro, borde) de template.html
local BG: { [string]: { Color3 | number } } = {
	base = { Color3.fromRGB(40, 45, 58), 0.65, Color3.fromRGB(20, 22, 30), 0.18 },
	rare = { Color3.fromRGB(92, 168, 255), 0.55, Color3.fromRGB(15, 25, 50), 0.16 },
	epic = { Color3.fromRGB(180, 92, 255), 0.5, Color3.fromRGB(30, 15, 50), 0.14 },
	legendary = { Color3.fromRGB(255, 214, 90), 0.25, Color3.fromRGB(120, 70, 10), 0.15 },
	secret = { Color3.fromHex("#07060c"), 0, Color3.fromHex("#07060c"), 0 },
}
local FX: { [string]: { n: number, cols: { string } } } = {
	rare = { n = 40, cols = { "#bfe0ff", "#ffffff", "#4C9BFF" } },
	epic = { n = 80, cols = { "#e2c6ff", "#A95CFF", "#ffffff" } },
	legendary = { n = 140, cols = { "#FFC83A", "#FF8FA3", "#8BE3A5", "#8BC7E8", "#ffffff", "#B999E8" } },
	secret = { n = 120, cols = { "#000000", "#ff2a6d", "#05d9e8" } },
}

local function Debris(inst: Instance, t: number)
	task.delay(t, function()
		if inst.Parent then
			inst:Destroy()
		end
	end)
end

local function close()
	for _, c in conns do
		c:Disconnect()
	end
	table.clear(conns)
	if overlay then
		overlay:Destroy()
		overlay = nil
	end
	Reveal.open = false
end

local function background(parent: Frame, rarity: string)
	local bg = BG[rarity] or BG.base
	local inner, innerT, outer, outerT = bg[1] :: Color3, bg[2] :: number, bg[3] :: Color3, bg[4] :: number
	parent.BackgroundColor3 = outer
	parent.BackgroundTransparency = outerT
	if rarity == "secret" then
		return
	end
	-- aproximación del gradiente radial con círculos concéntricos
	local rings = 7
	for i = rings, 1, -1 do
		local k = i / rings
		Kit.new("Frame", {
			BackgroundColor3 = inner:Lerp(outer, k),
			BackgroundTransparency = 1 - (1 - innerT) * (1 - k) * 0.55 - 0.45 * k,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.45),
			Size = UDim2.fromScale(0.35 + 1.2 * k, 0.35 + 1.2 * k),
			Parent = parent,
		}, { Kit.round(), Kit.new("UIAspectRatioConstraint", { AspectRatio = 1 }) })
	end
end

local function particles(parent: Frame, rarity: string)
	local cfg = FX[rarity]
	if not cfg then
		return
	end
	local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	local cx, cy = vp.X / 2, vp.Y * 0.45
	local ps = {}
	for i = 1, cfg.n do
		local a = math.random() * math.pi * 2
		local sp = 2 + math.random() * (if rarity == "legendary" then 11 else 6)
		local kind = if rarity == "legendary"
			then (if i % 3 ~= 0 then "confetti" else "star")
			elseif rarity == "secret" then "glitch"
			else "spark"
		local s = 4 + math.random() * 5
		local col = Color3.fromHex(cfg.cols[math.random(1, #cfg.cols)])
		local f: any
		if kind == "star" then
			f = Kit.text("⭐", s * 2, {
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromOffset(s * 2, s * 2),
				TextColor3 = col,
				Parent = parent,
			})
		else
			f = Kit.new("Frame", {
				BackgroundColor3 = col,
				BorderSizePixel = 0,
				Size = if kind == "confetti"
					then UDim2.fromOffset(s, s / 2)
					elseif kind == "glitch" then UDim2.fromOffset(s * 2, 3)
					else UDim2.fromOffset(s * 0.7, s * 0.7),
				Parent = parent,
			})
			if kind == "spark" then
				Kit.round().Parent = f
			end
		end
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		table.insert(ps, {
			f = f,
			x = cx,
			y = cy,
			vx = math.cos(a) * sp,
			vy = math.sin(a) * sp - (if rarity == "legendary" then 5 else 1),
			life = 1.2 + math.random() * 1.4,
			rot = math.random() * 6,
			kind = kind,
		})
	end
	table.insert(
		conns,
		RunService.RenderStepped:Connect(function(dt: number)
			for i = #ps, 1, -1 do
				local p = ps[i]
				p.life -= dt
				if p.life <= 0 then
					p.f:Destroy()
					table.remove(ps, i)
					continue
				end
				p.vy += (if p.kind == "confetti" then 9 else 2) * dt
				p.vx *= 0.99
				p.x += p.vx * 60 * dt
				p.y += p.vy * 60 * dt
				p.rot += dt * 5
				p.f.Position = UDim2.fromOffset(p.x, p.y)
				p.f.Rotation = math.deg(p.rot)
				local alpha = 1 - math.min(1, p.life)
				if p.f:IsA("TextLabel") then
					p.f.TextTransparency = alpha
				else
					p.f.BackgroundTransparency = alpha
				end
			end
		end)
	)
end

local function show(arg: any)
	local d = arg.squishy
	if not d then
		return
	end
	close()
	Reveal.open = true
	local r = Catalog.R[d.rarity]
	local tier = Catalog.RTier[d.rarity]
	local secret = d.rarity == "secret"
	local rc = Color3.fromHex(r.color)
	local root = Kit.root("full")
	local ov: Frame = Kit.new("Frame", {
		Name = "Reveal",
		Size = UDim2.fromScale(1, 1),
		Active = true,
		Parent = root,
	})
	overlay = ov
	background(ov, if tier >= 2 then d.rarity else "base")
	local fxLayer: Frame =
		Kit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = ov })
	local vpY = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize.Y or 720
	local stage = math.min(420, vpY * 0.6)
	local col: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.fromOffset(640, 0),
		ZIndex = 2,
		Parent = ov,
	}, { Kit.list(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center) })
	Kit.text("Te salió…", 26, {
		FontFace = Theme.display,
		TextColor3 = Theme.white,
		TextTransparency = 0.1,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 1,
		Parent = col,
	})
	local view: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(stage, stage),
		LayoutOrder = 2,
		Parent = col,
	})
	local vf = Thumb.make({ species = d.species, variant = d.variant, mutation = d.mutation }, view)
	-- rareza: Lilita 64, color de la rareza, sombra 0 5px 0 rgba(0,0,0,.25), pop
	local rarityHolder: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, if vpY < 800 then 58 else 72),
		LayoutOrder = 3,
		Parent = col,
	})
	local rsize = if vpY < 800 then 50 else 64
	local rShadow = Kit.text("", rsize, {
		FontFace = Theme.display,
		TextColor3 = Color3.new(0, 0, 0),
		TextTransparency = 0.75,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(0, 5),
		Size = UDim2.fromScale(1, 1),
		TextWrapped = false,
		Parent = rarityHolder,
	})
	local rarity = Kit.text("", rsize, {
		FontFace = Theme.display,
		TextColor3 = rc,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 1),
		TextWrapped = false,
		Parent = rarityHolder,
	})
	local rScale = Kit.new("UIScale", { Scale = 1, Parent = rarityHolder })
	local name = Kit.text("", 30, {
		FontFace = Theme.display,
		TextColor3 = Theme.white,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 38),
		LayoutOrder = 4,
		Parent = col,
	})
	local badges: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 34),
		LayoutOrder = 5,
		Parent = col,
	}, { Kit.list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center) })
	local btns: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(420, 60),
		LayoutOrder = 6,
		Visible = false,
		Parent = col,
	}, { Kit.list(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center) })

	-- 0→1.15→1 después del "Te salió…" (0.55 s) + mecerse
	local model = vf:FindFirstChildWhichIsA("Model")
	local t = 0
	if model then
		local base = model:GetPivot()
		model:ScaleTo(0.01)
		table.insert(
			conns,
			RunService.RenderStepped:Connect(function(dt: number)
				t += dt
				local k = math.clamp((t - 0.55) / 0.55, 0, 1)
				local s = if k < 0.6 then 1.15 * (k / 0.6) else 1.15 + (1 - 1.15) * ((k - 0.6) / 0.4)
				model:ScaleTo(math.max(0.01, s))
				model:PivotTo(base * CFrame.Angles(0, math.sin(t * 0.9) * 0.5, 0))
				if d.rarity == "legendary" and vf.CurrentCamera then
					-- zoom 7.4 → 6.2
					vf.CurrentCamera.FieldOfView = 30 - 5 * math.clamp((t - 0.6) / 1.2, 0, 1)
				end
			end)
		)
	end

	if secret then
		-- .blackout: negro 0.9 s (opaco hasta el 55 %) + secretSting
		local black: Frame = Kit.new("Frame", {
			BackgroundColor3 = Color3.new(0, 0, 0),
			Size = UDim2.fromScale(1, 1),
			ZIndex = 10,
			Parent = ov,
		})
		task.delay(0.5, function()
			Kit.tween(black, 0.4, { BackgroundTransparency = 1 })
		end)
		Debris(black, 1)
		Audio.play("secretSting")
	end
	task.delay(if secret then 0.9 else 0.65, function()
		if overlay ~= ov then
			return
		end
		local txt = if secret then "¡SECRETO ENCONTRADO!" else "¡" .. r.name .. "!"
		rarity.Text = txt
		rShadow.Text = txt
		rScale.Scale = 0
		Kit.tween(rScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
		name.Text = d.name
		if secret then
			-- glitch: copias magenta/cian ±3px y saltitos
			local g1 = rarity:Clone()
			g1.TextColor3 = Color3.fromHex("#ff2a6d")
			g1.Parent = rarityHolder
			local g2 = rarity:Clone()
			g2.TextColor3 = Color3.fromHex("#05d9e8")
			g2.Parent = rarityHolder
			rarity.ZIndex = 3
			table.insert(
				conns,
				RunService.Heartbeat:Connect(function()
					local ph = math.floor(os.clock() * 8) % 4
					local dx = if ph == 0 then 3 elseif ph == 2 then -3 else 0
					g1.Position = UDim2.fromOffset(dx, 0)
					g2.Position = UDim2.fromOffset(-dx, 0)
					rarity.Position = UDim2.fromOffset(if ph == 1 then -2 elseif ph == 3 then 2 else 0, 0)
				end)
			)
		end
		-- .badge: blanco con texto ink; .new en amarillo
		local function badge(text: string, new: boolean?)
			Kit.new("TextLabel", {
				BackgroundColor3 = if new then Theme.yellow else Theme.white,
				TextColor3 = Theme.ink,
				FontFace = Theme.bodyBlack,
				TextSize = 13,
				Text = text,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 26),
				Parent = badges,
			}, { Kit.corner(10), Kit.pad(10, 0) })
		end
		if arg.isNew then
			badge("¡Squishy nuevo descubierto!", true)
		end
		if d.mutation ~= "normal" and Catalog.MUT[d.mutation] then
			badge(Catalog.MUT[d.mutation].name)
		end
		if Catalog.SP[d.species] and Catalog.SP[d.species].famous then
			badge("✨ Viral")
		end
		badge(string.format("Vale %s monedas", Format.int(d.value)))

		local data = State.data
		local full = data and #data.inventory >= (data.capacity or 20)
		local keep = Kit.button("Guardar", Theme.mint, { Size = UDim2.fromOffset(170, 52), Parent = btns }, "big")
		local sell = Kit.button("Vender +" .. Format.int(d.value), Theme.yellow, {
			Size = UDim2.fromOffset(190, 52),
			Parent = btns,
		}, "big")
		if full then
			Kit.setEnabled(keep, false)
		end
		btns.Visible = true
		local busy = false
		local function decide(k: boolean)
			if busy then
				return
			end
			busy = true
			local res = State.request("reveal", { keep = k })
			busy = false
			if res.ok then
				close()
				Machine.revealDone()
				local st = State.data
				if st and st.tutorial == 4 then
					-- paso 4 del tutorial: cerrar la máquina y pedir que lo equipe
					Modal.close()
					Router.open("tutorialEquip")
				end
			else
				Audio.play("error")
			end
		end
		keep.Activated:Connect(function()
			if full then
				return
			end
			decide(true)
		end)
		sell.Activated:Connect(function()
			decide(false)
		end)

		if tier == 0 then
			Audio.play("reward")
		elseif tier == 1 then
			Audio.play("reward")
			Audio.play("sparkle2")
		elseif tier == 2 then
			Audio.play("rare")
			Audio.play("sparkle")
		elseif tier == 3 then
			Audio.play("epic")
			Audio.play("sparkle")
		elseif tier == 4 then
			Audio.play("fanfare")
		end
		particles(fxLayer, d.rarity)
	end)
end

function Reveal.init()
	Router.register("reveal", show)
	-- si entraste con un squishy pendiente (te fuiste en plena revelación), se muestra de nuevo
	task.spawn(function()
		local d = State.waitReady()
		if d.pending then
			show({ squishy = d.pending, isNew = false })
		end
	end)
end

return Reveal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Router</string>
              <string name="Source"><![CDATA[--!strict
-- Abre pantallas por nombre sin que los controladores se requieran entre sí (evita ciclos).
local Modal = require(script.Parent.Parent.UI.Modal)
local Toast = require(script.Parent.Parent.UI.Toast)

local Router = {}
-- estas se pueden abrir aunque haya algo en curso (no reemplazan la ventana actual)
local OVERLAYS = { reveal = true, confirm = true, tutorialEquip = true, hudPulse = true }
local routes: { [string]: (any?) -> () } = {}

function Router.register(name: string, fn: (any?) -> ())
	routes[name] = fn
end

function Router.open(name: string, arg: any?)
	local fn = routes[name]
	if not OVERLAYS[name] then
		local why = Modal.blocked()
		if why then
			Toast.show(why)
			return
		end
	end
	if fn then
		fn(arg)
	else
		warn("[Router] pantalla desconocida:", name)
	end
end

return Router
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[--!strict
-- Tienda (renderShop de game5.js + #shopWrap): ✨ Moldes Virales, Rellenos (por defecto), Mejoras.
-- + ⭐ Robux (extra de monetización: pases y productos).
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
local Audio = require(script.Parent.Audio)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local M = Config.Monetization
local Shop = {}
local tab = "fillings"
local ui: { [string]: any } = {}
local realPrice: { [string]: number } = {}

local TABS = {
	{ "molds", "✨ Moldes Virales" },
	{ "fillings", "Rellenos" },
	{ "upgrades", "Mejoras" },
	{ "robux", "⭐ Robux" },
}

type ItemOpts = {
	order: number,
	title: string,
	desc: string,
	icon: ((Frame) -> ())?,
	price: string?, -- número con moneda
	label: string?, -- texto sin moneda ("Tuyo", "Nivel máximo", "R$ 99")
	color: Color3,
	enabled: boolean,
	levels: { number }?, -- { hechos, total } para .lv
	onBuy: () -> (),
}

-- .item: blanca, radius 18, padding 14, sombra 0 4px 0 lav2; .t Nunito 900 16; .d 12.5 700 #6d7285
local function item(o: ItemOpts): Frame
	local f: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.white,
		LayoutOrder = o.order,
		Parent = ui.grid,
	}, { Kit.corner(18), Kit.pad(14, 14) })
	Kit.shadow(f, Theme.lav2, 4, 18)
	local head: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 46),
		Parent = f,
	}, { Kit.list(Enum.FillDirection.Horizontal, 8) });
	(head:FindFirstChildOfClass("UIListLayout") :: UIListLayout).VerticalAlignment = Enum.VerticalAlignment.Center
	if o.icon then
		local holder: Frame = Kit.new(
			"Frame",
			{ BackgroundTransparency = 1, Size = UDim2.fromOffset(46, 46), LayoutOrder = 1, Parent = head }
		)
		o.icon(holder)
	end
	Kit.text(o.title, 16, {
		FontFace = Theme.bodyBlack,
		Size = UDim2.new(1, if o.icon then -54 else 0, 1, 0),
		LayoutOrder = 2,
		Parent = head,
	})
	Kit.text(o.desc, 12.5, {
		FontFace = Theme.bodyBold,
		TextColor3 = Theme.muted,
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 1, -100),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = f,
	})
	if o.levels then
		local lv: Frame = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, -44),
			Size = UDim2.new(1, 0, 0, 7),
			Parent = f,
		}, { Kit.list(Enum.FillDirection.Horizontal, 3) })
		local total = o.levels[2]
		for i = 1, total do
			Kit.new("Frame", {
				BackgroundColor3 = if i <= o.levels[1] then Theme.mint else Theme.lav,
				Size = UDim2.new(1 / total, -3, 1, 0),
				LayoutOrder = i,
				Parent = lv,
			}, { Kit.corner(4) })
		end
	end
	local props = {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -4),
		Size = UDim2.new(1, 0, 0, 36),
		Parent = f,
	}
	local b = if o.price then Kit.priceButton(o.price, o.color, props) else Kit.button(o.label or "", o.color, props)
	Kit.setEnabled(b, o.enabled)
	b.Activated:Connect(function()
		if o.enabled then
			o.onBuy()
		end
	end)
	return f
end

local function buy(kind: string, id: string)
	local res = State.request("shop", { kind = kind, id = id })
	if not res.ok then
		Audio.play("error")
	end
end

local function buyRobux(entry: any, isPass: boolean)
	if entry.id == 0 then
		if RunService:IsStudio() then
			State.request("devBuy", { key = entry.key })
		else
			Toast.show("¡Muy pronto!")
		end
		return
	end
	local lp = Players.LocalPlayer
	if isPass then
		MarketplaceService:PromptGamePassPurchase(lp, entry.id)
	else
		MarketplaceService:PromptProductPurchase(lp, entry.id)
	end
end

local function priceOf(entry: any, isPass: boolean): number
	if entry.id == 0 then
		return entry.robux
	end
	local k = (if isPass then "p" else "d") .. entry.id
	if realPrice[k] then
		return realPrice[k]
	end
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(
				entry.id,
				if isPass then Enum.InfoType.GamePass else Enum.InfoType.Product
			)
		end)
		if ok and info and info.PriceInRobux then
			realPrice[k] = info.PriceInRobux
		end
	end)
	return entry.robux
end

local function emojiIcon(e: string): (Frame) -> ()
	return function(h: Frame)
		Kit.text(e, 30, { Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = h })
	end
end

local function render()
	local d = State.data
	if not d or Modal.current ~= "shop" or not ui.grid then
		return
	end
	Kit.clear(ui.tabs)
	for i, t in TABS do
		local b = Kit.tab(t[2], tab == t[1], false, { LayoutOrder = i, Parent = ui.tabs })
		b.Activated:Connect(function()
			tab = t[1]
			Audio.play("click")
			render()
		end)
	end
	Kit.clear(ui.grid)
	if tab == "molds" then
		for i, sp in Config.Species do
			if sp.famous then
				local own = table.find(d.molds, sp.id) ~= nil
				local firm = if sp.soft >= 1.2 then "súper suave" elseif sp.soft >= 1 then "suave" else "firme"
				item({
					order = i,
					title = sp.name,
					desc = string.format(
						'%s\n<font color="#282D3A"><b>Slow rise %ss · %s</b></font>',
						sp.desc,
						tostring(sp.rise),
						firm
					),
					icon = function(h)
						Thumb.make({ species = sp.id, variant = "original" }, h)
					end,
					price = if own then nil else Format.int(sp.price),
					label = if own then "Tuyo" else nil,
					color = if own then Theme.lav else Theme.pink,
					enabled = not own and d.coins >= sp.price,
					onBuy = function()
						buy("mold", sp.id)
					end,
				})
			end
		end
	elseif tab == "fillings" then
		for i, fl in Config.Fillings do
			if fl.price > 0 then
				local own = table.find(d.fillings, fl.id) ~= nil
				local col = Color3.fromHex(fl.color3 or (string.sub(fl.color, 1, 1) == "#" and fl.color) or "#ffd36e")
				item({
					order = i,
					title = fl.name,
					desc = fl.desc or "",
					icon = function(h)
						Kit.new("Frame", {
							BackgroundColor3 = col,
							AnchorPoint = Vector2.new(0.5, 0.5),
							Position = UDim2.fromScale(0.5, 0.5),
							Size = UDim2.fromOffset(26, 26),
							Parent = h,
						}, { Kit.round(), Kit.stroke(Color3.fromRGB(215, 212, 222), 1) })
					end,
					price = if own then nil else Format.int(fl.price),
					label = if own then "Tuyo" else nil,
					color = if own then Theme.lav else Theme.pink,
					enabled = not own and d.coins >= fl.price,
					onBuy = function()
						buy("filling", fl.id)
					end,
				})
			end
		end
	elseif tab == "upgrades" then
		for i, k in { "fillSpeed", "luck", "storage" } do
			local u = (Config.Upgrades :: any)[k]
			local lvl = if k == "fillSpeed" then d.upgrades.fillSpeed - 1 else d.upgrades[k]
			local maxed = lvl >= #u.costs
			local cost = u.costs[lvl + 1]
			local cur
			if k == "storage" then
				cur = string.format("Guarda %d", u.caps[lvl + 1])
					.. (if maxed then "" else string.format(" → %d", u.caps[lvl + 2]))
			elseif k == "luck" then
				cur = string.format("+%d%% suerte", lvl * 6)
					.. (if maxed then "" else string.format(" → +%d%%", (lvl + 1) * 6))
			else
				cur = string.format("Velocidad %d", lvl + 1)
					.. (if maxed then "" else string.format(" → %d", lvl + 2))
			end
			item({
				order = i,
				title = u.name,
				desc = string.format('%s\n<font color="#282D3A"><b>%s</b></font>', u.desc, cur),
				levels = { lvl, #u.costs },
				price = if maxed then nil else Format.int(cost),
				label = if maxed then "Nivel máximo" else nil,
				color = if maxed then Theme.lav else Theme.mint,
				enabled = not maxed and d.coins >= cost,
				onBuy = function()
					buy("upgrade", k)
				end,
			})
		end
	else
		for i, p in M.PASSES do
			local own = d.passes and d.passes[p.key]
			item({
				order = i,
				title = p.name,
				desc = p.desc .. '\n<font color="#282D3A"><b>Pase: para siempre</b></font>',
				icon = emojiIcon(p.icon),
				label = if own then "¡Ya lo tienes!" else string.format("R$ %d", priceOf(p, true)),
				color = if own then Theme.lav else Theme.robux,
				enabled = not own and (p.id ~= 0 or RunService:IsStudio()),
				onBuy = function()
					buyRobux(p, true)
				end,
			})
		end
		for i, p in M.PRODUCTS do
			item({
				order = 100 + i,
				title = p.name,
				desc = p.desc,
				icon = emojiIcon(p.icon),
				label = string.format("R$ %d", priceOf(p, false)),
				color = Theme.robux,
				enabled = p.id ~= 0 or RunService:IsStudio(),
				onBuy = function()
					buyRobux(p, false)
				end,
			})
		end
	end
end

local function open(startTab: any?)
	if type(startTab) == "string" then
		tab = startTab
	end
	local content = Modal.open("shop", "Tienda", {
		width = 760,
		height = 600,
		onClose = function()
			ui = {}
		end,
	})
	ui.tabs = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 30),
		Parent = content,
	}, { Kit.list(Enum.FillDirection.Horizontal, 6) })
	local scroll = Modal.scroll(content, { Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 1, -42) })
	local inner: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -10, 0, 0),
		Parent = scroll,
	}, { Kit.new("UIPadding", { PaddingBottom = UDim.new(0, 10) }) })
	Kit.new("UIGridLayout", {
		CellSize = UDim2.new(1 / 3, -8, 0, 196),
		CellPadding = UDim2.fromOffset(12, 14),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = inner,
	})
	ui.grid = inner
	Audio.play("open")
	render()
	task.delay(1.5, render) -- precios reales del Marketplace llegan async
end

function Shop.init()
	Router.register("shop", open)
	Router.register("robux", function()
		open("robux")
	end)
	State.onChange(function()
		render()
	end)
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Squish</string>
              <string name="Source"><![CDATA[--!strict
-- Apachurrar en el mundo — versión mínima (Opción C de ROBLOX_ARCHITECTURE §6): mantener clic
-- (o el dedo) sobre cualquier squishy a < 34 studs lo aplasta (squash & stretch) y al soltar sube
-- lento con la recuperación de 2 fases de SYSTEMS_SPEC §7 (tauS = rise/3). El dueño se detiene.
-- Los brazos de tu avatar R15 lo agarran (AvatarHands.luau). La física de espuma completa con
-- EditableMesh es la Fase 7.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Damp = require(Shared.Util.Damp)
local Modal = require(script.Parent.Parent.UI.Modal)
local Audio = require(script.Parent.Audio)
local AvatarHands = require(script.Parent.AvatarHands)
local Companion = require(script.Parent.Companion)
local State = require(script.Parent.State)

local Squish = {}

local RANGE = 34

type Target = {
	model: Model,
	offsets: { [BasePart]: { cf: CFrame, size: Vector3 } },
	pivotToBottom: number,
	basePivot: CFrame, -- pivote al empezar (Body se mueve al aplastar; no releer GetPivot)
	f: number, -- fase rápida
	s: number, -- fase lenta
	target: number,
	held: boolean,
	rise: number,
	soft: number,
}

local active: Target? = nil

local function riseOf(model: Model): (number, number)
	local sp = Catalog.SP[string.gsub(model.Name, "^Squishy_", "")]
	local rise = if sp and sp.rise then sp.rise else 3.2
	local soft = if sp and sp.soft then sp.soft else 1
	return rise, soft
end

local function capture(model: Model): Target
	local pivot = model:GetPivot()
	local offsets = {}
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			offsets[p] = { cf = pivot:ToObjectSpace(p.CFrame), size = p.Size }
		end
	end
	local cf, size = model:GetBoundingBox()
	local rise, soft = riseOf(model)
	return {
		model = model,
		offsets = offsets,
		pivotToBottom = pivot.Y - (cf.Y - size.Y / 2),
		basePivot = pivot,
		f = 0,
		s = 0,
		target = 0,
		held = true,
		rise = rise,
		soft = soft,
	}
end

local function apply(t: Target)
	local k = t.f + t.s
	local sy = 1 - k
	local sxz = 1 + k * 0.62
	local pivot = t.basePivot
	local scale = Vector3.new(sxz, sy, sxz)
	for p, o in t.offsets do
		if p.Parent then
			-- escalar respecto a la base (se desparrama en el piso)
			local rel = o.cf.Position + Vector3.new(0, t.pivotToBottom, 0)
			local newPos = rel * scale - Vector3.new(0, t.pivotToBottom, 0)
			p.CFrame = pivot * (CFrame.new(newPos) * o.cf.Rotation)
			p.Size = o.size * scale
		end
	end
end

local function restore(t: Target)
	local pivot = t.basePivot
	for p, o in t.offsets do
		if p.Parent then
			p.CFrame = pivot * o.cf
			p.Size = o.size
		end
	end
end

local function pick(pos: Vector2): Model?
	local cam = Workspace.CurrentCamera
	local folder = Workspace:FindFirstChild("Companions")
	if not cam or not folder then
		return nil
	end
	local ray = cam:ViewportPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { folder }
	local hit = Workspace:Raycast(ray.Origin, ray.Direction * 200, params)
	if not hit then
		return nil
	end
	local m = hit.Instance:FindFirstAncestorWhichIsA("Model")
	while m and not m:GetAttribute("Squishy") do
		m = m:FindFirstAncestorWhichIsA("Model")
	end
	if not m then
		return nil
	end
	local char = Players.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (m:GetPivot().Position - root.Position).Magnitude > RANGE then
		return nil
	end
	return m
end

local function press(pos: Vector2)
	if Modal.current then
		return
	end
	local m = pick(pos)
	if not m then
		return
	end
	if active and active.model ~= m then
		restore(active)
	end
	if not active or active.model ~= m then
		active = capture(m)
	end
	local t = active :: Target
	t.held = true
	Companion.frozen = m
	AvatarHands.grab(m)
	Audio.play(if t.soft >= 1.1 then "squish2" else "squish", 0.9 + math.random() * 0.2)
	task.spawn(State.request, "squish")
	local npc = m:GetAttribute("NpcOwner")
	if npc then
		task.spawn(State.request, "npcSquished", { npc = npc })
	end
end

local function releaseAll()
	AvatarHands.release()
	local t = active
	if t and t.held then
		t.held = false
		-- rebote al soltar si estaba muy hundido
		local depth = t.f + t.s
		if depth > 0.25 * 0.45 then
			t.f -= 0.1 * (depth / 0.45) * math.clamp(2.6 / t.rise, 0.25, 1.3)
		end
	end
end

function Squish.init()
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			press(Vector2.new(input.Position.X, input.Position.Y))
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			releaseAll()
		end
	end)
	RunService.RenderStepped:Connect(function(dt: number)
		local t = active
		AvatarHands.update(dt, if t then t.f + t.s else 0)
		if not t then
			return
		end
		if not t.model.Parent then
			active = nil
			Companion.frozen = nil
			return
		end
		local max = math.min(0.45, 0.3 * t.soft + 0.1)
		if t.held then
			-- rigidez progresiva: se hunde rápido al principio y cada vez cuesta más
			t.target += dt * max * (2.8 * 0.6 * (1 - t.target / max) ^ 1.25 + 0.05)
			t.target = math.min(t.target, max)
			local depth = Damp.number(t.f + t.s, t.target, 14, dt)
			t.f = 0.35 * depth
			t.s = 0.65 * depth
		else
			t.target = 0
			local tauS = math.max(0.15, t.rise / 3)
			local tauF = 0.05 + t.rise * 0.02
			t.f -= t.f * math.min(1, dt / tauF)
			t.s -= t.s * math.min(1, dt / tauS)
			if math.abs(t.f + t.s) <= 0.002 then
				restore(t)
				active = nil
				Companion.frozen = nil
				return
			end
		end
		apply(t)
	end)
end

return Squish
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">State</string>
              <string name="Source"><![CDATA[--!strict
-- Copia local del perfil que manda el servidor (DataSync) + helper para pedirle cosas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

local State = {}

State.data = nil :: any
local listeners: { (any) -> () } = {}
local readyWaiters: { thread } = {}

function State.onChange(fn: (any) -> ())
	table.insert(listeners, fn)
	if State.data then
		task.spawn(fn, State.data)
	end
end

function State.waitReady(): any
	if State.data then
		return State.data
	end
	table.insert(readyWaiters, coroutine.running())
	return coroutine.yield()
end

--- Pide algo al servidor. Devuelve la tabla de respuesta ({ ok = false } si falla la red).
function State.request(action: string, payload: { [string]: any }?): { [string]: any }
	local ok, res = pcall(function()
		return Remotes.func("Request"):InvokeServer(action, payload or {})
	end)
	if ok and type(res) == "table" then
		return res
	end
	return { ok = false, err = "red" }
end

function State.init()
	Remotes.event("DataSync").OnClientEvent:Connect(function(view)
		State.data = view
		for _, th in readyWaiters do
			task.spawn(th, view)
		end
		table.clear(readyWaiters)
		for _, fn in listeners do
			task.spawn(fn, view)
		end
	end)
end

return State
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Trade</string>
              <string name="Source"><![CDATA[--!strict
-- Chat con NPC (#npcWrap) y Cambio con NPC (#tradeWrap) como el original (game5.js openNPC /
-- sendChat / openTrade), + intercambio entre jugadores reales (extra multijugador, mismo estilo).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Format = require(Shared.Util.Format)
local Remotes = require(Shared.Remotes)
local Thumb = require(script.Parent.Parent.Engine.Thumb)
local Kit = require(script.Parent.Parent.UI.Kit)
local Modal = require(script.Parent.Parent.UI.Modal)
local Theme = require(script.Parent.Parent.UI.Theme)
local Toast = require(script.Parent.Parent.UI.Toast)
local Audio = require(script.Parent.Audio)
local Inventory = require(script.Parent.Inventory)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Trade = {}
Trade.roomContent = (nil :: any) :: Frame

local GREY2 = Color3.fromHex("#8b90a3")

-- ─────────────── piezas comunes ───────────────
local function valueRow(parent: Instance, order: number, title: string, value: number): Frame
	local row: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = order,
		Parent = parent,
	})
	Kit.h3(title, { Size = UDim2.fromScale(0.6, 1), Parent = row })
	if value > 0 then
		local v: Frame = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 18),
			Parent = row,
		}, { Kit.list(Enum.FillDirection.Horizontal, 5) });
		(v:FindFirstChildOfClass("UIListLayout") :: UIListLayout).VerticalAlignment = Enum.VerticalAlignment.Center
		Kit.text(Format.int(value), 15, {
			FontFace = Theme.bodyBlack,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 18),
			TextWrapped = false,
			LayoutOrder = 1,
			Parent = v,
		})
		Kit.coin(14, { LayoutOrder = 2, Parent = v })
	end
	return row
end

-- .slot: flex 1, min-height 120, borde lav2, fondo blanco .6, 12px 900 #8b90a3
local function slots(
	parent: Instance,
	order: number,
	items: { any },
	max: number,
	emptyText: string,
	showRarity: boolean,
	onClick: ((any) -> ())?
)
	local row: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 124),
		LayoutOrder = order,
		Parent = parent,
	}, { Kit.list(Enum.FillDirection.Horizontal, 8) })
	for i = 1, max do
		local s = items[i]
		local slot = Kit.new("TextButton", {
			Text = "",
			AutoButtonColor = s ~= nil and onClick ~= nil,
			BackgroundColor3 = Theme.white,
			BackgroundTransparency = if s then 0 else 0.4,
			Size = UDim2.new(1 / max, -8 * (max - 1) / max, 1, 0),
			LayoutOrder = i,
			Parent = row,
		}, { Kit.corner(16), Kit.stroke(Theme.lav2, 3) })
		if s then
			local th: Frame = Kit.new("Frame", {
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(0.5, 0),
				Position = UDim2.new(0.5, 0, 0, 6),
				Size = UDim2.fromOffset(74, 74),
				Parent = slot,
			})
			Thumb.make(s, th)
			Kit.text(s.name, 11, {
				FontFace = Theme.bodyBlack,
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.new(0, 4, 0, 80),
				Size = UDim2.new(1, -8, 0, 24),
				LineHeight = 0.95,
				Parent = slot,
			})
			if showRarity then
				local r = Catalog.R[s.rarity]
				Kit.text(r.name, 11, {
					FontFace = Theme.bodyBlack,
					TextColor3 = Color3.fromHex(r.color),
					TextXAlignment = Enum.TextXAlignment.Center,
					Position = UDim2.new(0, 4, 1, -18),
					Size = UDim2.new(1, -8, 0, 14),
					Parent = slot,
				})
			end
			if onClick then
				slot.Activated:Connect(function()
					onClick(s)
				end)
			end
		else
			Kit.text(emptyText, 12, {
				FontFace = Theme.bodyBlack,
				TextColor3 = GREY2,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.fromScale(1, 1),
				Parent = slot,
			})
		end
	end
end

-- .miniGrid: mínimo 78px, gap 7; elegida = borde mintD
local function miniGrid(
	parent: Instance,
	order: number,
	d: any,
	chosen: { string },
	max: number,
	onToggle: (string) -> ()
)
	local sc = Modal.scroll(parent, { Size = UDim2.new(1, 0, 1, -236), LayoutOrder = order })
	sc.AutomaticSize = Enum.AutomaticSize.None
	local inner: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, -8, 0, 0),
		Parent = sc,
	})
	Kit.grid(UDim2.fromOffset(78, 100), 7).Parent = inner
	local avail = {}
	for _, s in d.inventory do
		if s.id ~= d.equipped then
			table.insert(avail, s)
		end
	end
	table.sort(avail, function(a: any, b: any)
		return a.value > b.value
	end)
	if #avail == 0 then
		Kit.text(
			"No tienes squishies para ofrecer (el equipado se queda contigo).",
			13,
			{ TextColor3 = Theme.grey, Size = UDim2.fromOffset(300, 50), Parent = inner }
		)
	end
	for i, s in avail do
		local b = Inventory.card(inner, s, nil, table.find(chosen, s.id) ~= nil, true)
		b.LayoutOrder = i
		b.Activated:Connect(function()
			if not table.find(chosen, s.id) and #chosen >= max then
				Audio.play("error")
				return
			end
			Audio.play("click")
			onToggle(s.id)
		end)
	end
end

local function column(parent: Instance, x: number, w: number): Frame
	local col: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.lav,
		Position = UDim2.new(x, if x > 0 then 7 else 0, 0, 0),
		Size = UDim2.new(w, -7, 1, -64),
		Parent = parent,
	}, { Kit.corner(20), Kit.pad(14, 14), Kit.list(Enum.FillDirection.Vertical, 8) })
	return col
end

local function fairness(parent: Instance, order: number, ratio: number, hasTheirs: boolean)
	Kit.text("Medidor del trato", 12, { TextColor3 = Theme.muted, LayoutOrder = order, Parent = parent })
	local bar: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.white,
		Size = UDim2.new(1, 0, 0, 12),
		LayoutOrder = order + 1,
		Parent = parent,
	}, { Kit.corner(7) })
	local fill: Frame = Kit.new("Frame", {
		BackgroundColor3 = if ratio >= 1.15
			then Color3.fromHex("#FFC83A")
			elseif ratio >= 0.8 then Theme.mint
			else Color3.fromHex("#ff9aa8"),
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}, { Kit.corner(7) })
	Kit.tween(fill, 0.3, { Size = UDim2.fromScale(math.clamp(ratio / 1.5, 0, 1), 1) })
	Kit.text(
		if not hasTheirs
			then ""
			elseif ratio >= 1.15 then "Súper trato para ellos: van a decir que sí."
			elseif ratio >= 0.8 then "Cambio justo: seguramente aceptan."
			else "Quieren más. Agrega otro squishy.",
		13,
		{ FontFace = Theme.bodyBlack, LayoutOrder = order + 2, Parent = parent }
	)
end

-- ─────────────── Cambio con NPC ───────────────
local function openNpcTrade(npcName: any)
	local res = State.request("npcTrade", { op = "open", npc = npcName })
	if not res.ok then
		if res.err then
			Toast.show(res.err)
		end
		return
	end
	local st = res
	local mine: { string } = {}
	local d0 = State.data
	local content = Modal.open("trade", "Cambio con " .. tostring(npcName), {
		width = 960,
		height = 640,
		onClose = function()
			State.request("npcTrade", { op = "close" })
		end,
	})
	local msg = if d0 and #d0.inventory > 0
		then "Elige lo que quieres ofrecer."
		else "¡Todavía no tienes nada para cambiar!"
	local function render()
		local d = State.data
		if Modal.current ~= "trade" or not d then
			return
		end
		Kit.clear(content)
		local mineItems = {}
		for _, id in mine do
			for _, s in d.inventory do
				if s.id == id then
					table.insert(mineItems, s)
				end
			end
		end
		-- columna izquierda: Tu oferta + inventario
		local left = column(content, 0, 0.5)
		valueRow(left, 1, "Tu oferta", st.myVal)
		slots(left, 2, mineItems, 3, "Vacío", false, function(s)
			table.remove(mine, table.find(mine, s.id) or 0)
			st = State.request("npcTrade", { op = "set", ids = mine })
			render()
		end)
		Kit.text("Elige hasta 3 squishies", 12, { TextColor3 = Theme.muted, LayoutOrder = 3, Parent = left })
		miniGrid(left, 4, d, mine, 3, function(id)
			local at = table.find(mine, id)
			if at then
				table.remove(mine, at)
			else
				table.insert(mine, id)
			end
			st = State.request("npcTrade", { op = "set", ids = mine })
			if st.msg then
				msg = st.msg
			end
			render()
		end)
		-- columna derecha: Su oferta + medidor
		local right = column(content, 0.5, 0.5)
		valueRow(right, 1, "Su oferta", st.theirVal)
		slots(right, 2, if st.theirs then { st.theirs } else {}, 1, "Esperando tu oferta…", true)
		local ratio = if st.theirVal > 0 then st.myVal / st.theirVal else 0
		fairness(right, 3, ratio, st.theirVal > 0)
		local reroll = Kit.button(
			"Pedir otra cosa",
			Theme.white,
			{ Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 10, Parent = right },
			"small"
		)
		Kit.setEnabled(reroll, #mine > 0 and st.rerolls < 3)
		reroll.Activated:Connect(function()
			if #mine == 0 or st.rerolls >= 3 then
				return
			end
			local r = State.request("npcTrade", { op = "reroll" })
			if r.ok then
				st = r
				msg = r.msg or msg
				Audio.play("select")
				render()
			end
		end)
		-- .tradeFoot: mensaje + Cancelar + Aceptar
		local foot: Frame = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.fromScale(0, 1),
			Size = UDim2.new(1, 0, 0, 52),
			Parent = content,
		})
		Kit.text(msg, 15, {
			FontFace = Theme.bodyBlack,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, -340, 0, 40),
			Parent = foot,
		})
		local btns: Frame = Kit.new("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(320, 50),
			Parent = foot,
		}, { Kit.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right) })
		local cancel =
			Kit.button("Cancelar", Theme.white, { Size = UDim2.fromOffset(130, 46), LayoutOrder = 1, Parent = btns })
		local accept = Kit.button(
			"Aceptar",
			Theme.mint,
			{ Size = UDim2.fromOffset(160, 50), LayoutOrder = 2, Parent = btns },
			"big"
		)
		Kit.setEnabled(accept, #mine > 0 and st.theirs ~= nil)
		cancel.Activated:Connect(Modal.close)
		accept.Activated:Connect(function()
			if #mine == 0 or not st.theirs then
				return
			end
			local r = State.request("npcTrade", { op = "accept" })
			if r.ok and r.done then
				Modal.close()
			elseif r.ok then
				st = r
				msg = r.msg or msg
				Audio.play("error")
				render()
			end
		end)
	end
	render()
end

-- ─────────────── Chat con NPC ───────────────
type ChatMsg = { me: boolean, text: string }
local chats: { [string]: { ChatMsg } } = {}

local function npcModel(name: string): Model?
	local f = Workspace:FindFirstChild("NPCs")
	local m = f and f:FindFirstChild(name)
	return if m and m:IsA("Model") then m else nil
end

local function openChat(npcName: any)
	local name = tostring(npcName)
	local model = npcModel(name)
	local sqd: any = nil
	if model then
		local j = model:GetAttribute("Companion")
		if type(j) == "string" then
			local ok, v = pcall(HttpService.JSONDecode, HttpService, j)
			if ok then
				sqd = v
			end
		end
	end
	task.spawn(State.request, "npcTalk", { npc = name })
	local log: { ChatMsg } = chats[name] or {}
	if not chats[name] then
		chats[name] = log
		local greet = {
			string.format("¡Holi! Soy %s 👋", name),
			"¡Hola! ¡Mucho gusto!",
			if sqd
				then string.format("¡Ey! ¿Quieres ver mi %s? Puedes apachurrarlo 😄", sqd.name)
				else "¡Hola! ¡Mucho gusto!",
		}
		table.insert(log, { me = false, text = greet[math.random(1, #greet)] })
	end
	local content, title = Modal.open("npc", name, { width = 560, height = 560 })
	title.Position = UDim2.fromOffset(84, 14)
	title.TextSize = 24
	-- .npcAv: miniatura del squishy que presume
	local av: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.lav,
		Position = UDim2.fromOffset(22, 14),
		Size = UDim2.fromOffset(48, 48),
		Parent = title.Parent,
	}, { Kit.corner(14) })
	if sqd then
		Thumb.make(sqd, av)
		Kit.text(
			string.format("Presumiendo: %s · %s", sqd.name, Catalog.R[sqd.rarity] and Catalog.R[sqd.rarity].name or ""),
			12.5,
			{
				TextColor3 = Theme.muted,
				Position = UDim2.fromOffset(84, 44),
				Size = UDim2.new(1, -330, 0, 16),
				Parent = title.Parent,
			}
		)
	end
	title.Size = UDim2.new(1, -330, 0, 30)
	local btns: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -64, 0, 18),
		Size = UDim2.fromOffset(250, 30),
		Parent = title.Parent,
	}, { Kit.list(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right) })
	local sqBtn = Kit.button(
		"🖐️ Apachurrar",
		Theme.purple,
		{ Size = UDim2.fromOffset(120, 30), LayoutOrder = 1, Parent = btns },
		"small"
	)
	local tradeBtn =
		Kit.button("Cambiar", Theme.mint, { Size = UDim2.fromOffset(86, 30), LayoutOrder = 2, Parent = btns }, "small")
	sqBtn.Activated:Connect(function()
		Modal.close()
		if sqd then
			Router.open("studio", { squishy = sqd, owner = "De " .. name })
		end
	end)
	tradeBtn.Activated:Connect(function()
		Modal.close()
		openNpcTrade(name)
	end)
	content.Position = UDim2.fromOffset(20, 74)
	content.Size = UDim2.new(1, -40, 1, -88)
	local logFrame = Modal.scroll(content, { Size = UDim2.new(1, 0, 1, -78) })
	Kit.list(Enum.FillDirection.Vertical, 8).Parent = logFrame
	Kit.new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 6), Parent = logFrame })
	local busy = false
	local function renderLog()
		Kit.clear(logFrame)
		local items = table.clone(log)
		if busy then
			table.insert(items, { me = false, text = "escribiendo…" })
		end
		for i, m in items do
			local holder: Frame = Kit.new("Frame", {
				BackgroundTransparency = 1,
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = UDim2.new(1, 0, 0, 0),
				LayoutOrder = i,
				Parent = logFrame,
			})
			-- .msg: máx 80%, padding 9/13, radius 16, 700 14.5; NPC lav a la izquierda, tú ink a la derecha
			Kit.new("TextLabel", {
				BackgroundColor3 = if m.me then Theme.ink else Theme.lav,
				TextColor3 = if m.me then Theme.white else Theme.ink,
				TextTransparency = if busy and i == #items then 0.4 else 0,
				FontFace = Theme.bodyBold,
				TextSize = 14.5,
				TextWrapped = true,
				Text = m.text,
				TextXAlignment = Enum.TextXAlignment.Left,
				AutomaticSize = Enum.AutomaticSize.XY,
				Size = UDim2.fromOffset(0, 0),
				AnchorPoint = Vector2.new(if m.me then 1 else 0, 0),
				Position = UDim2.fromScale(if m.me then 1 else 0, 0),
				Parent = holder,
			}, {
				Kit.corner(16),
				Kit.pad(13, 9),
				Kit.new("UISizeConstraint", { MaxSize = Vector2.new(390, 1000) }),
			})
		end
		task.defer(function()
			logFrame.CanvasPosition = Vector2.new(0, 1e6)
		end)
	end
	-- barra de escritura: input con borde lav2 3px + "Enviar" (purple)
	local bar: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -20),
		Size = UDim2.new(1, 0, 0, 44),
		Parent = content,
	})
	local input: TextBox = Kit.new("TextBox", {
		BackgroundColor3 = Theme.white,
		PlaceholderText = "Escribe algo…",
		PlaceholderColor3 = Theme.grey,
		Text = "",
		ClearTextOnFocus = false,
		FontFace = Theme.bodyBold,
		TextSize = 15,
		TextColor3 = Theme.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -100, 1, 0),
		Parent = bar,
	}, { Kit.corner(14), Kit.stroke(Theme.lav2, 3), Kit.pad(12, 0) })
	local send = Kit.button("Enviar", Theme.purple, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 90, 1, 0),
		Parent = bar,
	})
	Kit.text("Chat en modo offline (respuestas predefinidas).", 11, {
		FontFace = Theme.body,
		TextColor3 = GREY2,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 14),
		Parent = content,
	})
	local function sendChat()
		local text = string.sub((string.gsub(input.Text, "^%s+", "")), 1, 140)
		if text == "" or busy then
			return
		end
		input.Text = ""
		busy = true
		Audio.play("click")
		table.insert(log :: { ChatMsg }, { me = true, text = text })
		renderLog()
		local r = State.request("npcChat", { npc = name, text = text })
		busy = false
		if r.ok then
			local mine = log[#log]
			mine.text = r.mine or mine.text
			table.insert(log :: { ChatMsg }, { me = false, text = r.say })
			Audio.play("npc", nil, 0.35)
			if r.wantsTrade then
				local stroke = Kit.new("UIStroke", { Color = Theme.pink, Thickness = 0, Parent = tradeBtn })
				task.spawn(function()
					local t0 = os.clock()
					while os.clock() - t0 < 4 and stroke.Parent do
						stroke.Thickness = 0
						stroke.Transparency = 0.1
						Kit.tween(stroke, 1.1, { Thickness = 8, Transparency = 1 })
						task.wait(1.1)
					end
					stroke:Destroy()
				end)
			end
		else
			table.remove(log)
		end
		if Modal.current == "npc" then
			renderLog()
		end
	end
	send.Activated:Connect(sendChat)
	input.FocusLost:Connect(function(enter)
		if enter then
			sendChat()
		end
	end)
	renderLog()
	Audio.play("open")
	task.defer(function()
		input:CaptureFocus()
	end)
end

-- ─────────────── Jugador ↔ jugador (extra) ───────────────
local room: any = nil
local myIds: { string } = {}

local function renderRoom()
	local d = State.data
	if not room or not d or Modal.current ~= "tradeRoom" then
		return
	end
	local content = Trade.roomContent
	Kit.clear(content)
	local function total(items: { any }): number
		local v = 0
		for _, s in items do
			v += s.value
		end
		return v
	end
	local left = column(content, 0, 0.5)
	valueRow(
		left,
		1,
		"Tu oferta" .. (if room.me.confirmed then " ✅" elseif room.me.ready then " 👍" else ""),
		total(room.me.items)
	)
	slots(left, 2, room.me.items, 4, "Vacío", false)
	Kit.text("Elige hasta 6 squishies", 12, { TextColor3 = Theme.muted, LayoutOrder = 3, Parent = left })
	miniGrid(left, 4, d, myIds, 6, function(id)
		local at = table.find(myIds, id)
		if at then
			table.remove(myIds, at)
		else
			table.insert(myIds, id)
		end
		State.request("trade", { op = "set", ids = myIds })
	end)
	local right = column(content, 0.5, 0.5)
	valueRow(
		right,
		1,
		"Oferta de "
			.. room.them.name
			.. (if room.them.confirmed then " ✅" elseif room.them.ready then " 👍" else ""),
		total(room.them.items)
	)
	slots(right, 2, room.them.items, 4, "Esperando su oferta…", true)
	if room.phase == "confirm" then
		Kit.text("Revisen bien: al confirmar los dos, el cambio es definitivo.", 13, {
			FontFace = Theme.bodyBlack,
			TextColor3 = Theme.pinkD,
			LayoutOrder = 3,
			Parent = right,
		})
	end
	local foot: Frame = Kit.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(360, 50),
		Parent = content,
	}, { Kit.list(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right) })
	local cancel =
		Kit.button("Cancelar", Theme.white, { Size = UDim2.fromOffset(130, 46), LayoutOrder = 1, Parent = foot })
	cancel.Activated:Connect(function()
		State.request("trade", { op = "cancel" })
	end)
	if room.phase == "confirm" then
		local c = Kit.button(if room.me.confirmed then "Esperando…" else "Confirmar", Theme.mint, {
			Size = UDim2.fromOffset(180, 50),
			LayoutOrder = 2,
			Parent = foot,
		}, "big")
		Kit.setEnabled(c, not room.me.confirmed)
		c.Activated:Connect(function()
			State.request("trade", { op = "confirm" })
		end)
	else
		local r = Kit.button(if room.me.ready then "Quitar listo" else "¡Listo!", Theme.mint, {
			Size = UDim2.fromOffset(180, 50),
			LayoutOrder = 2,
			Parent = foot,
		}, "big")
		r.Activated:Connect(function()
			State.request("trade", { op = "ready", v = not room.me.ready })
		end)
	end
end

local function openPlayers()
	local content = Modal.open("tradePlayers", "Cambiar con jugadores", { width = 520, height = 480 })
	local sc = Modal.scroll(content)
	Kit.list(Enum.FillDirection.Vertical, 10).Parent = sc
	Kit.new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = sc })
	local others = 0
	for _, p in Players:GetPlayers() do
		if p ~= Players.LocalPlayer then
			others += 1
			local b = Kit.button(
				string.format("🤝  %s  <font color='#6d7285'>@%s</font>", p.DisplayName, p.Name),
				Theme.white,
				{ Size = UDim2.new(1, 0, 0, 46), Parent = sc }
			)
			b.Activated:Connect(function()
				local r = State.request("trade", { op = "request", userId = p.UserId })
				if r.ok then
					Toast.show("Solicitud enviada a " .. p.DisplayName)
					Modal.close()
				elseif r.err then
					Toast.show(r.err)
				end
			end)
		end
	end
	if others == 0 then
		Kit.text(
			"No hay otros jugadores en este servidor. ¡Invita a tus amigos! (o cambia con los jugadores de la Plaza de Intercambio)",
			14,
			{ TextColor3 = Theme.muted, Size = UDim2.new(1, 0, 0, 60), Parent = sc }
		)
	end
end

local function incomingRequest(from: number, name: string)
	Audio.play("npc")
	local card: Frame = Kit.new("Frame", {
		BackgroundColor3 = Theme.paper,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -180),
		Size = UDim2.fromOffset(340, 116),
		Parent = Kit.root(),
	}, { Kit.corner(18), Kit.pad(14, 12) })
	Kit.shadow(card, Color3.fromRGB(207, 208, 214), 5, 18)
	Kit.text(
		string.format("<b>%s</b> quiere intercambiar contigo 🤝", name),
		15,
		{ Size = UDim2.new(1, 0, 0, 44), Parent = card }
	)
	local yes = Kit.button(
		"Aceptar",
		Theme.mint,
		{ Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(0.5, -5, 0, 40), Parent = card }
	)
	local no = Kit.button(
		"No",
		Theme.white,
		{ Position = UDim2.new(0.5, 5, 1, -40), Size = UDim2.new(0.5, -5, 0, 40), Parent = card }
	)
	local function answer(v: boolean)
		if card.Parent then
			card:Destroy()
			local r = State.request("trade", { op = "respond", userId = from, accept = v })
			if not r.ok and r.err then
				Toast.show(r.err)
			end
		end
	end
	yes.Activated:Connect(function()
		answer(true)
	end)
	no.Activated:Connect(function()
		answer(false)
	end)
	task.delay(20, function()
		if card.Parent then
			answer(false)
		end
	end)
end

function Trade.init()
	Modal.addGuard(function()
		return if room then "Termina o cancela el intercambio primero" else nil
	end)
	Router.register("npcTrade", openNpcTrade)
	Router.register("npcChat", openChat)
	Router.register("tradePlayers", openPlayers)
	Remotes.event("TradeEvent").OnClientEvent:Connect(function(ev)
		if ev.t == "request" then
			incomingRequest(ev.from, ev.name)
		elseif ev.t == "state" then
			local first = room == nil
			room = ev
			myIds = {}
			for _, s in ev.me.items do
				table.insert(myIds, s.id)
			end
			if first or Modal.current ~= "tradeRoom" then
				Trade.roomContent = Modal.open("tradeRoom", "Cambio con " .. ev.them.name, {
					width = 960,
					height = 640,
					onClose = function()
						if room then
							room = nil
							State.request("trade", { op = "cancel" })
						end
					end,
				})
			end
			renderRoom()
		elseif ev.t == "closed" then
			room = nil
			if Modal.current == "tradeRoom" then
				Modal.close()
			end
			if ev.reason and ev.reason ~= "done" then
				Toast.show(ev.reason)
			end
		end
	end)
	State.onChange(function()
		renderRoom()
	end)
end

return Trade
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[--!strict
-- Tutorial de 5 pasos (Tut de game5.js) + marcador de guía (chevron rosado que gira y flota
-- sobre el objetivo + flecha en el piso que orbita al jugador apuntando al objetivo).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Quests = require(ReplicatedStorage.Shared.Logic.Quests)
local Toast = require(script.Parent.Parent.UI.Toast)
local Router = require(script.Parent.Router)
local State = require(script.Parent.State)

local Tutorial = {}
local L = Config.WorldLayout
local PINK = Color3.fromHex("#FF7BB5")

local guide: { key: string?, target: Vector3? } = { key = nil, target = nil }

-- zoneTarget(key) del original
local function zoneTarget(key: string): Vector3?
	if key == "machines" then
		local m = L.machines[1].pos
		return Vector3.new(m.X, 13, m.Z)
	elseif key == "shop" then
		return Vector3.new(L.shopCounter.X, 9, L.shopCounter.Z)
	elseif key == "trading" then
		local z = L.zones.trading.center
		return Vector3.new(z.X, 10, z.Z)
	elseif key == "collection" then
		return Vector3.new(0, 12, -76.9)
	end
	return nil
end

function Tutorial.guideTo(key: string?, msg: string?)
	guide.key = key
	guide.target = if key then zoneTarget(key) else nil
	if msg then
		Toast.show(msg)
	end
end

-- Punta de flecha "V" hecha con dos barras (2D, sin glifos): apunta hacia abajo de su contenedor.
local function chevronGui(parent: GuiObject, thickness: number)
	for side = -1, 1, 2 do
		local bar = Instance.new("Frame")
		bar.BackgroundColor3 = PINK
		bar.BorderSizePixel = 0
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Position = UDim2.fromScale(0.5 + side * 0.18, 0.45)
		bar.Size = UDim2.new(0.62, 0, 0, thickness)
		bar.Rotation = if side < 0 then 50 else -50
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = bar
		bar.Parent = parent
	end
end

function Tutorial.init()
	local folder = Instance.new("Folder")
	folder.Name = "Guide"
	folder.Parent = Workspace
	local function anchorPart(name: string): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = Vector3.new(1, 0.1, 1)
		p.Parent = folder
		return p
	end
	-- chevron sobre el objetivo (sube y baja)
	local chev = anchorPart("Chevron")
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(3.2, 3.2)
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.Enabled = false
	bb.Parent = chev
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	holder.Parent = bb
	chevronGui(holder, 16)
	-- flecha en el piso que orbita al jugador apuntando al objetivo
	local arrowPart = anchorPart("GroundArrow")
	arrowPart.Size = Vector3.new(2.2, 0.1, 2.2)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Top
	sg.LightInfluence = 0
	sg.CanvasSize = Vector2.new(200, 200)
	sg.Enabled = false
	sg.Parent = arrowPart
	local ah = Instance.new("Frame")
	ah.BackgroundTransparency = 1
	ah.Size = UDim2.fromScale(1, 1)
	ah.Rotation = 180 -- la "V" apunta hacia el frente de la parte
	ah.Parent = sg
	chevronGui(ah, 30)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local tg = guide.target
		local char = Players.LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not tg or not root then
			bb.Enabled = false
			sg.Enabled = false
			return
		end
		local p = root.Position
		local d = Vector2.new(p.X - tg.X, p.Z - tg.Z).Magnitude
		if d < 12 and guide.key ~= "machines" then
			guide.target = nil
			guide.key = nil
			return
		end
		chev.CFrame = CFrame.new(tg.X, tg.Y + math.sin(t * 3) * 0.8, tg.Z)
		bb.Enabled = true
		sg.Enabled = d > 14
		if d > 14 then
			local yaw = math.atan2(tg.X - p.X, tg.Z - p.Z)
			local fwd = Vector3.new(math.sin(yaw), 0, math.cos(yaw))
			local pos = Vector3.new(p.X, p.Y - 2.8, p.Z) + fwd * (4.2 + math.sin(t * 5) * 0.4)
			arrowPart.CFrame = CFrame.lookAt(pos, pos + fwd)
		end
	end)

	local shown = -1
	local startPos = L.spawn
	State.onChange(function(d)
		if d.tutorial == shown then
			return
		end
		local prev = shown
		shown = d.tutorial
		local s = d.tutorial
		if prev == -1 then
			if s == 0 then
				Toast.show("¡Bienvenido a Squishy World!", true, 3500)
				task.delay(1.2, function()
					Toast.show(
						"Hagamos tu primer squishy. Sigue la flecha rosada hasta las Máquinas. 🖐️ Por el camino, mantén clic sobre los squishies de la Vitrina Viral para apachurrarlos.",
						false,
						5500
					)
				end)
				Tutorial.guideTo("machines")
			else
				Toast.show("¡Bienvenido de vuelta a Squishy World!", true)
				local q = Quests.current(d.quest.i)
				if q.target and s < 5 then
					Tutorial.guideTo("machines")
				end
			end
			return
		end
		if s == 1 then
			Tutorial.guideTo("machines")
		elseif s == 3 then
			guide.target = nil
		elseif s == 5 then
			Toast.show("Tu squishy ya te sigue. ¡Mantén clic encima para apachurrarlo!", false, 4500)
			task.delay(2.8, function()
				Toast.show("Las misiones de la derecha dan monedas. ¡A jugar!")
			end)
			guide.target = nil
		end
	end)
	-- paso 0 → 1 cuando el jugador se mueve más de 4 del inicio
	task.spawn(function()
		while true do
			task.wait(0.5)
			local d = State.data
			local char = Players.LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if d and d.tutorial == 0 and root then
				local p = root.Position
				if Vector2.new(p.X - startPos.X, p.Z - startPos.Z).Magnitude > 4 then
					State.request("tutorial", { step = 1 })
				end
			elseif d and d.tutorial > 0 then
				break
			end
		end
	end)
	Router.register("tutorialEquip", function()
		Toast.show("¡Squishy nuevo! Ahora equípalo.", true, 3200)
		task.delay(1.4, function()
			Toast.show("Abre tu Inventario (I) y presiona Equipar.")
		end)
		Router.open("hudPulse", { key = "inventory", on = true })
	end)
end

return Tutorial
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="63">
          <Properties>
            <string name="Name">Engine</string>
          </Properties>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">SquishyFactory</string>
              <string name="Source"><![CDATA[--!strict
-- Construye el modelo 3D de un squishy a partir de sus datos (Fase 3, SYSTEMS_SPEC §4 / ASSETS.md).
-- Usa ReplicatedStorage.Models.Squishies.<species> (importado de assets/squishies) y recolorea
-- solo "Body" según la variante. Si el modelo aún no está importado, arma uno provisional.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Config = require(Shared.Config)

local SquishyFactory = {}

-- color base cuando la variante solo trae textura (para el look provisional o sin textura subida)
local TEX_COLOR: { [string]: string } = {
	cotton = "#FFC6E5",
	melon = "#FF6F7D",
	seeds = "#FF6F91",
	strawberry = "#FF6F91",
	drizzle = "#8A5A44",
	galaxy = "#3B2A78",
	lava = "#FF5A1F",
	rainbow = "#FFD36E",
	stars = "#EEF5FF",
	glitch = "#8A5CFF",
	checker = "#E0E0E0",
	sesame = "#E6A95C",
}

export type Look = {
	color: Color3,
	tex: string?,
	material: Enum.Material,
	transparency: number,
	glow: boolean,
	extra: string?,
	topper: string?,
}

function SquishyFactory.look(speciesId: string, variantId: string): Look
	local sp = Catalog.SP[speciesId] or {}
	local v: any = Catalog.VAR[variantId] or {}
	if variantId == "original" and sp.orig then
		v = sp.orig
	end
	local tex = v.tex
	local hexc = v.c or (tex and TEX_COLOR[tex]) or "#F3E3CC"
	local mat = Enum.Material.SmoothPlastic
	if (v.m or 0) >= 0.5 then
		mat = Enum.Material.Foil
	elseif (v.e or 0) >= 0.5 then
		mat = Enum.Material.Neon
	elseif v.opacity then
		mat = Enum.Material.Glass
	end
	return {
		color = Color3.fromHex(hexc),
		tex = tex,
		material = mat,
		transparency = if v.opacity then math.clamp(1 - v.opacity, 0, 0.6) else 0,
		glow = (v.e or 0) > 0,
		extra = v.extra,
		topper = v.topper,
	}
end

local function templateFor(speciesId: string): Model?
	local models = ReplicatedStorage:FindFirstChild("Models")
	local folder = models and models:FindFirstChild("Squishies")
	local m = folder and folder:FindFirstChild(speciesId)
	if m and m:IsA("Model") then
		return m
	end
	return nil
end

-- Esfera que SÍ se puede estirar en un eje (Part.Ball siempre queda redonda)
local function ball(name: string, size: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function placeholder(speciesId: string): Model
	local model = Instance.new("Model")
	model.Name = speciesId
	local sp = Catalog.SP[speciesId] or {}
	local body = ball("Body", if sp.famous then Vector3.new(2.3, 1.6, 2.3) else Vector3.new(2.2, 1.8, 2.2))
	body.Parent = model
	-- carita kawaii
	for _, x in { -0.38, 0.38 } do
		local eye = ball("Part_eye", Vector3.new(0.22, 0.26, 0.22))
		eye.Color = Color3.fromHex("#282D3A")
		eye.CFrame = body.CFrame * CFrame.new(x, 0.12, -body.Size.Z / 2 + 0.12)
		eye.Parent = model
	end
	local blushL = Instance.new("Part")
	blushL.Name = "Part_mouth"
	blushL.Size = Vector3.new(0.3, 0.08, 0.1)
	blushL.Color = Color3.fromHex("#E57AAE")
	blushL.CFrame = body.CFrame * CFrame.new(0, -0.18, -body.Size.Z / 2 + 0.06)
	blushL.Parent = model
	-- orejitas para los animales
	if speciesId == "cat" or speciesId == "bear" or speciesId == "bunny" then
		for _, x in { -0.6, 0.6 } do
			local ear = ball(
				"Part_ear",
				if speciesId == "bunny" then Vector3.new(0.4, 1.1, 0.3) else Vector3.new(0.55, 0.55, 0.4)
			)
			ear.CFrame = body.CFrame * CFrame.new(x, body.Size.Y / 2, 0)
			ear.Parent = model
			ear:SetAttribute("TintWithBody", true)
		end
	end
	model.PrimaryPart = body
	return model
end

local function findBody(model: Model): BasePart?
	local b = model:FindFirstChild("Body", true)
	if b and b:IsA("BasePart") then
		return b
	end
	return model:FindFirstChildWhichIsA("BasePart", true)
end

--- Pinta el Body con el look de la variante.
function SquishyFactory.paint(model: Model, speciesId: string, variantId: string)
	local body = findBody(model)
	if not body then
		return
	end
	local isImported = model:GetAttribute("Imported") == true
	-- los virales 'original' importados ya vienen pintados en el GLB
	if isImported and variantId == "original" then
		return
	end
	local look = SquishyFactory.look(speciesId, variantId)
	body.Color = look.color
	body.Material = look.material
	body.Transparency = look.transparency
	local texId = look.tex and (Config.AssetIds.textures :: any)[look.tex]
	if body:IsA("MeshPart") then
		local mp = body :: MeshPart
		mp.TextureID = if texId and texId ~= "" then texId else ""
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d:GetAttribute("TintWithBody") then
			d.Color = look.color
			d.Material = look.material
		end
	end
	if look.glow then
		local l = Instance.new("PointLight")
		l.Color = look.color
		l.Range = 6
		l.Brightness = 1.2
		l.Parent = body
	end
	local _, size = model:GetBoundingBox()
	if look.extra == "halo" then
		local halo = Instance.new("Part")
		halo.Name = "Part_halo"
		halo.Shape = Enum.PartType.Cylinder
		halo.Size = Vector3.new(0.12, size.X * 0.55, size.X * 0.55)
		halo.Color = Color3.fromHex("#FFD86B")
		halo.Material = Enum.Material.Neon
		halo.CFrame = model:GetPivot() * CFrame.new(0, size.Y * 0.62, 0) * CFrame.Angles(0, 0, math.rad(90))
		halo.Parent = model
	elseif look.extra == "aura" then
		local h = Instance.new("Highlight")
		h.FillColor = Color3.fromHex("#8A5CFF")
		h.FillTransparency = 0.8
		h.OutlineColor = Color3.fromHex("#B999E8")
		h.Parent = model
	elseif look.extra == "puffs" then
		for i = 1, 3 do
			local puff = Instance.new("Part")
			puff.Name = "Part_puff"
			puff.Shape = Enum.PartType.Ball
			puff.Size = Vector3.one * (0.5 + i * 0.1)
			puff.Color = Color3.new(1, 1, 1)
			local a = i * 2.1
			puff.CFrame = model:GetPivot()
				* CFrame.new(math.cos(a) * size.X * 0.45, -size.Y * 0.3, math.sin(a) * size.Z * 0.45)
			puff.Parent = model
		end
	end
	if look.topper == "leaf" then
		local leaf = Instance.new("Part")
		leaf.Name = "Part_leaf"
		leaf.Size = Vector3.new(0.9, 0.12, 0.5)
		leaf.Color = Color3.fromHex("#5CC46C")
		leaf.CFrame = model:GetPivot() * CFrame.new(0, size.Y * 0.5, 0)
		leaf.Parent = model
	elseif look.topper == "drip" then
		local drip = Instance.new("Part")
		drip.Name = "Part_drip"
		drip.Shape = Enum.PartType.Ball
		drip.Size = Vector3.new(size.X * 0.7, 0.35, size.Z * 0.7)
		drip.Color = Color3.fromHex("#F2B33D")
		drip.Material = Enum.Material.Glass
		drip.CFrame = model:GetPivot() * CFrame.new(0, size.Y * 0.45, 0)
		drip.Parent = model
	end
end

export type BuildData = {
	species: string,
	variant: string,
	mutation: string?,
	size: number?,
	rarity: string?,
}

--- Modelo listo (anclado, sin colisión). scale extra opcional (p. ej. estatua).
function SquishyFactory.build(d: BuildData, extraScale: number?): Model
	local tpl = templateFor(d.species)
	local model: Model
	if tpl then
		model = tpl:Clone()
		model:SetAttribute("Imported", true)
	else
		model = placeholder(d.species)
	end
	model.Name = "Squishy_" .. d.species
	for _, p in model:GetDescendants() do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
			p.CastShadow = true
			p.Massless = true
		end
	end
	if not model.PrimaryPart then
		model.PrimaryPart = findBody(model)
	end
	SquishyFactory.paint(model, d.species, d.variant)
	local mut = Catalog.MUT[d.mutation or "normal"]
	local scale = (d.size or 1) * ((mut and mut.size) or 1) * (extraScale or 1)
	if math.abs(scale - 1) > 0.001 then
		model:ScaleTo(scale)
	end
	if d.mutation == "shiny" then
		local body = findBody(model)
		if body then
			local s = Instance.new("Sparkles")
			s.SparkleColor = Color3.fromHex("#FFF3B8")
			s.Parent = body
		end
	end
	model:SetAttribute("Squishy", true)
	return model
end

--- Altura del modelo (para apoyarlo en el piso).
function SquishyFactory.height(model: Model): number
	local _, size = model:GetBoundingBox()
	return size.Y
end

return SquishyFactory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Thumb</string>
              <string name="Source"><![CDATA[--!strict
-- Miniaturas con ViewportFrame (encuadre por medidas del modelo), como Thumbs.get() del prototipo.
local SquishyFactory = require(script.Parent.SquishyFactory)

local Thumb = {}

--- Llena `parent` con un ViewportFrame del squishy. silhouette = "???" del Índice.
function Thumb.make(d: SquishyFactory.BuildData, parent: GuiObject, silhouette: boolean?): ViewportFrame
	local vf = Instance.new("ViewportFrame")
	vf.Name = "Thumb"
	vf.BackgroundTransparency = 1
	vf.Size = UDim2.fromScale(1, 1)
	vf.Ambient = Color3.fromRGB(200, 195, 210)
	vf.LightColor = Color3.new(1, 1, 1)
	vf.LightDirection = Vector3.new(-0.4, -1, -0.6)
	local model = SquishyFactory.build({ species = d.species, variant = d.variant, mutation = "normal", size = 1 })
	model:PivotTo(CFrame.new())
	if silhouette then
		for _, p in model:GetDescendants() do
			if p:IsA("BasePart") then
				p.Color = Color3.fromHex("#C9C4D8")
				p.Material = Enum.Material.SmoothPlastic
				if p:IsA("MeshPart") then
					(p :: MeshPart).TextureID = ""
				end
			elseif p:IsA("Light") or p:IsA("Sparkles") or p:IsA("Highlight") then
				p:Destroy()
			end
		end
	end
	model.Parent = vf
	local cf, size = model:GetBoundingBox()
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	local r = math.max(size.X, size.Y, size.Z)
	local dist = r * 2.1
	local focus = cf.Position
	cam.CFrame = CFrame.lookAt(focus + Vector3.new(dist * 0.25, dist * 0.35, -dist), focus)
	cam.Parent = vf
	vf.CurrentCamera = cam
	vf.Parent = parent
	return vf
end

return Thumb
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="66">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--!strict
-- Punto de entrada del cliente.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local State = require(Controllers.State)
local Audio = require(Controllers.Audio)
local Toast = require(UI.Toast)
local Hud = require(Controllers.Hud)
local Dialog = require(Controllers.Dialog)
local Machine = require(Controllers.Machine)
local Reveal = require(Controllers.Reveal)
local Inventory = require(Controllers.Inventory)
local Shop = require(Controllers.Shop)
local Index = require(Controllers.Index)
local Trade = require(Controllers.Trade)
local Interact = require(Controllers.Interact)
local Companion = require(Controllers.Companion)
local Squish = require(Controllers.Squish)
local Tutorial = require(Controllers.Tutorial)
local Controls = require(Controllers.Controls)
local Router = require(Controllers.Router)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

State.init()
Controls.init()
Audio.init()
Toast.init()
Hud.init()
Dialog.init()
Machine.init()
Reveal.init()
Inventory.init()
Shop.init()
Index.init()
Trade.init()
Companion.init()
Squish.init()
Tutorial.init()
task.spawn(Interact.init)

-- Pendientes (fases 8 y 10): por ahora avisan en vez de fallar en silencio
Router.register("studio", function()
	Toast.show(
		"🖐️ El Estudio Squish (ver de cerca) llega en la Fase 8. ¡Por ahora mantén clic sobre el squishy!"
	)
end)
Router.register("tour", function()
	Toast.show("🎬 El Tour de bienvenida llega en la Fase 10")
end)

print("[Squishy World] Cliente listo —", #Config.Species, "moldes cargados")
-- TODO Fase 7: manos que rodean el contorno + EditableMesh (DeformEngine), apuntar, fantasma
-- TODO Fase 8–10: Estudio Squish, Cera de vela, Tour de bienvenida
]]></string>
