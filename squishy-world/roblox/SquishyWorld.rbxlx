      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Catalog</string>
            <string name="Source"><![CDATA[--!strict
-- Índices rápidos sobre Config (equivalen a SP, R, VAR, FIL, MUT, variantsFor del prototipo).
local Config = require(script.Parent.Parent.Config)

local Catalog = {}

Catalog.SP = {} :: { [string]: any }
for _, s in Config.Species do
	Catalog.SP[s.id] = s
end

Catalog.R = {} :: { [string]: any }
Catalog.RTier = {} :: { [string]: number } -- 0 = Común … 5 = Secreto
for i, r in Config.Rarities do
	Catalog.R[r.id] = r
	Catalog.RTier[r.id] = i - 1
end

Catalog.VAR = {} :: { [string]: any }
for rarity, list in Config.Variants :: any do
	for _, v in list do
		v.rarity = rarity
		Catalog.VAR[v.id] = v
	end
end
-- look clásico de los virales (solo rareza común)
Catalog.VAR.original = { id = "original", name = "Original", rarity = "common", famousOnly = true }

Catalog.FIL = {} :: { [string]: any }
for _, f in Config.Fillings do
	Catalog.FIL[f.id] = f
end

Catalog.MUT = {} :: { [string]: any }
for _, m in Config.Mutations do
	Catalog.MUT[m.id] = m
end

local RARITY_ORDER = { "common", "uncommon", "rare", "epic", "legendary", "secret" }

function Catalog.variantsFor(speciesId: string): { string }
	local sp = Catalog.SP[speciesId]
	local out = {}
	if sp and sp.famous then
		table.insert(out, "original")
		for i = 2, #RARITY_ORDER do
			for _, v in (Config.Variants :: any)[RARITY_ORDER[i]] do
				table.insert(out, v.id)
			end
		end
	else
		for _, rid in RARITY_ORDER do
			for _, v in (Config.Variants :: any)[rid] do
				table.insert(out, v.id)
			end
		end
	end
	return out
end

function Catalog.indexTotal(): number
	local n = 0
	for _, s in Config.Species do
		n += #Catalog.variantsFor(s.id)
	end
	return n -- debe dar 413
end

return Catalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[--!strict
-- Perfil del jugador: estado inicial (freshState() de game4.js) y migraciones.
local Config = require(script.Parent.Parent.Config)
local Catalog = require(script.Parent.Catalog)
local Squishy = require(script.Parent.Squishy)
local Types = require(script.Parent.Parent.Types)

local Profile = {}

Profile.VERSION = 1

function Profile.fresh(): Types.PlayerData
	local START = Config.Game.START
	return {
		version = Profile.VERSION,
		coins = START.coins,
		xp = 0,
		level = START.level,
		inventory = {},
		equipped = nil,
		fillings = { "classic_foam", "pink_foam", "blue_foam" },
		molds = { "butter" },
		upgrades = { fillSpeed = 1, luck = 0, storage = 0 },
		discovered = {},
		quest = { i = 1, p = 0 },
		stats = { fills = 0, perfect = 0, sold = 0, trades = 0, squishes = 0, bestRise = 0, waxCracked = 0 },
		tutorial = 0,
		tourSeen = false,
		tipSquish = false,
		muted = false,
		lastMold = "cat",
		lastFill = "pink_foam",
		firstDone = false,
		luckUntil = 0,
		legendFills = 0,
		receipts = {},
		robuxSpent = 0,
		pending = nil,
	}
end

--- Completa campos que falten (datos viejos) y corrige ids desconocidos, como loadGame() del prototipo.
function Profile.migrate(raw: any): Types.PlayerData
	local fresh: any = Profile.fresh()
	if type(raw) ~= "table" then
		return fresh
	end
	local d: any = raw
	for k, v in fresh do
		if d[k] == nil then
			d[k] = v
		end
	end
	for k, v in fresh.upgrades do
		if type(d.upgrades[k]) ~= "number" then
			d.upgrades[k] = v
		end
	end
	for k, v in fresh.stats do
		if type(d.stats[k]) ~= "number" then
			d.stats[k] = v
		end
	end
	if not table.find(d.molds, "butter") then
		table.insert(d.molds, "butter")
	end
	for _, q in d.inventory do
		if not Catalog.SP[q.species] then
			q.species = "cat"
		end
		if not Catalog.VAR[q.variant] then
			q.variant = "classic"
		end
		q.name = Squishy.name(q)
	end
	d.version = Profile.VERSION
	return d :: Types.PlayerData
end

function Profile.idxKey(d: { species: string, variant: string }): string
	return d.species .. "|" .. d.variant
end

function Profile.discoveredCount(d: Types.PlayerData): number
	local n = 0
	for _ in d.discovered do
		n += 1
	end
	return n
end

function Profile.baseCapacity(d: Types.PlayerData): number
	return Config.Upgrades.storage.caps[d.upgrades.storage + 1]
end

function Profile.moldAvailable(d: Types.PlayerData, speciesId: string): boolean
	local sp = Catalog.SP[speciesId]
	if not sp then
		return false
	end
	if sp.famous then
		return table.find(d.molds, speciesId) ~= nil
	end
	return d.level >= sp.unlockLevel
end

function Profile.find(d: Types.PlayerData, id: string): (Types.SquishyData?, number?)
	for i, s in d.inventory do
		if s.id == id then
			return s, i
		end
	end
	return nil, nil
end

return Profile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[--!strict
-- Misiones (porte de currentQuest() en game5.js). Índice 1-based en Luau: quest.i = 1 es la primera.
local Config = require(script.Parent.Parent.Config)

export type Quest = { id: string, title: string, goal: number, ev: string, reward: number, target: string? }

local Quests = {}

function Quests.current(i: number): Quest
	local list = Config.Quests
	if i <= #list then
		return list[i] :: Quest
	end
	-- cadena infinita: "Llena N squishies", N = 5 + k·5, premio 500 + k·250
	local k = i - #list
	return {
		id = "loop" .. k,
		title = string.format("Llena %d squishies", 5 + k * 5),
		goal = 5 + k * 5,
		ev = "fill",
		reward = 500 + k * 250,
		target = "machines",
	}
end

return Quests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">SelfTest</string>
            <string name="Source"><![CDATA[--!strict
-- Pruebas rápidas de la lógica pura. Se corren al arrancar el servidor si Config.Game.DEBUG.
local Config = require(script.Parent.Parent.Config)
local Catalog = require(script.Parent.Catalog)
local Squishy = require(script.Parent.Squishy)

return function()
	local ok = true
	local function check(cond: boolean, msg: string)
		if not cond then
			ok = false
			warn("[SelfTest] FALLA: " .. msg)
		end
	end
	check(#Config.Species == 18, "18 especies")
	check(#Config.Rarities == 6, "6 rarezas")
	check(Catalog.indexTotal() == 413, "índice = 413 (dio " .. Catalog.indexTotal() .. ")")
	check(Squishy.xpNeed(1) == 50 and Squishy.xpNeed(3) == 110, "xpNeed")
	check(
		Squishy.name({ species = "butter", variant = "original", mutation = "normal" }) == "Barra de Mantequilla",
		"nombre viral original"
	)
	check(
		Squishy.name({ species = "cat", variant = "bubblegum", mutation = "shiny" }) == "Gato Chicle Brillante",
		"nombre con mutación"
	)
	-- distribución de rarezas con suerte 0
	local rng = Random.new(42)
	local counts = {}
	local N = 100000
	for _ = 1, N do
		local d = Squishy.generate(rng, "cat", "classic_foam", 0)
		counts[d.rarity] = (counts[d.rarity] or 0) + 1
	end
	for _, r in Config.Rarities do
		local got = (counts[r.id] or 0) / N
		check(math.abs(got - r.p) < math.max(0.004, r.p * 0.15), string.format("prob %s: %.4f vs %.4f", r.id, got, r.p))
	end
	-- llenado: ventana de PERFECTO con velocidad 1 (sirve de referencia para animar el medidor)
	local t0, t1 = nil, nil
	for i = 1, 400 do
		local t = i / 100
		local res = Squishy.fillResult(Squishy.fillProgress(t, 1))
		if res == "perfect" then
			t0 = t0 or t
			t1 = t
		end
	end
	check(t0 ~= nil, "existe ventana PERFECTO")
	print(string.format("[SelfTest] Ventana PERFECTO (velocidad 1): %.2f s → %.2f s", t0 or -1, t1 or -1))
	print(ok and "[SelfTest] ✅ todo bien" or "[SelfTest] ❌ hay fallas (ver warnings)")
	return ok
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Squishy</string>
            <string name="Source"><![CDATA[--!strict
-- Reglas puras de generación de squishies (porte exacto de game4.js / game2.js).
-- No toca Instances: se puede usar en servidor (autoridad) y en cliente (vista previa).
local Config = require(script.Parent.Parent.Config)
local Catalog = require(script.Parent.Catalog)
local Types = require(script.Parent.Parent.Types)

local Squishy = {}
local LUCK_TIER_BOOST = (Config.Game :: any).LUCK_TIER_BOOST

--- Suerte total de un llenado (SYSTEMS_SPEC §4)
function Squishy.totalLuck(upgradeLuck: number, machine: any?, fillingId: string, fillResult: Types.FillResult?): number
	local fil = Catalog.FIL[fillingId] or {}
	local L = upgradeLuck * 0.06 + (machine and machine.luck or 0) + (fil.luck or 0)
	if fillResult == "perfect" then
		L += 0.25
	elseif fillResult == "under" then
		L -= 0.15
	elseif fillResult == "over" then
		L -= 0.1
	end
	return math.max(0, L)
end

function Squishy.rarityWeights(L: number, fillingId: string): { number }
	local fil = Catalog.FIL[fillingId] or {}
	local w = {}
	for i, r in Config.Rarities do
		local x = r.p * (1 + L * LUCK_TIER_BOOST[i])
		if r.id == "secret" and fil.secretX then
			x *= fil.secretX
		end
		w[i] = x
	end
	return w
end

local function weightedIndex(rng: Random, weights: { number }): number
	local tot = 0
	for _, x in weights do
		tot += x
	end
	local r = rng:NextNumber() * tot
	for i, x in weights do
		r -= x
		if r <= 0 then
			return i
		end
	end
	return #weights
end

local function pick<T>(rng: Random, list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

function Squishy.value(d: any): number
	local sp, r, m = Catalog.SP[d.species], Catalog.R[d.rarity], Catalog.MUT[d.mutation]
	return math.round(sp.baseValue * r.mult * (m and m.mult or 1) * (d.size or 1))
end

--- "Gato Chicle Brillante", "Barra de Mantequilla", "Dona Glaseada Oro"
function Squishy.name(d: any): string
	local sp = Catalog.SP[d.species] or Catalog.SP.cat
	local v, m = Catalog.VAR[d.variant], Catalog.MUT[d.mutation]
	local n = sp.name
	if not (sp.famous and d.variant == "original") and v then
		n ..= " " .. v.name
	end
	if m and m.name and m.id ~= "normal" and m.name ~= "" then
		n ..= " " .. m.name
	end
	return n
end

export type GenOpts = { rarity: string?, variant: string?, mutation: string?, face: string?, machine: any? }

--- Genera un squishy nuevo. rng = Random.new() del servidor.
function Squishy.generate(
	rng: Random,
	speciesId: string,
	fillingId: string,
	L: number,
	opts: GenOpts?
): Types.SquishyData
	local o: GenOpts = opts or {}
	local rarity = o.rarity
	if not rarity then
		rarity = Config.Rarities[weightedIndex(rng, Squishy.rarityWeights(L, fillingId))].id
	end
	local fil = Catalog.FIL[fillingId] or {}
	local sp = Catalog.SP[speciesId]
	local variant = o.variant
	if not variant and sp and sp.famous and rarity == "common" then
		variant = "original"
	end
	if not variant then
		local pool = (Config.Variants :: any)[rarity]
		local biased = {}
		for _, v in pool do
			if fil.bias and table.find(fil.bias, v.id) then
				table.insert(biased, v)
			end
		end
		local chosen = (#biased > 0 and rng:NextNumber() < 0.55) and pick(rng, biased) or pick(rng, pool)
		variant = chosen.id
	end
	local mutation = o.mutation
	if not mutation then
		local mx = (o.machine and o.machine.mutX) or 1
		local w = {}
		for i, m in Config.Mutations do
			w[i] = m.id == "normal" and m.p or m.p * mx * ((fil.mut and fil.mut[m.id]) or 1)
		end
		mutation = Config.Mutations[weightedIndex(rng, w)].id
	end
	local faces = { "happy", "happy", "happy", "wink", "sleepy", "surprised" }
	local d: any = {
		id = game:GetService("HttpService"):GenerateGUID(false),
		species = speciesId,
		rarity = rarity,
		variant = variant,
		filling = fillingId,
		mutation = mutation,
		face = o.face or pick(rng, faces),
		size = math.round((0.95 + rng:NextNumber() * 0.13) * 100) / 100,
		dateFound = os.time(),
		fav = false,
	}
	d.value = Squishy.value(d)
	d.name = Squishy.name(d)
	return d :: Types.SquishyData
end

function Squishy.xpNeed(level: number): number
	return 50 + (level - 1) * 30
end

--- Resultado del llenado a partir de p (SYSTEMS_SPEC §3). nil = todavía no cuenta.
function Squishy.fillResult(p: number): (Types.FillResult?, boolean)
	local F = Config.Game.FILL
	if p >= F.pop then
		return nil, true
	end
	if p < F.minCommit then
		return nil, false
	end
	if p < F.perfect[1] then
		return "under", false
	end
	if p <= F.perfect[2] then
		return "perfect", false
	end
	return "over", false
end

--- p después de mantener `held` segundos (integración de p += dt/time·(1 + 0.35p) a 120 Hz)
function Squishy.fillProgress(held: number, fillSpeedLevel: number): number
	local time = Config.Game.FILL.baseTime / (1 + 0.2 * (fillSpeedLevel - 1))
	local p, dt = 0, 1 / 120
	local t = 0
	while t < held do
		p += dt / time * (1 + p * 0.35)
		t += dt
	end
	return p
end

return Squishy
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Remotes del juego (ver docs/ROBLOX_ARCHITECTURE.md §3).
-- Un solo RemoteFunction "Request" (acción + payload) para todo lo que el cliente pide: así el
-- servidor valida y limita la frecuencia en un solo lugar (server/Services/Net.luau).
-- El servidor los crea con Remotes.init(); el cliente los obtiene con Remotes.get(nombre).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

-- C→S: Request(action, payload) → respuesta { ok: boolean, err: string?, ... }
local FUNCTIONS = { "Request" }
-- S→C: DataSync(perfil), Notify({ t = "toast"|"sound"|..., ... }), TradeEvent(estado del intercambio)
local EVENTS = { "DataSync", "Notify", "TradeEvent" }
-- C→S→C: "estoy apachurrando a X" para que los demás lo vean (baja fidelidad)
local UNRELIABLE = { "SquishBroadcast" }

local Remotes = {}

local function folder(): Folder
	local f = ReplicatedStorage:FindFirstChild("Remotes")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Remotes"
		f.Parent = ReplicatedStorage
	end
	return f :: Folder
end

local function ensure(f: Folder, className: string, name: string)
	if not f:FindFirstChild(name) then
		local r = Instance.new(className)
		r.Name = name
		r.Parent = f
	end
end

function Remotes.init()
	assert(RunService:IsServer(), "Remotes.init solo en el servidor")
	local f = folder()
	for _, n in FUNCTIONS do
		ensure(f, "RemoteFunction", n)
	end
	for _, n in EVENTS do
		ensure(f, "RemoteEvent", n)
	end
	for _, n in UNRELIABLE do
		ensure(f, "UnreliableRemoteEvent", n)
	end
end

function Remotes.get(name: string): Instance
	local f = ReplicatedStorage:WaitForChild("Remotes")
	return f:WaitForChild(name)
end

function Remotes.event(name: string): RemoteEvent
	return Remotes.get(name) :: RemoteEvent
end

function Remotes.func(name: string): RemoteFunction
	return Remotes.get(name) :: RemoteFunction
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Tipos compartidos. Mismo formato de datos que el prototipo (ver docs/ROBLOX_ARCHITECTURE.md §4).

export type WaxLayer = { c: string, s: number, b: { number } }
export type WaxState = { list: { WaxLayer } }

export type SquishyData = {
	id: string,
	species: string,
	rarity: string,
	variant: string,
	filling: string,
	mutation: string,
	face: string,
	size: number,
	value: number,
	name: string,
	dateFound: number,
	fav: boolean,
	wax: WaxState?,
}

export type PlayerData = {
	version: number,
	coins: number,
	xp: number,
	level: number,
	inventory: { SquishyData },
	equipped: string?,
	fillings: { string },
	molds: { string },
	upgrades: { fillSpeed: number, luck: number, storage: number },
	discovered: { [string]: boolean },
	quest: { i: number, p: number },
	stats: { [string]: number },
	tutorial: number,
	tourSeen: boolean,
	tipSquish: boolean,
	muted: boolean,
	lastMold: string,
	lastFill: string,
	firstDone: boolean,
	-- monetización (ver Config/Monetization.luau)
	luckUntil: number, -- os.time() hasta cuando dura la Poción de Suerte
	legendFills: number, -- llenados Legendarios garantizados pendientes (producto "Molde de Oro")
	receipts: { string }, -- últimos PurchaseId procesados (evita dar dos veces la misma compra)
	robuxSpent: number,
	-- squishy que salió de la máquina y espera Guardar / Vender
	pending: SquishyData?,
}

export type FillResult = "under" | "perfect" | "over"

-- Lo que el servidor le manda al cliente en DataSync
export type ProfileView = PlayerData & {
	capacity: number,
	passes: { [string]: boolean },
	luckLeft: number,
	serverTime: number,
}

return {}
]]></string>
        </Properties>
