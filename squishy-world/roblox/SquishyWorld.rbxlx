          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Punto de entrada del servidor.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Catalog = require(Shared.Logic.Catalog)

Remotes.init()
print(
	string.format(
		"[Squishy World] Config cargada: %d especies, %d rarezas, %d rellenos, índice %d",
		#Config.Species,
		#Config.Rarities,
		#Config.Fillings,
		Catalog.indexTotal()
	)
)

if Config.Game.DEBUG then
	require(Shared.Logic.SelfTest)()
end

local Services = script.Parent:WaitForChild("Services")
local Net = require(Services.Net)
local DataService = require(Services.DataService)
local Economy = require(Services.Economy)
local MonetizationService = require(Services.MonetizationService)
local InventoryService = require(Services.InventoryService)
local FillService = require(Services.FillService)
local ShopService = require(Services.ShopService)
local TradeService = require(Services.TradeService)
local WorldBuilder = require(Services.WorldBuilder)
local NpcService = require(Services.NpcService)

WorldBuilder.build()
Net.init()
Economy.init()
MonetizationService.init()
InventoryService.init()
FillService.init()
ShopService.init()
TradeService.init()
NpcService.init()
DataService.init() -- al final: así todos los onLoaded ya están registrados

print("[Squishy World] Servidor listo ✅")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Guardado del perfil (DataStore) con bloqueo de sesión, autoguardado y migración.
-- Esquema: docs/ROBLOX_ARCHITECTURE.md §4 (Types.PlayerData). Clave: "u_<UserId>".
-- En Studio sin "Enable Studio Access to API Services" usa un perfil en memoria (no se guarda).
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Profile = require(Shared.Logic.Profile)
local Remotes = require(Shared.Remotes)
local Types = require(Shared.Types)

local DataService = {}

local STORE_NAME = "SquishyWorld_v1"
local AUTOSAVE_EVERY = 60
local LOCK_EXPIRE = 60 * 10 -- un servidor caído suelta el candado a los 10 min
local MAX_RECEIPTS = 60

type Entry = {
	data: Types.PlayerData,
	loaded: boolean,
	dirty: boolean,
	syncQueued: boolean,
	offline: boolean,
	savedReceipts: { [string]: boolean }, -- recibos que YA están en el DataStore
}

local entries: { [Player]: Entry } = {}
local loadedCallbacks: { (Player, Types.PlayerData) -> () } = {}
local viewProviders: { (Player, { [string]: any }) -> () } = {}
local releasingCallbacks: { (Player, Types.PlayerData) -> () } = {}

local store: DataStore? = nil
do
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = res
	else
		warn("[DataService] DataStore no disponible (¿Studio sin acceso a API?). Se juega sin guardar:", res)
	end
end

local jobId = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))

local function key(player: Player): string
	return "u_" .. player.UserId
end

local function retry<T>(fn: () -> T, tries: number): (boolean, any)
	local ok, res = false, nil
	for i = 1, tries do
		ok, res = pcall(fn)
		if ok then
			return true, res
		end
		task.wait(math.min(8, 1.5 ^ i))
	end
	return false, res
end

-- Carga con candado: si otro servidor lo tiene reciente, reintenta; si está vencido, lo toma.
local function loadRaw(player: Player): (boolean, any, boolean)
	local s = store
	if not s then
		return true, nil, true
	end
	for attempt = 1, 6 do
		local blocked = false
		local ok, res = pcall(function()
			return s:UpdateAsync(key(player), function(old: any)
				old = old or {}
				local lock = old.lock
				if lock and lock.job ~= jobId and os.time() - (lock.t or 0) < LOCK_EXPIRE then
					blocked = true
					return nil -- no escribir
				end
				old.lock = { job = jobId, t = os.time() }
				return old
			end)
		end)
		if ok and not blocked then
			return true, res and res.data or nil, false
		end
		if not ok then
			warn("[DataService] error cargando", player.Name, res)
			if RunService:IsStudio() then
				-- lugar publicado pero sin "Studio Access to API Services": jugar sin guardar
				warn("[DataService] Studio sin acceso a DataStore: se juega sin guardar")
				return true, nil, true
			end
		end
		if attempt == 6 and blocked then
			-- último intento: robar el candado (el otro servidor probablemente murió)
			local ok2, res2 = pcall(function()
				return s:UpdateAsync(key(player), function(old: any)
					old = old or {}
					old.lock = { job = jobId, t = os.time() }
					return old
				end)
			end)
			if ok2 then
				return true, res2 and res2.data or nil, false
			end
		end
		task.wait(attempt * 1.5)
	end
	return false, nil, false
end

local function saveRaw(player: Player, e: Entry, release: boolean): boolean
	local s = store
	if e.offline or not s then
		return true
	end
	local data = e.data
	-- recortar recibos viejos (solo se necesitan los últimos para no dar dos veces la misma compra)
	while #data.receipts > MAX_RECEIPTS do
		table.remove(data.receipts, 1)
	end
	local rejected = false
	local snapshot = table.clone(data.receipts)
	local ok, err = retry(function()
		rejected = false
		return s:UpdateAsync(key(player), function(old: any)
			old = old or {}
			if old.lock and old.lock.job ~= jobId and os.time() - (old.lock.t or 0) < LOCK_EXPIRE then
				rejected = true
				return nil -- otro servidor se lo quedó: no pisar sus datos
			end
			old.data = data
			old.lock = if release then nil else { job = jobId, t = os.time() }
			return old
		end)
	end, 3)
	if not ok then
		warn("[DataService] no se pudo guardar", player.Name, err)
		return false
	end
	if rejected then
		warn("[DataService] otro servidor tiene el candado de", player.Name, "— no se guardó")
		return false
	end
	e.dirty = false
	for _, r in snapshot do
		e.savedReceipts[r] = true
	end
	return true
end

local function buildView(player: Player, e: Entry): { [string]: any }
	local view: { [string]: any } = table.clone(e.data :: any)
	view.receipts = nil
	view.serverTime = os.time()
	for _, fn in viewProviders do
		fn(player, view)
	end
	return view
end

--- Llamar cuando cambia algo del perfil: marca para guardar y manda DataSync (agrupado por frame).
function DataService.changed(player: Player)
	local e = entries[player]
	if not e or not e.loaded then
		return
	end
	e.dirty = true
	if e.syncQueued then
		return
	end
	e.syncQueued = true
	task.defer(function()
		e.syncQueued = false
		if entries[player] == e and player.Parent then
			Remotes.event("DataSync"):FireClient(player, buildView(player, e))
		end
	end)
end

function DataService.get(player: Player): Types.PlayerData?
	local e = entries[player]
	return if e and e.loaded then e.data else nil
end

function DataService.isLoaded(player: Player): boolean
	local e = entries[player]
	return e ~= nil and e.loaded
end

function DataService.waitFor(player: Player, timeout: number?): Types.PlayerData?
	local t0 = os.clock()
	while player.Parent and os.clock() - t0 < (timeout or 30) do
		local d = DataService.get(player)
		if d then
			return d
		end
		task.wait(0.1)
	end
	return nil
end

--- ¿Este recibo ya quedó guardado en el DataStore? (offline = siempre sí)
function DataService.receiptSaved(player: Player, purchaseId: string): boolean
	local e = entries[player]
	if not e then
		return false
	end
	return e.offline or store == nil or e.savedReceipts[purchaseId] == true
end

--- Guarda ya (se usa después de una compra con Robux antes de confirmar el recibo).
function DataService.saveNow(player: Player): boolean
	local e = entries[player]
	if not e or not e.loaded then
		return false
	end
	return saveRaw(player, e, false)
end

function DataService.onLoaded(fn: (Player, Types.PlayerData) -> ())
	table.insert(loadedCallbacks, fn)
	for p, e in entries do
		if e.loaded then
			task.spawn(fn, p, e.data)
		end
	end
end

--- Antes de soltar el perfil (el jugador se va): p. ej. guardar el squishy pendiente de la máquina.
function DataService.onReleasing(fn: (Player, Types.PlayerData) -> ())
	table.insert(releasingCallbacks, fn)
end

--- Permite a otros servicios agregar campos calculados al DataSync (capacidad, pases…).
function DataService.addViewProvider(fn: (Player, { [string]: any }) -> ())
	table.insert(viewProviders, fn)
end

local function onPlayerAdded(player: Player)
	local ok, raw, offline = loadRaw(player)
	if not player.Parent then
		-- se fue mientras cargaba: soltar el candado sin tocar sus datos
		local s = store
		if ok and not offline and s then
			pcall(function()
				s:UpdateAsync(key(player), function(old: any)
					if old and old.lock and old.lock.job == jobId then
						old.lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return
	end
	if not ok then
		player:Kick("No pudimos cargar tus datos. Vuelve a entrar en un momento 🙏")
		return
	end
	local e: Entry = {
		data = Profile.migrate(raw),
		loaded = true,
		dirty = false,
		syncQueued = false,
		offline = offline,
		savedReceipts = {},
	}
	for _, r in e.data.receipts do
		e.savedReceipts[r] = true
	end
	entries[player] = e
	for _, fn in loadedCallbacks do
		task.spawn(fn, player, e.data)
	end
	DataService.changed(player)
end

local function onPlayerRemoving(player: Player)
	local e = entries[player]
	if not e then
		return
	end
	if e.loaded then
		for _, fn in releasingCallbacks do
			pcall(fn, player, e.data)
		end
		saveRaw(player, e, true)
	end
	entries[player] = nil
end

function DataService.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_EVERY)
			for p, e in entries do
				-- se guarda en cada pasada (aunque no haya cambios) para renovar el candado de sesión
				if e.loaded then
					task.spawn(saveRaw, p, e, false)
				end
			end
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for p, e in entries do
			pending += 1
			task.spawn(function()
				for _, fn in releasingCallbacks do
					pcall(fn, p, e.data)
				end
				saveRaw(p, e, true)
				pending -= 1
			end)
		end
		local t0 = os.clock()
		while pending > 0 and os.clock() - t0 < 25 do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Monedas, XP/niveles y misiones (addCoins / addXP / questEvent de game5.js), en el servidor.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Profile = require(Shared.Logic.Profile)
local Quests = require(Shared.Logic.Quests)
local Squishy = require(Shared.Logic.Squishy)
local DataService = require(script.Parent.DataService)
local Net = require(script.Parent.Net)

local Economy = {}

-- La monetización registra aquí el multiplicador de monedas ganadas (ventas y misiones).
local earnMultiplier: (Player) -> number = function()
	return 1
end
function Economy.setEarnMultiplier(fn: (Player) -> number)
	earnMultiplier = fn
end

local function leaderstats(player: Player)
	local d = DataService.get(player)
	local ls = player:FindFirstChild("leaderstats")
	if not d or not ls then
		return
	end
	local c = ls:FindFirstChild("Monedas") :: IntValue?
	local l = ls:FindFirstChild("Nivel") :: IntValue?
	if c then
		c.Value = d.coins
	end
	if l then
		l.Value = d.level
	end
end

--- Suma (o resta) monedas tal cual, sin multiplicadores.
function Economy.addCoins(player: Player, n: number)
	local d = DataService.get(player)
	if not d then
		return
	end
	d.coins = math.max(0, math.floor(d.coins + n))
	DataService.changed(player)
	leaderstats(player)
end

--- Monedas ganadas jugando (vender, misiones): aplica Monedas x2 / VIP. Devuelve lo que se sumó.
function Economy.earnCoins(player: Player, n: number): number
	local total = math.floor(n * earnMultiplier(player) + 0.5)
	Economy.addCoins(player, total)
	return total
end

--- Cobra si alcanza. true = cobrado.
function Economy.spend(player: Player, n: number): boolean
	local d = DataService.get(player)
	if not d or d.coins < n then
		return false
	end
	Economy.addCoins(player, -n)
	return true
end

function Economy.questEvent(player: Player, ev: string, amount: number, absolute: boolean?)
	local d = DataService.get(player)
	if not d then
		return
	end
	local q = Quests.current(d.quest.i)
	if q.ev ~= ev then
		return
	end
	d.quest.p = if absolute then math.max(d.quest.p, amount) else d.quest.p + amount
	if d.quest.p >= q.goal then
		local got = Economy.earnCoins(player, q.reward)
		d.quest.i += 1
		d.quest.p = 0
		task.delay(0.4, function()
			Net.toast(
				player,
				string.format("Misión completa: %s · +%s monedas", q.title, Format.int(got)),
				true,
				3200
			)
			Net.sound(player, "reward")
		end)
		-- misiones de nivel/índice que ya estaban cumplidas se completan solas
		local nq = Quests.current(d.quest.i)
		if nq.ev == "level" then
			d.quest.p = d.level
		elseif nq.ev == "index" then
			d.quest.p = Profile.discoveredCount(d)
		end
		if d.quest.p >= nq.goal then
			local g = nq.goal
			task.delay(0.6, function()
				Economy.questEvent(player, nq.ev, g, true)
			end)
		end
	end
	DataService.changed(player)
end

function Economy.addXP(player: Player, n: number)
	local d = DataService.get(player)
	if not d then
		return
	end
	d.xp += n
	while d.xp >= Squishy.xpNeed(d.level) do
		d.xp -= Squishy.xpNeed(d.level)
		d.level += 1
		local lvl = d.level
		Net.sound(player, "levelup")
		Net.toast(player, string.format("¡Subiste de nivel! Ahora eres nivel %d", lvl), true, 3200)
		for _, sp in Config.Species do
			if not sp.famous and sp.unlockLevel == lvl then
				task.delay(0.9, function()
					Net.toast(player, string.format("¡Nuevo molde desbloqueado: %s!", sp.name), true, 3200)
				end)
			end
		end
		for _, m in Config.Machines do
			if m.level == lvl then
				task.delay(1.6, function()
					Net.toast(player, string.format("¡%s (%s) ya está abierta!", m.name, m.sub), true, 3200)
				end)
			end
		end
		Economy.questEvent(player, "level", lvl, true)
	end
	DataService.changed(player)
	leaderstats(player)
end

function Economy.init()
	DataService.onLoaded(function(player)
		local ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local c = Instance.new("IntValue")
		c.Name = "Monedas"
		c.Parent = ls
		local l = Instance.new("IntValue")
		l.Name = "Nivel"
		l.Parent = ls
		ls.Parent = player
		leaderstats(player)
	end)
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">FillService</string>
            <string name="Source"><![CDATA[--!strict
-- Máquina de llenado, AUTORITATIVA (SYSTEMS_SPEC §3–4). El cliente solo dice "empecé a mantener"
-- y "solté"; el servidor mide el tiempo con os.clock(), calcula p, decide under/perfect/over/POP y
-- tira la rareza. El cliente anima el medidor con la misma fórmula y muestra lo que diga el servidor.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.Logic.Catalog)
local Format = require(Shared.Util.Format)
local Profile = require(Shared.Logic.Profile)
local Squishy = require(Shared.Logic.Squishy)
local Types = require(Shared.Types)
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.Economy)
local InventoryService = require(script.Parent.InventoryService)
local MonetizationService = require(script.Parent.MonetizationService)
local Net = require(script.Parent.Net)

local FILL = Config.Game.FILL
local MACHINE_RANGE = 28 -- studs desde la máquina (margen sobre INTERACT_DIST por lag)
-- Tolerancia por lag: se acepta el tiempo del cliente solo si está MUY cerca del medido aquí.
-- Debe ser bastante menor que la ventana PERFECTO (~0.12 s a velocidad 6) para que no se pueda
-- "elegir" el resultado con un cliente modificado.
local LATENCY_TOL = 0.04

type Session = {
	machine: any,
	species: string,
	filling: string,
	held: number,
	since: number?,
}

local FillService = {}
local sessions: { [Player]: Session } = {}
local rng = Random.new()

local machineById: { [string]: any } = {}
for _, m in Config.Machines do
	machineById[m.id] = m
end
local machinePos: { [string]: Vector3 } = {}
for _, m in Config.WorldLayout.machines do
	machinePos[m.id] = m.pos
end

local function nearMachine(player: Player, id: string): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local pos = machinePos[id]
	if not root or not pos then
		return false
	end
	local flat = Vector3.new(root.Position.X - pos.X, 0, root.Position.Z - pos.Z)
	return flat.Magnitude <= MACHINE_RANGE
end

--- Suerte total, incluyendo pases/pociones de Robux.
function FillService.luck(
	player: Player,
	d: Types.PlayerData,
	machine: any,
	fillingId: string,
	res: Types.FillResult?
): number
	local L = Squishy.totalLuck(d.upgrades.luck, machine, fillingId, res)
	local E = Config.Monetization.EFFECTS
	if MonetizationService.hasPass(player, "luckPlus") then
		L += E.luckPlus
	end
	if d.luckUntil > os.time() then
		L += E.luckPotion
	end
	return L
end

local function start(player: Player, payload: { [string]: any }): { [string]: any }
	local d = DataService.get(player)
	if not d then
		return { ok = false }
	end
	if d.pending then
		return { ok = false, err = "pending", squishy = d.pending }
	end
	local s = sessions[player]
	if s then
		-- volver a mantener después de soltar muy pronto ("Sigue manteniendo…")
		if not s.since then
			s.since = os.clock()
		end
		return { ok = true, held = s.held }
	end
	local machine = machineById[payload.machine]
	local sp = Catalog.SP[payload.species]
	local fil = Catalog.FIL[payload.filling]
	if not machine or not sp or not fil then
		return { ok = false, err = "datos" }
	end
	if d.level < machine.level then
		return { ok = false, err = string.format("Esta máquina se abre en el nivel %d", machine.level) }
	end
	if not nearMachine(player, machine.id) then
		return { ok = false, err = "Acércate a la máquina" }
	end
	if not Profile.moldAvailable(d, sp.id) then
		return { ok = false, err = "molde" }
	end
	if not table.find(d.fillings, fil.id) then
		return { ok = false, err = "relleno" }
	end
	if InventoryService.isFull(player, d) then
		return {
			ok = false,
			err = string.format(
				"Inventario lleno (%d). Vende algunos squishies primero.",
				InventoryService.capacity(player, d)
			),
		}
	end
	if fil.perUse and not MonetizationService.hasPass(player, "vip") then
		if not Economy.spend(player, fil.perUse) then
			return { ok = false, err = string.format("El relleno Misterio cuesta %d monedas por llenado", fil.perUse) }
		end
	end
	d.lastMold = sp.id
	d.lastFill = fil.id
	sessions[player] = { machine = machine, species = sp.id, filling = fil.id, held = 0, since = os.clock() }
	DataService.changed(player)
	return { ok = true, held = 0 }
end

local function release(player: Player, payload: { [string]: any }): { [string]: any }
	local d = DataService.get(player)
	local s = sessions[player]
	if not d or not s or not s.since then
		return { ok = false, err = "no_fill" }
	end
	local serverHeld = s.held + (os.clock() - s.since)
	local held = serverHeld
	local clientHeld = payload.held
	if type(clientHeld) == "number" and clientHeld == clientHeld then
		local tol = LATENCY_TOL + math.min(0.03, player:GetNetworkPing() * 0.25)
		if math.abs(clientHeld - serverHeld) <= tol then
			held = clientHeld
		end
	end
	s.held = held
	s.since = nil
	local speed = d.upgrades.fillSpeed
	local p = Squishy.fillProgress(held, speed)
	local res, popped = Squishy.fillResult(p)

	if popped then
		sessions[player] = nil
		d.stats.fills += 1
		Economy.addXP(player, 1)
		DataService.changed(player)
		return { ok = true, result = "pop", p = p }
	end
	if not res then
		return { ok = true, result = "short", p = p, held = held }
	end

	sessions[player] = nil
	if res == "perfect" then
		d.stats.perfect += 1
		Economy.questEvent(player, "perfect", 1)
	end

	local sq: Types.SquishyData
	if not d.firstDone then
		d.firstDone = true
		sq = Squishy.generate(
			rng,
			s.species,
			s.filling,
			0,
			{ rarity = "uncommon", variant = "bubblegum", mutation = "normal", face = "happy" }
		)
	elseif d.legendFills > 0 then
		d.legendFills -= 1
		sq = Squishy.generate(
			rng,
			s.species,
			s.filling,
			FillService.luck(player, d, s.machine, s.filling, res :: Types.FillResult),
			{ rarity = "legendary", machine = s.machine }
		)
	else
		sq = Squishy.generate(
			rng,
			s.species,
			s.filling,
			FillService.luck(player, d, s.machine, s.filling, res :: Types.FillResult),
			{ machine = s.machine }
		)
	end

	local k = Profile.idxKey(sq)
	local isNew = not d.discovered[k]
	d.discovered[k] = true
	d.pending = sq
	d.stats.fills += 1
	DataService.changed(player)

	-- XP y misiones cuando termina el procesado (así los toasts salen junto con la revelación)
	local tier = Catalog.RTier[sq.rarity]
	task.delay(FILL.process, function()
		if not DataService.get(player) then
			return
		end
		Economy.questEvent(player, "fill", 1)
		if tier >= 1 then
			Economy.questEvent(player, "getUncommon", 1)
		end
		if tier >= 2 then
			Economy.questEvent(player, "getRare", 1)
		end
		if tier >= 3 then
			Economy.questEvent(player, "getEpic", 1)
		end
		if isNew then
			Economy.questEvent(player, "index", Profile.discoveredCount(d), true)
		end
		Economy.addXP(player, Catalog.R[sq.rarity].xp)
	end)
	return { ok = true, result = res, p = p, squishy = sq, isNew = isNew }
end

--- Guardar o vender el squishy que salió de la máquina.
local function decide(player: Player, payload: { [string]: any }): { [string]: any }
	local d = DataService.get(player)
	if not d or not d.pending then
		return { ok = false }
	end
	local sq = d.pending :: Types.SquishyData
	if payload.keep == true then
		if InventoryService.isFull(player, d) then
			return { ok = false, err = "Inventario lleno" }
		end
		d.pending = nil
		InventoryService.add(player, d, sq)
		Net.sound(player, "keep")
		Net.toast(player, string.format("%s guardado en tu inventario", sq.name))
		if d.tutorial <= 3 then
			d.tutorial = 4
		end
	else
		d.pending = nil
		local dupe = false
		for _, x in d.inventory do
			if Profile.idxKey(x) == Profile.idxKey(sq) then
				dupe = true
				break
			end
		end
		local got = Economy.earnCoins(player, sq.value)
		d.stats.sold += 1
		Net.sound(player, "coins")
		Net.toast(player, string.format("Vendido por %s monedas", Format.int(got)))
		if dupe then
			Economy.questEvent(player, "sellDupe", 1)
		end
		if d.tutorial <= 3 then
			Net.toast(player, "Tip: ¡guarda el primero para poder equiparlo!")
			local gift = Squishy.generate(
				rng,
				sq.species,
				sq.filling,
				0,
				{ rarity = "uncommon", variant = "bubblegum", mutation = "normal", face = "happy" }
			)
			InventoryService.add(player, d, gift)
			d.tutorial = 4
		end
	end
	DataService.changed(player)
	return { ok = true }
end

function FillService.init()
	Net.on("fillStart", start)
	Net.on("fillRelease", release)
	Net.on("fillCancel", function(player)
		sessions[player] = nil
		return { ok = true }
	end)
	Net.on("reveal", decide)

	-- Si se va con un squishy pendiente: se guarda si cabe, si no se vende.
	DataService.onReleasing(function(player, d)
		sessions[player] = nil
		local sq = d.pending
		if sq then
			d.pending = nil
			if #d.inventory < InventoryService.capacity(player, d) then
				table.insert(d.inventory, sq)
			else
				d.coins += sq.value
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		sessions[p] = nil
	end)
end

return FillService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict
-- Inventario: equipar (compañero), favorito, vender, vender repetidos, capacidad.
-- Porte de renderInvDetail / sellItems / sellDupes de game5.js.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local Profile = require(Shared.Logic.Profile)
local Types = require(Shared.Types)
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.Economy)
local MonetizationService = require(script.Parent.MonetizationService)
local Net = require(script.Parent.Net)

local InventoryService = {}

function InventoryService.capacity(player: Player, d: Types.PlayerData): number
	local cap = Profile.baseCapacity(d)
	if MonetizationService.hasPass(player, "bigBag") then
		cap += Config.Monetization.EFFECTS.bigBagSlots
	end
	return cap
end

function InventoryService.isFull(player: Player, d: Types.PlayerData): boolean
	return #d.inventory >= InventoryService.capacity(player, d)
end

--- Publica el compañero equipado como atributo del jugador; cada cliente lo dibuja (Companion.luau).
function InventoryService.refreshCompanion(player: Player)
	local d = DataService.get(player)
	local s = d and d.equipped and Profile.find(d, d.equipped)
	if s then
		player:SetAttribute(
			"Companion",
			HttpService:JSONEncode({
				id = s.id,
				species = s.species,
				variant = s.variant,
				mutation = s.mutation,
				rarity = s.rarity,
				size = s.size,
				name = s.name,
				face = s.face,
			})
		)
	else
		player:SetAttribute("Companion", nil)
	end
end

--- Agrega al inventario (sin revisar capacidad) y marca el Índice. Devuelve true si es nuevo.
function InventoryService.add(player: Player, d: Types.PlayerData, s: Types.SquishyData): boolean
	table.insert(d.inventory, s)
	local k = Profile.idxKey(s)
	local isNew = not d.discovered[k]
	if isNew then
		d.discovered[k] = true
		Economy.questEvent(player, "index", Profile.discoveredCount(d), true)
	end
	DataService.changed(player)
	return isNew
end

--- Quita del inventario sin pagar (intercambios). Devuelve el squishy quitado.
function InventoryService.take(player: Player, d: Types.PlayerData, id: string): Types.SquishyData?
	local s, i = Profile.find(d, id)
	if not s or not i then
		return nil
	end
	table.remove(d.inventory, i)
	if d.equipped == id then
		d.equipped = nil
		InventoryService.refreshCompanion(player)
	end
	DataService.changed(player)
	return s
end

local function countKey(d: Types.PlayerData, k: string): number
	local n = 0
	for _, x in d.inventory do
		if Profile.idxKey(x) == k then
			n += 1
		end
	end
	return n
end

--- Vende una lista de ids (se saltan favoritos y el equipado). Devuelve el total ganado.
function InventoryService.sell(player: Player, d: Types.PlayerData, ids: { string }): number
	local base, dupe = 0, false
	for _, id in ids do
		local s, i = Profile.find(d, id)
		if s and i and not s.fav and d.equipped ~= s.id then
			if countKey(d, Profile.idxKey(s)) > 1 then
				dupe = true
			end
			table.remove(d.inventory, i)
			base += s.value
			d.stats.sold += 1
		end
	end
	if base <= 0 then
		return 0
	end
	local got = Economy.earnCoins(player, base)
	Net.sound(player, "coins")
	Net.toast(player, string.format("Vendido por %s monedas", Format.int(got)))
	if dupe then
		Economy.questEvent(player, "sellDupe", 1)
	end
	DataService.changed(player)
	return got
end

local function dupesToSell(d: Types.PlayerData): { string }
	local groups: { [string]: { Types.SquishyData } } = {}
	for _, s in d.inventory do
		local k = Profile.idxKey(s)
		groups[k] = groups[k] or {}
		table.insert(groups[k], s)
	end
	local out = {}
	for _, g in groups do
		if #g >= 2 then
			table.sort(g, function(a, b)
				local af, bf = a.fav and 1 or 0, b.fav and 1 or 0
				if af ~= bf then
					return af > bf
				end
				local ae, be = (a.id == d.equipped) and 1 or 0, (b.id == d.equipped) and 1 or 0
				if ae ~= be then
					return ae > be
				end
				return a.value > b.value
			end)
			for i = 2, #g do
				if not g[i].fav and g[i].id ~= d.equipped then
					table.insert(out, g[i].id)
				end
			end
		end
	end
	return out
end

function InventoryService.init()
	DataService.onLoaded(function(player)
		InventoryService.refreshCompanion(player)
	end)
	DataService.addViewProvider(function(player, view)
		local d = DataService.get(player)
		if d then
			view.capacity = InventoryService.capacity(player, d)
		end
	end)

	Net.on("inv", function(player, payload)
		local d = DataService.get(player)
		if not d then
			return { ok = false }
		end
		local op = payload.op
		local id = payload.id
		if op == "sellDupes" then
			local ids = dupesToSell(d)
			if #ids == 0 then
				Net.toast(player, "No tienes repetidos para vender")
				Net.sound(player, "error")
				return { ok = false }
			end
			if payload.preview then
				local total = 0
				for _, x in ids do
					local s = Profile.find(d, x)
					total += if s then s.value else 0
				end
				return { ok = true, count = #ids, total = total }
			end
			return { ok = true, got = InventoryService.sell(player, d, ids) }
		end
		if type(id) ~= "string" then
			return { ok = false, err = "id" }
		end
		local s = Profile.find(d, id)
		if not s then
			return { ok = false, err = "no_existe" }
		end
		if op == "equip" then
			d.equipped = if d.equipped == id then nil else id
			InventoryService.refreshCompanion(player)
			if d.equipped then
				Net.toast(player, string.format("¡%s te está siguiendo!", s.name))
				if d.tutorial == 4 then
					d.tutorial = 5
				end
			end
			DataService.changed(player)
		elseif op == "fav" then
			s.fav = not s.fav
			DataService.changed(player)
		elseif op == "sell" then
			return { ok = InventoryService.sell(player, d, { id }) > 0 }
		else
			return { ok = false, err = "op" }
		end
		return { ok = true }
	end)

	-- Apachurrones: +2 XP cada 15 (SYSTEMS_SPEC §2). El cliente avisa cada apachurrón.
	local lastSquish: { [Player]: number } = {}
	Net.on("squish", function(player)
		local d = DataService.get(player)
		if not d then
			return { ok = false }
		end
		local now = os.clock()
		if now - (lastSquish[player] or 0) < 0.25 then
			return { ok = false, err = "rate" }
		end
		lastSquish[player] = now
		d.stats.squishes += 1
		if d.stats.squishes % 15 == 0 then
			Economy.addXP(player, 2)
		end
		DataService.changed(player)
		return { ok = true }
	end)
	Players.PlayerRemoving:Connect(function(p)
		lastSquish[p] = nil
	end)

	Net.on("tutorial", function(player, payload)
		local d = DataService.get(player)
		local step = payload.step
		if d and type(step) == "number" and step > d.tutorial and step <= 5 then
			d.tutorial = math.floor(step)
			DataService.changed(player)
		end
		return { ok = true }
	end)
	Net.on("setMuted", function(player, payload)
		local d = DataService.get(player)
		if d then
			d.muted = payload.v == true
			DataService.changed(player)
		end
		return { ok = true }
	end)
	Net.on("tourSeen", function(player)
		local d = DataService.get(player)
		if d then
			d.tourSeen = true
			DataService.changed(player)
		end
		return { ok = true }
	end)
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
-- Robux: Game Passes (permanentes) y Developer Products (consumibles).
-- • ProcessReceipt es idempotente: guarda el PurchaseId en el perfil y confirma el recibo
--   (PurchaseGranted) SOLO después de guardar en el DataStore. Si algo falla → NotProcessedYet
--   y Roblox lo reintenta.
-- • Los pases se consultan al entrar y se actualizan al comprarlos en el juego.
-- • En Studio, los ítems con id 0 se simulan con la acción "devBuy" para poder probar todo.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local MonetizationConfig = require(Shared.Config.Monetization)
local Types = require(Shared.Types)
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.Economy)
local Net = require(script.Parent.Net)

local M = Config.Monetization

local MonetizationService = {}

local owned: { [Player]: { [string]: boolean } } = {}

function MonetizationService.hasPass(player: Player, passKey: string): boolean
	local o = owned[player]
	return o ~= nil and o[passKey] == true
end

local function setPass(player: Player, passKey: string)
	local o = owned[player]
	if not o then
		o = {}
		owned[player] = o
	end
	if o[passKey] then
		return
	end
	o[passKey] = true
	if passKey == "vip" then
		player:SetAttribute("VIP", true)
	end
	DataService.changed(player)
end

local function refreshPasses(player: Player)
	owned[player] = owned[player] or {}
	for _, pass in M.PASSES do
		if pass.id ~= 0 then
			local ok, has = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			if ok and has then
				setPass(player, pass.key)
			end
		end
	end
end

--- Aplica el efecto de un producto al perfil. Devuelve el texto del toast.
local function applyProduct(player: Player, d: Types.PlayerData, product: MonetizationConfig.Product): string
	if product.coins then
		Economy.addCoins(player, product.coins)
	end
	if product.luckMinutes then
		local now = os.time()
		d.luckUntil = math.max(d.luckUntil, now) + product.luckMinutes * 60
	end
	if product.legendFills then
		d.legendFills += product.legendFills
	end
	return string.format("¡Gracias por tu compra! %s %s", product.icon, product.name)
end

local function processReceipt(info: { [string]: any }): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = M.productById[info.ProductId]
	if not product then
		warn("[Monetization] producto desconocido", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local d = DataService.waitFor(player, 20)
	if not d then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(info.PurchaseId)
	if table.find(d.receipts, purchaseId) then
		-- ya se entregó en este servidor; confirmar solo cuando esté guardado de verdad
		if DataService.receiptSaved(player, purchaseId) or DataService.saveNow(player) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local msg = applyProduct(player, d, product)
	table.insert(d.receipts, purchaseId)
	d.robuxSpent += tonumber(info.CurrencySpent) or 0
	DataService.changed(player)
	if not DataService.saveNow(player) then
		-- deshacer no es seguro con monedas ya gastadas; Roblox reintentará y el recibo evita duplicar
		warn("[Monetization] no se pudo guardar tras la compra; se reintentará", purchaseId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Net.toast(player, msg, true, 3500)
	Net.sound(player, "reward")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.init()
	MarketplaceService.ProcessReceipt = processReceipt

	Economy.setEarnMultiplier(function(player)
		local mult = 1
		if MonetizationService.hasPass(player, "coins2x") then
			mult *= M.EFFECTS.coins2xMult
		end
		if MonetizationService.hasPass(player, "vip") then
			mult *= M.EFFECTS.vipCoinMult
		end
		return mult
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local pass = M.passById[passId]
		if purchased and pass then
			setPass(player, pass.key)
			Net.toast(player, string.format("¡%s %s activado! Gracias 💖", pass.icon, pass.name), true, 3500)
			Net.sound(player, "reward")
		end
	end)

	DataService.onLoaded(function(player)
		refreshPasses(player)
		DataService.changed(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
	end)

	DataService.addViewProvider(function(player, view)
		view.passes = table.clone(owned[player] or {})
		local d = DataService.get(player)
		view.luckLeft = if d then math.max(0, d.luckUntil - os.time()) else 0
	end)

	-- Solo Studio: simular la compra de ítems que todavía no tienen id (para probar el flujo).
	Net.on("devBuy", function(player, payload)
		if not RunService:IsStudio() then
			return { ok = false, err = "solo_studio" }
		end
		local item = M.byKey[payload.key]
		if not item then
			return { ok = false, err = "no_existe" }
		end
		local d = DataService.get(player)
		if not d then
			return { ok = false }
		end
		for _, pass in M.PASSES do
			if pass.key == payload.key then
				setPass(player, pass.key)
				Net.toast(player, string.format("[Studio] %s %s activado (simulado)", pass.icon, pass.name), true)
				return { ok = true }
			end
		end
		local msg = applyProduct(player, d, item :: MonetizationConfig.Product)
		DataService.changed(player)
		Net.toast(player, "[Studio] " .. msg .. " (simulado)", true)
		return { ok = true }
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--!strict
-- Puerta de entrada de todas las peticiones del cliente (Remote "Request").
-- Cada servicio registra sus acciones con Net.on(action, handler). Aquí se valida el tipo del
-- payload y se limita la frecuencia por jugador para que nadie spamee el servidor.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

export type Handler = (player: Player, payload: { [string]: any }) -> { [string]: any }?

local Net = {}

local handlers: { [string]: Handler } = {}
local buckets: { [Player]: { tokens: number, last: number } } = {}

local RATE = 12 -- peticiones por segundo sostenidas
local BURST = 24

local function allow(player: Player): boolean
	local now = os.clock()
	local b = buckets[player]
	if not b then
		b = { tokens = BURST, last = now }
		buckets[player] = b
	end
	b.tokens = math.min(BURST, b.tokens + (now - b.last) * RATE)
	b.last = now
	if b.tokens < 1 then
		return false
	end
	b.tokens -= 1
	return true
end

function Net.on(action: string, handler: Handler)
	assert(handlers[action] == nil, "acción repetida: " .. action)
	handlers[action] = handler
end

function Net.notify(player: Player, msg: { [string]: any })
	Remotes.event("Notify"):FireClient(player, msg)
end

function Net.toast(player: Player, text: string, big: boolean?, ms: number?)
	Net.notify(player, { t = "toast", msg = text, big = big == true, ms = ms })
end

function Net.sound(player: Player, name: string)
	Net.notify(player, { t = "sound", name = name })
end

function Net.init()
	local rf = Remotes.func("Request")
	rf.OnServerInvoke = function(player: Player, action: any, payload: any): any
		if type(action) ~= "string" then
			return { ok = false, err = "bad_action" }
		end
		if payload ~= nil and type(payload) ~= "table" then
			return { ok = false, err = "bad_payload" }
		end
		if not allow(player) then
			return { ok = false, err = "rate" }
		end
		local h = handlers[action]
		if not h then
			return { ok = false, err = "unknown_action" }
		end
		local ok, res = pcall(h, player, payload or {})
		if not ok then
			warn(string.format("[Net] %s falló para %s: %s", action, player.Name, tostring(res)))
			return { ok = false, err = "server_error" }
		end
		return res or { ok = true }
	end
	Players.PlayerRemoving:Connect(function(p)
		buckets[p] = nil
	end)
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">NpcService</string>
            <string name="Source"><![CDATA[--!strict
-- 7 NPCs (NpcDefs) como personajes R15 de Roblox. Pasean cerca de su casa, dicen frases cada
-- 7–15 s, se detienen si hablas con ellos y llevan su compañero (la mitad su viral favorito).
-- Chat: respuestas predefinidas (scriptedReply de game4.js). La IA vía proxy va en la Fase 6.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Catalog = require(Shared.Logic.Catalog)
local Config = require(Shared.Config)
local Squishy = require(Shared.Logic.Squishy)
local Net = require(script.Parent.Net)
local TradeService = require(script.Parent.TradeService)

local NpcService = {}
local rng = Random.new()

type Npc = { def: any, model: Model, humanoid: Humanoid, home: Vector3, busyUntil: number }
local npcs: { [string]: Npc } = {}

-- colores de ropa pastel por NPC (el prototipo usaba pieles Kenney; aquí avatar R15)
local OUTFITS = {
	{ "#F7A7CD", "#FFFFFF" },
	{ "#A6DB8E", "#3E7D3A" },
	{ "#CDB8F2", "#FFFFFF" },
	{ "#8BC7E8", "#2F4A7A" },
	{ "#FFE38F", "#F7A7CD" },
	{ "#F8B27C", "#5A3A2A" },
	{ "#9CE0CA", "#B999E8" },
}
local SKIN = { "#F6D3B3", "#E8B894", "#C98E62", "#8D5A3B", "#F1C9A5", "#FFDFC4", "#B67A52" }

local function describe(i: number): HumanoidDescription
	local hd = Instance.new("HumanoidDescription")
	local skin = Color3.fromHex(SKIN[(i - 1) % #SKIN + 1])
	hd.HeadColor = skin
	hd.LeftArmColor = skin
	hd.RightArmColor = skin
	hd.LeftLegColor = Color3.fromHex(OUTFITS[i][2])
	hd.RightLegColor = Color3.fromHex(OUTFITS[i][2])
	hd.TorsoColor = Color3.fromHex(OUTFITS[i][1])
	hd.HeightScale = 0.95
	hd.WidthScale = 0.95
	hd.HeadScale = 1.1
	return hd
end

local function say(n: Npc, text: string, secs: number?)
	local head = n.model:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local old = head:FindFirstChild("Bubble")
	if old then
		old:Destroy()
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "Bubble"
	bb.Size = UDim2.fromOffset(220, 60)
	bb.StudsOffset = Vector3.new(0, 3.2, 0)
	bb.MaxDistance = 70
	local f = Instance.new("TextLabel")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	f.TextColor3 = Color3.fromHex("#3A3350")
	f.Font = Enum.Font.GothamBold
	f.TextScaled = true
	f.TextWrapped = true
	f.Text = text
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 14)
	c.Parent = f
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 4)
	pad.Parent = f
	f.Parent = bb
	bb.Parent = head
	task.delay(secs or 4, function()
		if bb.Parent then
			bb:Destroy()
		end
	end)
end

local function pick<T>(list: { T }): T
	return list[rng:NextInteger(1, #list)]
end

local function has(t: string, words: { string }): boolean
	for _, w in words do
		if string.find(t, w, 1, true) then
			return true
		end
	end
	return false
end

--- scriptedReply(n, text) de game4.js, tal cual (detecta inglés/español).
local function scriptedReply(n: Npc, text: string): (string, string, boolean)
	local t = string.lower(text)
	local padded = " " .. string.gsub(t, "[%p]", " ") .. " "
	local en = false
	for _, w in { "hi", "hello", "hey", "trade", "want", "how", "what", "you", "your", "the", "is", "are", "thanks" } do
		if string.find(padded, " " .. w .. " ", 1, true) then
			en = true
			break
		end
	end
	if has(t, { "ñ", "á", "é", "í", "ó", "ú", "¿", "¡" }) then
		en = false
	end
	local es = not en
	local function L(e: string, sp: string): string
		return if es then sp else e
	end
	local fav = Catalog.SP[n.def.fav]
	if has(t, { "trade", "cambi", "interc" }) then
		return L("Sure! Let's see what you've got 👀", "¡Dale! Muéstrame qué tienes 👀"), "yes", true
	end
	if has(t, { "aplast", "apachurr", "squish", "slow", "suav", "sube" }) then
		return L(
			"Hold click on any squishy to squish it — press F for close-up!",
			"¡Mantén clic sobre cualquier squishy para apachurrarlo, o presiona F para verlo de cerca! Los de Miel suben lentííísimo 🍯"
		),
			"yes",
			false
	end
	if has(t, { "mantequilla", "butter", "viral", "famos" }) then
		return L(
			"The butter one is the best, it rises sooo slow 🧈",
			"¡La Barra de Mantequilla es la mejor, sube lentííísimo! 🧈 Los demás virales están en la Tienda."
		),
			"yes",
			false
	end
	if has(t, { "perfect", "tip", "how", "consejo", "truco", "cómo", "como" }) then
		return L(
			"Tip: let go right inside the green Perfect zone, it boosts your luck!",
			"Truco: suelta justo en la zona verde Perfect, ¡te sube la suerte!"
		),
			"yes",
			false
	end
	if has(t, { "legend", "secret", "secreto" }) then
		return L(
			"Legendaries are super rare… Mystery filling helps a tiny bit ✨",
			"Los legendarios son rarísimos… el relleno Mystery ayuda un poquito ✨"
		),
			"none",
			false
	end
	if string.find(t, n.def.fav, 1, true) and fav then
		return L(
			string.format("%ss are my favorite!! Got any?", fav.name),
			string.format("¡Los %s son mis favoritos! ¿Tienes alguno?", fav.name)
		),
			"yes",
			true
	end
	if es then
		return pick({
			"¡Qué buen compañero tienes!",
			"¿Ya probaste la Máquina 02?",
			"¿Quieres cambiar?",
			"¡Me encanta esta plaza!",
		}),
			pick({ "none", "yes" }),
			rng:NextNumber() < 0.3
	end
	local lines = table.clone(n.def.lines)
	for _, l in { "Nice companion!", "Have you tried Machine 02?", "Want to trade?" } do
		table.insert(lines, l)
	end
	return pick(lines), pick({ "none", "yes" }), rng:NextNumber() < 0.3
end

local function spawnNpc(i: number, def: any, folder: Folder)
	local zone = (Config.WorldLayout.zones :: any)[def.home] or Config.WorldLayout.zones.center
	local home = zone.center + Vector3.new(rng:NextNumber(-8, 8), 0, rng:NextNumber(-8, 8))
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(describe(i), Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[NpcService] no pude crear el NPC", def.name, model)
		return
	end
	model.Name = def.name
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayName = def.name
	hum.WalkSpeed = 8
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	hum.NameDisplayDistance = 60
	model:PivotTo(CFrame.new(home + Vector3.new(0, 3, 0)))
	model:SetAttribute("Npc", true)

	-- compañero: la mitad (índices pares en el prototipo, 0-based) lleva su viral favorito
	local species = if (i - 1) % 2 == 0 then def.famousFav else def.fav
	local sq =
		Squishy.generate(rng, species, "classic_foam", 0, { rarity = if (i - 1) % 2 == 0 then "common" else nil })
	model:SetAttribute(
		"Companion",
		HttpService:JSONEncode({
			id = sq.id,
			species = sq.species,
			variant = sq.variant,
			mutation = sq.mutation,
			rarity = sq.rarity,
			size = sq.size,
			name = sq.name,
			face = sq.face,
		})
	)

	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	-- #prompt del original: "Hablar con {npc}" (E) → abre el chat (el botón Cambiar está en el chat)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = "Hablar con " .. def.name
	pp.ObjectText = ""
	pp.KeyboardKeyCode = Enum.KeyCode.E
	pp.MaxActivationDistance = 10
	pp.RequiresLineOfSight = false
	pp.Style = Enum.ProximityPromptStyle.Custom
	pp:SetAttribute("Kind", "npc")
	pp:SetAttribute("Id", def.name)
	pp.Parent = root
	model.Parent = folder
	root:SetNetworkOwner(nil)

	local n: Npc = { def = def, model = model, humanoid = hum, home = home, busyUntil = 0 }
	npcs[def.name] = n

	-- paseo
	task.spawn(function()
		while model.Parent do
			task.wait(rng:NextNumber(3, 7))
			if os.clock() >= n.busyUntil and hum.Health > 0 then
				local target = home + Vector3.new(rng:NextNumber(-10, 10), 0, rng:NextNumber(-10, 10))
				hum:MoveTo(target)
			end
		end
	end)
	-- burbujas
	task.spawn(function()
		local every = Config.Game.NPC_BUBBLE_EVERY
		while model.Parent do
			task.wait(rng:NextNumber(every[1], every[2]))
			if os.clock() >= n.busyUntil then
				say(n, def.lines[rng:NextInteger(1, #def.lines)], 4)
			end
		end
	end)
end

local function stopFor(n: Npc, player: Player, secs: number)
	n.busyUntil = os.clock() + secs
	local root = n.model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local char = player.Character
	local proot = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	n.humanoid:MoveTo(if root then root.Position else n.home)
	if root and proot then
		local look = Vector3.new(proot.Position.X, root.Position.Y, proot.Position.Z)
		if (look - root.Position).Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(root.Position, look)
		end
	end
end

function NpcService.init()
	local folder = Instance.new("Folder")
	folder.Name = "NPCs"
	folder.Parent = Workspace
	for i, def in Config.NpcDefs do
		task.spawn(spawnNpc, i, def, folder)
	end

	TradeService.setNpcHooks(function(name)
		local n = npcs[name]
		return if n then n.model else nil
	end, function(name, text)
		local n = npcs[name]
		if n then
			say(n, text, 4)
		end
	end)

	Net.on("npcTalk", function(player, payload)
		local n = npcs[payload.npc]
		if not n then
			return { ok = false }
		end
		stopFor(n, player, 8)
		return { ok = true }
	end)
	local lastChat: { [Player]: number } = {}
	Net.on("npcChat", function(player, payload)
		local n = npcs[payload.npc]
		local text = payload.text
		if not n or type(text) ~= "string" or #text == 0 or #text > 280 then
			return { ok = false }
		end
		if os.clock() - (lastChat[player] or 0) < 1 then
			return { ok = false, err = "rate" }
		end
		lastChat[player] = os.clock()
		-- todo texto de jugadores pasa por el filtro de Roblox
		local okF, filtered = pcall(function()
			local r = TextService:FilterStringAsync(string.sub(text, 1, 140), player.UserId)
			return r:GetNonChatStringForBroadcastAsync()
		end)
		if not okF then
			return { ok = false, err = "filtro" }
		end
		stopFor(n, player, 10)
		local reply, emote, wantsTrade = scriptedReply(n, filtered :: string)
		reply = string.sub(reply, 1, 220)
		say(n, reply, 5)
		return { ok = true, mine = filtered, say = reply, emote = emote, wantsTrade = wantsTrade }
	end)
	-- le están apachurrando el compañero: se detiene y reacciona
	Net.on("npcSquished", function(player, payload)
		local n = npcs[payload.npc]
		if not n or os.clock() < n.busyUntil - 2 then
			return { ok = false }
		end
		stopFor(n, player, 5)
		local lines = {
			"¡Oye, con cuidado! 😆",
			"¿Verdad que es suavecito?",
			"¡Jajaja, apachúrralo!",
			"Sube lentííísimo, mira 👀",
		}
		say(n, lines[rng:NextInteger(1, #lines)], 3.5)
		return { ok = true }
	end)
end

return NpcService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!strict
-- Tienda con monedas: moldes virales, rellenos y mejoras (renderShop / shopGrid de game5.js).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.Logic.Catalog)
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.Economy)
local Net = require(script.Parent.Net)

local ShopService = {}

function ShopService.init()
	Net.on("shop", function(player, payload)
		local d = DataService.get(player)
		if not d then
			return { ok = false }
		end
		local kind, id = payload.kind, payload.id
		if kind == "filling" then
			local f = Catalog.FIL[id]
			if not f or f.price <= 0 or table.find(d.fillings, f.id) then
				return { ok = false }
			end
			if not Economy.spend(player, f.price) then
				return { ok = false, err = "monedas" }
			end
			table.insert(d.fillings, f.id)
			Net.sound(player, "coins")
			Net.toast(player, string.format("¡Relleno %s desbloqueado!", f.name), true)
		elseif kind == "mold" then
			local sp = Catalog.SP[id]
			if not sp or not sp.famous or table.find(d.molds, sp.id) then
				return { ok = false }
			end
			if not Economy.spend(player, sp.price) then
				return { ok = false, err = "monedas" }
			end
			table.insert(d.molds, sp.id)
			Net.sound(player, "coins")
			Net.sound(player, "sparkle")
			Net.toast(
				player,
				string.format("¡Molde viral %s desbloqueado! Úsalo en cualquier máquina.", sp.name),
				true,
				3200
			)
		elseif kind == "upgrade" then
			local u = (Config.Upgrades :: any)[id]
			if not u then
				return { ok = false }
			end
			local lvl = if id == "fillSpeed" then d.upgrades.fillSpeed - 1 else (d.upgrades :: any)[id]
			local cost = u.costs[lvl + 1]
			if not cost then
				return { ok = false, err = "max" }
			end
			if not Economy.spend(player, cost) then
				return { ok = false, err = "monedas" }
			end
			if id == "fillSpeed" then
				d.upgrades.fillSpeed += 1
				Economy.questEvent(player, "upFill", 1)
			else
				(d.upgrades :: any)[id] += 1
			end
			Net.sound(player, "levelup")
			Net.toast(player, string.format("¡%s mejorada!", u.name), true)
		else
			return { ok = false, err = "kind" }
		end
		DataService.changed(player)
		return { ok = true }
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--!strict
-- Intercambios (SYSTEMS_SPEC §5):
--   • Con NPC: igual que el prototipo (trade de game5.js): tú ofreces hasta 3, el NPC propone uno
--     de valor ≈ tu oferta · random(0.85, 1.35); acepta si valorMío ≥ 0.8 · valorSuyo; 3 "¿y otro?".
--   • Jugador ↔ jugador: solicitud → sala → cada uno pone hasta 6 → "Listo" los dos → "Confirmar"
--     los dos (doble confirmación). Cualquier cambio reinicia las confirmaciones. Al final el servidor
--     re-valida todo (dueño, capacidad) y hace el cambio de una sola vez: nada se duplica ni se pierde.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Catalog = require(Shared.Logic.Catalog)
local Profile = require(Shared.Logic.Profile)
local Remotes = require(Shared.Remotes)
local Squishy = require(Shared.Logic.Squishy)
local Types = require(Shared.Types)
local DataService = require(script.Parent.DataService)
local Economy = require(script.Parent.Economy)
local InventoryService = require(script.Parent.InventoryService)
local Net = require(script.Parent.Net)

local TradeService = {}
local rng = Random.new()

-- NpcService registra aquí cómo encontrar a un NPC (para validar distancia y hacerlo hablar).
local npcLookup: (name: string) -> Model? = function()
	return nil
end
local npcSay: (name: string, text: string) -> () = function() end
function TradeService.setNpcHooks(lookup: (string) -> Model?, say: (string, string) -> ())
	npcLookup = lookup
	npcSay = say
end

local NPC_RANGE = 24
local P2P_MAX = 6
local REQUEST_TTL = 25

--- Lista de ids limpia: solo strings, sin repetidos, que existan, no equipados, máximo `max`.
--- (No confiar en #ids: una tabla con claves de texto tiene # = 0 pero igual se recorre.)
local function cleanIds(d: Types.PlayerData, ids: any, max: number): { string }?
	if type(ids) ~= "table" then
		return nil
	end
	local n = 0
	for _ in ids do
		n += 1
		if n > max then
			return nil
		end
	end
	local clean = {}
	for i = 1, n do
		local id = ids[i]
		if type(id) == "string" and id ~= d.equipped and Profile.find(d, id) and not table.find(clean, id) then
			table.insert(clean, id)
		end
	end
	return clean
end

local npcDefByName: { [string]: any } = {}
for _, n in Config.NpcDefs do
	npcDefByName[n.name] = n
end

-- ─────────────────────────── NPC ───────────────────────────
type NpcSession = { npc: string, mine: { string }, theirs: Types.SquishyData?, rerolls: number }
local npcSessions: { [Player]: NpcSession } = {}

local function near(player: Player, model: Model?, range: number): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not model then
		return false
	end
	return (model:GetPivot().Position - root.Position).Magnitude <= range
end

local function valueOf(d: Types.PlayerData, ids: { string }): number
	local v = 0
	for _, id in ids do
		local s = Profile.find(d, id)
		v += if s then s.value else 0
	end
	return v
end

local function npcOffer(d: Types.PlayerData, sess: NpcSession)
	local myVal = valueOf(d, sess.mine)
	if myVal <= 0 then
		sess.theirs = nil
		return
	end
	local def = npcDefByName[sess.npc]
	local target = myVal * (0.85 + rng:NextNumber() * 0.5)
	local best: Types.SquishyData? = nil
	local bd = math.huge
	local catBase = Catalog.SP.cat.baseValue
	for _ = 1, 60 do
		-- rareza con peso 1 si su valor típico está cerca del objetivo, 0.02 si no
		local weights = {}
		local tot = 0
		for i, r in Config.Rarities do
			local w = if math.abs(math.log((catBase * r.mult) / target)) < 1.6 then 1 else 0.02
			weights[i] = w
			tot += w
		end
		local x = rng:NextNumber() * tot
		local rar = Config.Rarities[#Config.Rarities].id
		for i, w in weights do
			x -= w
			if x <= 0 then
				rar = Config.Rarities[i].id
				break
			end
		end
		local species = if rng:NextNumber() < 0.5 and def
			then def.fav
			else Config.Species[rng:NextInteger(1, #Config.Species)].id
		local cand = Squishy.generate(rng, species, "classic_foam", 0, { rarity = rar })
		local diff = math.abs(cand.value - target)
		if diff < bd then
			bd = diff
			best = cand
		end
	end
	sess.theirs = best
end

local function npcState(d: Types.PlayerData, sess: NpcSession, msg: string?): { [string]: any }
	return {
		ok = true,
		npc = sess.npc,
		mine = sess.mine,
		theirs = sess.theirs,
		myVal = valueOf(d, sess.mine),
		theirVal = if sess.theirs then sess.theirs.value else 0,
		rerolls = sess.rerolls,
		msg = msg,
	}
end

local NPC_YES = { "¡Trato hecho! 🤝", "¡Un gusto cambiar contigo!", "GG, ¡buen cambio!" }

local function npcTrade(player: Player, payload: { [string]: any }): { [string]: any }
	local d = DataService.get(player)
	if not d then
		return { ok = false }
	end
	local op = payload.op
	if op == "open" then
		local name = payload.npc
		if type(name) ~= "string" or not npcDefByName[name] then
			return { ok = false }
		end
		if not near(player, npcLookup(name), NPC_RANGE) then
			return { ok = false, err = "Acércate más" }
		end
		local sess = { npc = name, mine = {}, theirs = nil, rerolls = 0 }
		npcSessions[player] = sess
		return npcState(d, sess)
	end
	local sess = npcSessions[player]
	if not sess then
		return { ok = false, err = "no_session" }
	end
	if op == "set" then
		local clean = cleanIds(d, payload.ids, 3)
		if not clean then
			return { ok = false }
		end
		sess.mine = clean
		npcOffer(d, sess)
		local msg = if sess.theirs then string.format('%s: "¿Qué tal mi %s?"', sess.npc, sess.theirs.name) else nil
		return npcState(d, sess, msg)
	elseif op == "reroll" then
		if sess.rerolls >= 3 or #sess.mine == 0 then
			return { ok = false }
		end
		sess.rerolls += 1
		npcOffer(d, sess)
		return npcState(d, sess, string.format('%s: "Bueno, ¿y este?"', sess.npc))
	elseif op == "accept" then
		local theirs = sess.theirs
		if not theirs or #sess.mine == 0 then
			return { ok = false }
		end
		for _, id in sess.mine do
			if not Profile.find(d, id) or id == d.equipped then
				return { ok = false, err = "Ese squishy ya no está" }
			end
		end
		local myVal = valueOf(d, sess.mine)
		if myVal < theirs.value * 0.8 then
			npcSay(sess.npc, "Mmm…")
			return npcState(d, sess, string.format('%s: "Mmm, eso no alcanza para mi %s."', sess.npc, theirs.name))
		end
		for _, id in sess.mine do
			InventoryService.take(player, d, id)
		end
		theirs.id = HttpService:GenerateGUID(false)
		theirs.dateFound = os.time()
		if InventoryService.add(player, d, theirs) then
			Net.toast(player, string.format("Nuevo en tu Índice: %s", theirs.name))
		end
		d.stats.trades += 1
		Economy.questEvent(player, "trade", 1)
		Net.sound(player, "reward")
		Net.sound(player, "coins")
		npcSay(sess.npc, NPC_YES[rng:NextInteger(1, #NPC_YES)])
		Net.toast(player, string.format("¡Intercambio listo! Recibiste %s", theirs.name), true)
		npcSessions[player] = nil
		DataService.changed(player)
		return { ok = true, done = true }
	elseif op == "close" then
		npcSessions[player] = nil
		return { ok = true }
	end
	return { ok = false }
end

-- ─────────────────────────── Jugador ↔ jugador ───────────────────────────
type Side = { player: Player, items: { string }, ready: boolean, confirmed: boolean }
type Room = { a: Side, b: Side, phase: string }

local rooms: { [Player]: Room } = {}
local requests: { [Player]: { [Player]: number } } = {} -- requests[destino][origen] = hora

local function sideOf(room: Room, p: Player): (Side, Side)
	if room.a.player == p then
		return room.a, room.b
	end
	return room.b, room.a
end

local function itemsData(p: Player, ids: { string }): { Types.SquishyData }
	local d = DataService.get(p)
	local out = {}
	if d then
		for _, id in ids do
			local s = Profile.find(d, id)
			if s then
				table.insert(out, s)
			end
		end
	end
	return out
end

local function push(room: Room)
	for _, p in { room.a.player, room.b.player } do
		local me, them = sideOf(room, p)
		Remotes.event("TradeEvent"):FireClient(p, {
			t = "state",
			phase = room.phase,
			me = { items = itemsData(p, me.items), ready = me.ready, confirmed = me.confirmed },
			them = {
				name = them.player.DisplayName,
				userId = them.player.UserId,
				items = itemsData(them.player, them.items),
				ready = them.ready,
				confirmed = them.confirmed,
			},
		})
	end
end

local function closeRoom(room: Room, reason: string?)
	for _, p in { room.a.player, room.b.player } do
		if rooms[p] == room then
			rooms[p] = nil
		end
		if p.Parent then
			Remotes.event("TradeEvent"):FireClient(p, { t = "closed", reason = reason })
		end
	end
end

local function resetConfirms(room: Room)
	room.a.ready, room.b.ready = false, false
	room.a.confirmed, room.b.confirmed = false, false
	room.phase = "offer"
end

local function execute(room: Room): (boolean, string?)
	local pa, pb = room.a.player, room.b.player
	local da, db = DataService.get(pa), DataService.get(pb)
	if not da or not db then
		return false, "Un jugador no está disponible"
	end
	-- re-validar dueño y que no esté equipado
	local function valid(d: Types.PlayerData, ids: { string }): boolean
		for _, id in ids do
			if not Profile.find(d, id) or d.equipped == id then
				return false
			end
		end
		return true
	end
	if not valid(da, room.a.items) or not valid(db, room.b.items) then
		return false, "Un squishy de la oferta ya no está"
	end
	if #room.a.items == 0 and #room.b.items == 0 then
		return false, "La oferta está vacía"
	end
	-- capacidad
	if #da.inventory - #room.a.items + #room.b.items > InventoryService.capacity(pa, da) then
		return false, pa.DisplayName .. " no tiene espacio"
	end
	if #db.inventory - #room.b.items + #room.a.items > InventoryService.capacity(pb, db) then
		return false, pb.DisplayName .. " no tiene espacio"
	end
	-- cambio atómico (todo en el mismo frame, sin yields)
	local fromA: { Types.SquishyData } = {}
	local fromB: { Types.SquishyData } = {}
	for _, id in room.a.items do
		local s = InventoryService.take(pa, da, id)
		if s then
			table.insert(fromA, s)
		end
	end
	for _, id in room.b.items do
		local s = InventoryService.take(pb, db, id)
		if s then
			table.insert(fromB, s)
		end
	end
	for _, s in fromA do
		s.fav = false
		InventoryService.add(pb, db, s)
	end
	for _, s in fromB do
		s.fav = false
		InventoryService.add(pa, da, s)
	end
	local function finish(p: Player, d: Types.PlayerData)
		d.stats.trades += 1
		Economy.questEvent(p, "trade", 1)
		DataService.changed(p)
		Net.sound(p, "reward")
		Net.toast(p, "¡Intercambio listo! 🤝", true)
	end
	finish(pa, da)
	finish(pb, db)
	-- guardar ya a los dos para que un crash no deshaga solo la mitad
	task.spawn(DataService.saveNow, pa)
	task.spawn(DataService.saveNow, pb)
	return true, nil
end

local function p2p(player: Player, payload: { [string]: any }): { [string]: any }
	local d = DataService.get(player)
	if not d then
		return { ok = false }
	end
	local op = payload.op
	if op == "request" then
		local target = Players:GetPlayerByUserId(tonumber(payload.userId) or 0)
		if not target or target == player or not DataService.isLoaded(target) then
			return { ok = false, err = "Ese jugador no está disponible" }
		end
		if rooms[player] or rooms[target] then
			return { ok = false, err = "Ya hay un intercambio en curso" }
		end
		requests[target] = requests[target] or {};
		(requests[target] :: any)[player] = os.clock()
		Remotes.event("TradeEvent"):FireClient(target, {
			t = "request",
			from = player.UserId,
			name = player.DisplayName,
		})
		return { ok = true }
	elseif op == "respond" then
		local from = Players:GetPlayerByUserId(tonumber(payload.userId) or 0)
		local reqs = requests[player]
		local t = from and reqs and reqs[from]
		if not from or not reqs or not t then
			return { ok = false, err = "La solicitud ya no existe" }
		end
		reqs[from] = nil
		if os.clock() - t > REQUEST_TTL then
			return { ok = false, err = "La solicitud venció" }
		end
		if payload.accept ~= true then
			Net.toast(from, player.DisplayName .. " no quiso cambiar esta vez")
			return { ok = true }
		end
		if rooms[player] or rooms[from] then
			return { ok = false, err = "Ya hay un intercambio en curso" }
		end
		local room: Room = {
			a = { player = from, items = {}, ready = false, confirmed = false },
			b = { player = player, items = {}, ready = false, confirmed = false },
			phase = "offer",
		}
		rooms[from] = room
		rooms[player] = room
		push(room)
		return { ok = true }
	end

	local room = rooms[player]
	if not room then
		return { ok = false, err = "no_room" }
	end
	local me, them = sideOf(room, player)
	if op == "set" then
		local clean = cleanIds(d, payload.ids, P2P_MAX)
		if not clean then
			return { ok = false }
		end
		me.items = clean
		resetConfirms(room)
		push(room)
	elseif op == "ready" then
		me.ready = payload.v == true
		me.confirmed = false
		them.confirmed = false
		room.phase = if room.a.ready and room.b.ready then "confirm" else "offer"
		push(room)
	elseif op == "confirm" then
		if room.phase ~= "confirm" then
			return { ok = false }
		end
		me.confirmed = true
		if them.confirmed then
			local ok, err = execute(room)
			if ok then
				closeRoom(room, "done")
			else
				resetConfirms(room)
				push(room)
				Net.toast(player, err or "No se pudo")
				Net.toast(them.player, err or "No se pudo")
			end
		else
			push(room)
		end
	elseif op == "cancel" then
		closeRoom(room, player.DisplayName .. " canceló el intercambio")
	else
		return { ok = false }
	end
	return { ok = true }
end

function TradeService.init()
	Net.on("npcTrade", npcTrade)
	Net.on("trade", p2p)
	Players.PlayerRemoving:Connect(function(p)
		npcSessions[p] = nil
		requests[p] = nil
		for _, r in requests do
			r[p] = nil
		end
		local room = rooms[p]
		if room then
			closeRoom(room, p.DisplayName .. " se fue")
		end
	end)
end

return TradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Conecta la lógica al mapa (Fase 1): puntos de interacción (ProximityPrompt), spawn e iluminación.
-- Si todavía no importaste assets/world/mapa_completo.glb a Workspace.Map, construye un mapa
-- provisional con bloques en las MISMAS coordenadas de WorldLayout para poder jugar ya.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)

local L = Config.WorldLayout
local WorldBuilder = {}

local function hex(h: string): Color3
	return Color3.fromHex(h)
end

local function part(props: { [string]: any }, parent: Instance): BasePart
	local p: BasePart
	if props.Shape == "Cylinder" or props.Shape == "Ball" then
		local pp = Instance.new("Part")
		pp.Shape = if props.Shape == "Ball" then Enum.PartType.Ball else Enum.PartType.Cylinder
		p = pp
	else
		p = Instance.new("Part")
	end
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or Color3.new(1, 1, 1)
	p.Size = props.Size or Vector3.one
	p.CFrame = props.CFrame or CFrame.new()
	p.Name = props.Name or "Part"
	p.Transparency = props.Transparency or 0
	p.CanCollide = props.CanCollide ~= false
	p.Parent = parent
	return p
end

local function label(adornee: BasePart, text: string, color: Color3, offset: number, size: number?)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(size or 260, 56)
	bb.StudsOffsetWorldSpace = Vector3.new(0, offset, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 140
	bb.LightInfluence = 0
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = Color3.new(1, 1, 1)
	local st = Instance.new("UIStroke")
	st.Color = color:Lerp(Color3.new(0, 0, 0), 0.35)
	st.Thickness = 3
	st.Parent = t
	t.Parent = bb
	bb.Parent = adornee
end

local function flatCyl(
	pos: Vector3,
	radius: number,
	height: number,
	color: Color3,
	parent: Instance,
	name: string
): BasePart
	return part({
		Shape = "Cylinder",
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)),
		Color = color,
		Name = name,
	}, parent)
end

local function buildPlaceholder(): Model
	local map = Instance.new("Model")
	map.Name = "Map"
	-- suelo
	flatCyl(Vector3.new(0, -0.5, 0), L.worldRadius, 1, hex("#A6DB8E"), map, "Ground")
	flatCyl(Vector3.new(0, 0.05, 0), L.plazaRadius, 0.2, hex("#F3E3CC"), map, "Plaza")
	-- fuente + estatua
	flatCyl(Vector3.new(0, 0.6, 0), L.fountainRadius, 1.2, hex("#FFFFFF"), map, "Fountain")
	flatCyl(Vector3.new(0, 1.05, 0), L.fountainRadius - 0.8, 0.2, hex("#8BC7E8"), map, "Water").Material =
		Enum.Material.Glass
	part({
		Shape = "Ball",
		Size = Vector3.new(7, 6, 7),
		CFrame = CFrame.new(L.statue.pos),
		Color = hex("#FFE38F"),
		Name = "Statue",
	}, map)
	-- caminos en cruz
	for _, dir in { Vector3.new(1, 0, 0), Vector3.new(0, 0, 1) } do
		part({
			Size = if dir.X ~= 0 then Vector3.new(170, 0.2, 7) else Vector3.new(7, 0.2, 170),
			CFrame = CFrame.new(0, 0.02, 0),
			Color = hex("#F4E6CF"),
			Name = "Path",
		}, map)
	end
	-- zonas
	for key, z in L.zones :: any do
		if key ~= "center" then
			local pad = flatCyl(z.center + Vector3.new(0, 0.08, 0), 16, 0.2, z.color, map, "Zone_" .. key)
			label(pad, z.label, z.color, 13, 320)
		end
	end
	-- máquinas
	for _, m in L.machines do
		local def
		for _, md in Config.Machines do
			if md.id == m.id then
				def = md
			end
		end
		local color = hex(def.color)
		local body = part({
			Size = Vector3.new(6, 4.2, 5),
			CFrame = CFrame.new(m.pos + Vector3.new(0, 2.1, 0)),
			Color = color,
			Name = "Machine_" .. m.id,
		}, map)
		part({
			Shape = "Ball",
			Size = Vector3.new(4.2, 4.2, 4.2),
			CFrame = CFrame.new(m.dome),
			Color = Color3.new(1, 1, 1),
			Transparency = 0.7,
			Material = Enum.Material.Glass,
			CanCollide = false,
			Name = "Dome_" .. m.id,
		}, map)
		label(body, def.name, color, 7.2)
	end
	-- tienda
	local counter = part({
		Size = Vector3.new(4, 3, 10),
		CFrame = CFrame.new(L.shopCounter + Vector3.new(0, 1.5, 0)),
		Color = hex("#F4D982"),
		Name = "ShopCounter",
	}, map)
	label(counter, "🛒 Tienda", hex("#F4D982"), 5)
	-- colección: pedestales + tablero del Índice
	for _, pd in L.pedestals do
		local r
		for _, rr in Config.Rarities do
			if rr.id == pd.rarity then
				r = rr
			end
		end
		flatCyl(pd.pos - Vector3.new(0, 2.2, 0), 1.6, 4.4, hex(r.color), map, "Pedestal_" .. pd.rarity)
	end
	local board = part({
		Size = Vector3.new(12, 7, 0.6),
		CFrame = CFrame.new(0, 3.5, -70),
		Color = hex("#B999E8"),
		Name = "IndexBoard",
	}, map)
	label(board, "📖 Índice Squishy", hex("#B999E8"), 5)
	-- plaza de intercambio
	local tb = part({
		Size = Vector3.new(0.6, 6, 10),
		CFrame = CFrame.new(66, 3, 0),
		Color = hex("#8BC7E8"),
		Name = "TradeBoard",
	}, map)
	label(tb, "🤝 Plaza de Intercambio", hex("#8BC7E8"), 5)
	-- Vitrina Viral: pedestales
	for _, v in L.vitrina do
		flatCyl(v.pos - Vector3.new(0, 0.7, 0), 1.3, 1.4, hex("#FFFFFF"), map, "Vitrina_" .. v.species)
	end
	map.Parent = Workspace
	return map
end

local function prompt(pos: Vector3, kind: string, id: string, action: string, object: string, folder: Instance)
	local anchor = Instance.new("Part")
	anchor.Name = kind .. "_" .. id
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Position = pos
	anchor:SetAttribute("Kind", kind)
	anchor:SetAttribute("Id", id)
	local pp = Instance.new("ProximityPrompt")
	pp.ActionText = action
	pp.ObjectText = object
	pp.KeyboardKeyCode = Enum.KeyCode.E
	pp.MaxActivationDistance = Config.Game.INTERACT_DIST + 3
	pp.RequiresLineOfSight = false
	pp.Style = Enum.ProximityPromptStyle.Custom -- se dibuja como el #prompt del original (Interact.luau)
	pp.Parent = anchor
	anchor.Parent = folder
end

function WorldBuilder.build()
	local map = Workspace:FindFirstChild("Map")
	if not map then
		warn(
			"[WorldBuilder] No hay Workspace.Map: construyo el mapa provisional (importa mapa_completo.glb cuando puedas)"
		)
		-- el Baseplate queda al mismo nivel del suelo y parpadea (z-fighting)
		local bp = Workspace:FindFirstChild("Baseplate")
		if bp then
			bp:Destroy()
		end
		map = buildPlaceholder()
	else
		for _, d in map:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
			end
		end
	end

	-- spawn: el Baseplate de Studio trae uno en (0,0,0) = encima de la fuente/estatua → moverlo
	for _, d in Workspace:GetDescendants() do
		if d:IsA("SpawnLocation") then
			-- mirando hacia las Máquinas (+Z), como el original
			d.CFrame = CFrame.new(L.spawn + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, math.pi, 0)
			d.Transparency = 1
			d.CanCollide = false
			local decal = d:FindFirstChildOfClass("Decal")
			if decal then
				decal:Destroy()
			end
		end
	end
	if not Workspace:FindFirstChildWhichIsA("SpawnLocation", true) then
		local sp = Instance.new("SpawnLocation")
		sp.Anchored = true
		sp.Size = Vector3.new(6, 0.4, 6)
		sp.CFrame = CFrame.new(L.spawn + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, math.pi, 0)
		sp.Transparency = 1
		sp.CanCollide = false
		sp.Duration = 0
		sp.Parent = Workspace
	end

	-- puntos de interacción
	local folder = Instance.new("Folder")
	folder.Name = "Interact"
	for _, m in L.machines do
		local def
		for _, md in Config.Machines do
			if md.id == m.id then
				def = md
			end
		end
		prompt(
			m.pos + Vector3.new(0, 3, -3),
			"machine",
			m.id,
			if m.id == "m1" then "Usar la Máquina Squishy" else "Usar " .. def.name,
			"",
			folder
		)
	end
	prompt(L.shopCounter + Vector3.new(2.5, 3, 0), "shop", "shop", "Abrir la Tienda", "", folder)
	prompt(Vector3.new(0, 3, -67), "index", "index", "Abrir el Índice Squishy", "", folder)
	prompt(Vector3.new(64, 3, 0), "tradeBoard", "board", "Cambiar con jugadores", "", folder)
	folder.Parent = Workspace

	-- iluminación pastel (cielo claro, luz cálida)
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(150, 140, 165)
	Lighting.OutdoorAmbient = Color3.fromRGB(190, 180, 200)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		local a = Instance.new("Atmosphere")
		a.Density = 0.28
		a.Haze = 1.2
		a.Color = Color3.fromRGB(255, 225, 240)
		a.Decay = Color3.fromRGB(190, 170, 230)
		a.Parent = Lighting
	end
	if not Workspace.Terrain:FindFirstChildOfClass("Clouds") then
		local c = Instance.new("Clouds")
		c.Cover = 0.55
		c.Density = 0.6
		c.Color = Color3.fromRGB(255, 245, 250)
		c.Parent = Workspace.Terrain
	end
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="42">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">24</float>
      <float name="CameraMinZoomDistance">7</float>
      <float name="CharacterJumpHeight">0</float>
      <bool name="CharacterUseJumpPower">false</bool>
      <float name="CharacterWalkSpeed">13</float>
      <bool name="LoadCharacterAppearance">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="43">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="44">
