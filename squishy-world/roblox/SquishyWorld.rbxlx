		color = "#E7C8FF",
		price = 1500,
		riseMul = 0.9,
		softMul = 1,
		mut = { shiny = 3 },
		bias = { "crystal", "celestial", "purple" },
		desc = "Triple probabilidad de Brillante.",
	},
	{
		id = "cloud",
		name = "Nube",
		color = "#FFFFFF",
		price = 2500,
		riseMul = 1.5,
		softMul = 1.35,
		bias = { "cloud", "white", "celestial", "cotton_candy" },
		desc = "Súper blandita. Variantes de nube y cielo.",
	},
	{
		id = "honey",
		name = "Miel",
		color = "#F2B33D",
		price = 3000,
		riseMul = 2.2,
		softMul = 1.1,
		bias = { "honey", "yellow", "golden", "chocolate" },
		desc = "El slow rise más lento. Miel y Oro.",
	},
	{
