          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Damp</string>
            <string name="Source"><![CDATA[--!strict
-- Suavizado exponencial independiente del FPS, igual que damp() del prototipo.
local Damp = {}
function Damp.number(a: number, b: number, k: number, dt: number): number
	return a + (b - a) * (1 - math.exp(-k * dt))
end
function Damp.vector(a: Vector3, b: Vector3, k: number, dt: number): Vector3
	return a:Lerp(b, 1 - math.exp(-k * dt))
end
function Damp.smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end
return Damp
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Números con separador de miles al estilo es-CO (1.515), como fmt() del prototipo.
local Format = {}
function Format.int(n: number): string
	local s = tostring(math.round(n))
	local neg = string.sub(s, 1, 1) == "-"
	if neg then
		s = string.sub(s, 2)
	end
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1.")))
	if string.sub(out, 1, 1) == "." then
		out = string.sub(out, 2)
	end
	return (neg and "-" or "") .. out
end
return Format
]]></string>
          </Properties>
