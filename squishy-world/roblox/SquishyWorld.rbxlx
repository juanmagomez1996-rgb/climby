	-- pedestales de la Colección (tus mejores squishies por rareza)
	pedestals = {
		{ rarity = "common", pos = Vector3.new(-11.59, 4.45, -60.08) },
		{ rarity = "uncommon", pos = Vector3.new(-7.97, 4.45, -63.11) },
		{ rarity = "rare", pos = Vector3.new(-2.84, 4.45, -64.78) },
